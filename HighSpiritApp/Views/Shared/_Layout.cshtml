<!DOCTYPE html>
<html lang="en">

<head>
    <script>
            // Apply theme BEFORE any CSS/HTML renders to prevent flash
            (function () {
                var t = localStorage.getItem('theme');
                if (t) document.documentElement.setAttribute('data-theme', t);
            })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>High Spirit</title>
    <link rel="icon" type="image/png" href="/images/highspirit.jpg" />

    <!-- Preconnect to CDN hosts to reduce DNS/TLS latency on mobile -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

    <!-- Critical CSS: Bootstrap (local only — removed duplicate CDN copy) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HighSpiritApp.styles.css" asp-append-version="true" />

    <!-- FontAwesome: load synchronously to prevent icon-flash/reflow -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Non-critical CSS: load asynchronously (no render-block) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" media="print"
          onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" media="print"
          onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" media="print"
          onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/nepali-datepicker.css" asp-append-version="true" media="print"
          onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" />
        <link rel="stylesheet" href="~/css/nepali-datepicker.css" asp-append-version="true" />
    </noscript>
    <link rel="stylesheet" href="~/css/layout-inline.css" asp-append-version="true" />
</head>

<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var userName = User.Identity?.Name ?? "Admin";
        var userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "A";
    }

    <!-- Modern Header Bar -->
    <div class="header-bar">
        <div class="header-left">
            <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleSidebar()" title="Toggle Sidebar">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a href="/" style="display: flex; align-items: center; text-decoration: none; color: inherit; gap: 10px;">
                <img src="/images/highspirit.jpg" class="brand-logo" alt="High Spirit" />
                <div class="brand-text d-none d-md-block">High <span>Spirit</span></div>
            </a>
        </div>

        <div class="header-right">
            <!-- Date Mode Toggle (EN/NP) -->
            <button class="date-toggle-btn" id="dateToggleBtn" onclick="NepaliDatePickerManager.toggle()"
                    title="Switch to Nepali Date">
                <i class="date-toggle-icon fa-solid fa-calendar-days"></i>
                <span class="date-toggle-divider"></span>
                <span class="date-toggle-label">EN</span>
            </button>

            <!-- Dark Mode Toggle -->
            <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle Dark Mode">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
            </button>

            <!-- Session Timer -->
            <div class="session-timer" id="sessionTimerDisplay" title="Session time remaining">
                <i class="fa-solid fa-clock"></i>
                <span id="sessionTimerText">15:00</span>
            </div>

            <!-- Profile Dropdown -->
            <div class="profile-dropdown">
                <button class="profile-btn" onclick="toggleProfileMenu()">
                    <div class="profile-icon">@userInitial</div>
                    <span class="profile-name">@userName</span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 11px; opacity: 0.7;"></i>
                </button>
                <div class="profile-menu" id="profileMenu">
                    <div class="profile-menu-header">
                        <div class="user-avatar">@userInitial</div>
                        <div class="user-name">@userName</div>
                        <div class="user-role">Owner / Admin</div>
                    </div>
                    <a href="/Account/Logout" class="profile-menu-item logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sign Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Overlay for mobile -->
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- Modern Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-nav">
            <p class="nav-section-title">Main Menu</p>

            <div class="nav-item">
                <a href="/" class="nav-link dashboard-link @(controller == "Home" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </div>

            <p class="nav-section-title">Gym Members</p>

            <div class="nav-item">
                <a href="#" class="nav-link gym-link" data-bs-toggle="collapse" data-bs-target="#gymPackagesMenu">
                    <i class="fa-solid fa-dumbbell"></i>
                    <span class="nav-text">Gym Packages</span>
                    <i class="fa-solid fa-chevron-down ms-auto nav-text" style="font-size: 10px; opacity: 0.6;"></i>
                </a>
            </div>
            <div class="collapse submenu-container @(controller == "Customers" ? "show" : "")" id="gymPackagesMenu">
                <a href="/Customers"
                   class="nav-link submenu @(controller == "Customers" && string.IsNullOrEmpty(ViewBag.PlanName as string) && (ViewBag.Filter as string) != "active" && (ViewBag.Filter as string) != "new" && (ViewBag.Filter as string) != "thismonth" && (ViewBag.Filter as string) != "updated" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-users"></i>
                    <span class="nav-text">All Members</span>
                </a>
                <a href="/Customers?filter=active"
                   class="nav-link submenu @(controller == "Customers" && (ViewBag.Filter as string) == "active" && string.IsNullOrEmpty(ViewBag.PlanName as string) ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-user-check"></i>
                    <span class="nav-text">Active Members</span>
                </a>
                <a href="/Customers?filter=new"
                   class="nav-link submenu @(controller == "Customers" && (ViewBag.Filter as string) == "new" && string.IsNullOrEmpty(ViewBag.PlanName as string) ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-user-plus"></i>
                    <span class="nav-text">New Arrivals</span>
                </a>
                <a href="/Customers?filter=thismonth"
                   class="nav-link submenu @(controller == "Customers" && (ViewBag.Filter as string) == "thismonth" && string.IsNullOrEmpty(ViewBag.PlanName as string) ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-calendar-day"></i>
                    <span class="nav-text">Joined This Month</span>
                </a>
                <a href="/Customers?filter=updated"
                   class="nav-link submenu @(controller == "Customers" && (ViewBag.Filter as string) == "updated" && string.IsNullOrEmpty(ViewBag.PlanName as string) ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-user-pen"></i>
                    <span class="nav-text">Recently Updated</span>
                </a>
                <a href="/Customers?planName=Gym"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Gym" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-dumbbell"></i>
                    <span class="nav-text">Gym Package</span>
                </a>
                <a href="/Customers?planName=Cardio"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Cardio" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-heart-pulse"></i>
                    <span class="nav-text">Cardio Package</span>
                </a>
                <a href="/Customers?planName=Premium"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Premium" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-crown"></i>
                    <span class="nav-text">Premium Package</span>
                </a>
                <a href="/Customers?planName=Custom2"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Custom2" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-layer-group"></i>
                    <span class="nav-text">Custom-2 Package</span>
                </a>
                <a href="/Customers?planName=Custom3"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Custom3" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-cubes"></i>
                    <span class="nav-text">Custom-3 Package</span>
                </a>
                <a href="/Customers?planName=Zumba"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Zumba" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-music"></i>
                    <span class="nav-text">Zumba Package</span>
                </a>
                <a href="/Customers?planName=Sauna"
                   class="nav-link submenu @(ViewBag.PlanName as string == "Sauna" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-hot-tub-person"></i>
                    <span class="nav-text">Sauna Package</span>
                </a>
            </div>
            <p class="nav-section-title">Boxing Members</p>

            <div class="nav-item">
                <a href="#" class="nav-link boxing-link" data-bs-toggle="collapse" data-bs-target="#boxingMenu">
                    <i class="fa-solid fa-hand-fist"></i>
                    <span class="nav-text">Boxing Packages</span>
                    <i class="fa-solid fa-chevron-down ms-auto nav-text" style="font-size: 10px; opacity: 0.6;"></i>
                </a>
            </div>
            <div class="collapse submenu-container @(controller == "Boxing" ? "show" : "")" id="boxingMenu">
                <a href="/Boxing?category=All"
                   class="nav-link submenu @(controller == "Boxing" && ViewBag.Category as string == "All" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-users"></i>
                    <span class="nav-text">All Members</span>
                </a>
                <a href="/Boxing?category=Children"
                   class="nav-link submenu @(controller == "Boxing" && ViewBag.Category as string == "Children" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-child"></i>
                    <span class="nav-text">Children Boxing</span>
                </a>
                <a href="/Boxing?category=Adult"
                   class="nav-link submenu @(controller == "Boxing" && ViewBag.Category as string == "Adult" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-person"></i>
                    <span class="nav-text">Adult Boxing</span>
                </a>
                <a href="/Boxing?category=All&filter=updated"
                   class="nav-link submenu @(controller == "Boxing" && (ViewBag.Filter as string) == "updated" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-user-pen"></i>
                    <span class="nav-text">Recently Updated</span>
                </a>
            </div>

            <p class="nav-section-title">Lockers</p>

            <div class="nav-item">
                <a href="#" class="nav-link locker-link" data-bs-toggle="collapse" data-bs-target="#lockerMenu">
                    <i class="fa-solid fa-lock"></i>
                    <span class="nav-text">Locker</span>
                    <i class="fa-solid fa-chevron-down ms-auto nav-text" style="font-size: 10px; opacity: 0.6;"></i>
                </a>
            </div>
            <div class="collapse submenu-container @(controller == "Locker" ? "show" : "")" id="lockerMenu">
                <a href="/Locker?gender=Gents"
                   class="nav-link submenu @(controller == "Locker" && ViewBag.Gender as string == "Gents" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-mars"></i>
                    <span class="nav-text">Male Locker</span>
                </a>
                <a href="/Locker?gender=Ladies"
                   class="nav-link submenu @(controller == "Locker" && ViewBag.Gender as string == "Ladies" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-venus"></i>
                    <span class="nav-text">Female Locker</span>
                </a>
                <a href="/Locker?filter=updated"
                   class="nav-link submenu @(controller == "Locker" && (ViewBag.Filter as string) == "updated" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-user-pen"></i>
                    <span class="nav-text">Recently Updated</span>
                </a>
            </div>



            <p class="nav-section-title">Analytics</p>

            <div class="nav-item">
                <a href="/Report" class="nav-link report-link @(controller == "Report" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-chart-line"></i>
                    <span class="nav-text">Revenue Report</span>
                </a>
            </div>

            <p class="nav-section-title">System</p>

            <div class="nav-item">
                <a href="/Settings" class="nav-link settings-link @(controller == "Settings" ? "active" : "")"
                   onclick="closeSidebarOnMobile()">
                    <i class="fa-solid fa-gear"></i>
                    <span class="nav-text">Settings</span>
                </a>
            </div>
        </div>
    </div>

    <div class="content" id="content">
        <!-- Top utility bar -->
        <div class="d-flex justify-content-end align-items-center gap-3 top-bar">
            @if (controller == "Customers" || controller == "Home" || controller == "Memberships")
            {
                var planNameForNotification = controller == "Customers" ? ViewBag.PlanName as string : null;
                @await Component.InvokeAsync("ExpiredNotification", new { planName = planNameForNotification })
            }
            @if (controller == "Locker" || controller == "Home")
            {
                var genderForNotification = controller == "Locker" ? ViewBag.Gender as string : null;
                @await Component.InvokeAsync("LockerExpiredNotification", new { gender = genderForNotification })
            }
            @if (controller == "Boxing" || controller == "Home")
            {
                var boxingCategory = controller == "Boxing" ? ViewBag.Category as string : null;
                if (controller == "Home" || boxingCategory == "All")
                {
                    @await Component.InvokeAsync("BoxingDueNotification")
                }
                else if (boxingCategory == "Children")
                {
                    @await Component.InvokeAsync("BoxingDueNotification", new { category = "Children" })
                }
                else if (boxingCategory == "Adult")
                {
                    @await Component.InvokeAsync("BoxingDueNotification", new { category = "Adult" })
                }
            }
            <button class="btn btn-sm btn-outline-secondary rounded-circle" id="fullscreenToggle"
                    onclick="toggleFullScreen()" title="Toggle Fullscreen"
                    style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid #e2e8f0;background:transparent;">
                <i class="fa-solid fa-expand" id="navFullscreenIcon"></i>
            </button>
        </div>

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/nepali-datepicker.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Date Picker Manager (handles EN/NP mode)
            NepaliDatePickerManager.init();

            // Apply session timer visibility from settings
            if (localStorage.getItem('sessionTimerHidden') === 'true') {
                var stDisplay = document.getElementById('sessionTimerDisplay');
                if (stDisplay) stDisplay.style.display = 'none';
            }

            // Apply header quick actions visibility from settings
            if (localStorage.getItem('headerActionsHidden') === 'true') {
                var dtBtn = document.getElementById('dateToggleBtn');
                var tmBtn = document.getElementById('themeToggle');
                if (dtBtn) dtBtn.style.display = 'none';
                if (tmBtn) tmBtn.style.display = 'none';
            }

            // Apply animations setting
            if (localStorage.getItem('animationsDisabled') === 'true') {
                document.documentElement.classList.add('no-animations');
            }

            // Apply toast position from settings
            var savedToastPos = localStorage.getItem('toastPosition');
            if (savedToastPos && typeof toastr !== 'undefined') {
                toastr.options.positionClass = savedToastPos;
            }

            // Initialize session timeout
            initSessionTimeout();
        });

        // =====================================================
        // SESSION TIMEOUT MANAGEMENT WITH VISIBLE TIMER
        // =====================================================
        let sessionTimer = null;
        let warningTimer = null;
        let countdownInterval = null;
        let timerDisplayInterval = null;
        let idleTimer = null;
        let sessionStartTime = null;
        let isIdle = false;

        // Configuration: 15 minutes total, warning at 13 minutes (120 seconds before logout)
        const SESSION_TIMEOUT_MS = 15 * 60 * 1000;  // 15 minutes
        const WARNING_TIME_MS = 13 * 60 * 1000;     // Warning at 13 minutes
        const COUNTDOWN_SECONDS = 120;               // 2 minutes countdown
        const IDLE_THRESHOLD_MS = 5 * 60 * 1000;    // Show idle notification after 5 minutes of no activity

        function initSessionTimeout() {
            console.log('Session timeout initialized: ' + (SESSION_TIMEOUT_MS / 1000) + ' seconds');
            resetSessionTimer();

            // Reset timer on user activity (debounced)
            const activityHandler = debounce(function () {
                if (isIdle) {
                    hideIdleToast();
                    isIdle = false;
                }
                resetSessionTimer();
            }, 1000);

            // Only track meaningful user interactions
            ['click', 'keypress', 'touchstart'].forEach(function (event) {
                document.addEventListener(event, activityHandler, { passive: true });
            });
        }

        function resetSessionTimer() {
            // Clear existing timers
            if (sessionTimer) clearTimeout(sessionTimer);
            if (warningTimer) clearTimeout(warningTimer);
            if (countdownInterval) clearInterval(countdownInterval);
            if (timerDisplayInterval) clearInterval(timerDisplayInterval);
            if (idleTimer) clearTimeout(idleTimer);

            // Reset session start time
            sessionStartTime = Date.now();

            // Hide warning modal if shown
            const warningModal = document.getElementById('sessionWarningModal');
            if (warningModal) {
                const modalInstance = bootstrap.Modal.getInstance(warningModal);
                if (modalInstance) {
                    modalInstance.hide();
                }
            }

            // Reset timer display style
            const timerDisplay = document.getElementById('sessionTimerDisplay');
            if (timerDisplay) {
                timerDisplay.classList.remove('warning', 'danger');
            }

            // Start the visible timer display
            updateTimerDisplay();
            timerDisplayInterval = setInterval(updateTimerDisplay, 1000);

            // Set idle notification timer
            idleTimer = setTimeout(function () {
                showIdleToast();
                isIdle = true;
            }, IDLE_THRESHOLD_MS);

            // Set warning timer
            warningTimer = setTimeout(function () {
                showSessionWarning();
            }, WARNING_TIME_MS);

            // Set logout timer
            sessionTimer = setTimeout(function () {
                window.location.href = '/Account/Logout?expired=true';
            }, SESSION_TIMEOUT_MS);
        }

        function updateTimerDisplay() {
            const elapsed = Date.now() - sessionStartTime;
            const remaining = Math.max(0, SESSION_TIMEOUT_MS - elapsed);
            const minutes = Math.floor(remaining / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);

            const timerText = document.getElementById('sessionTimerText');
            const timerDisplay = document.getElementById('sessionTimerDisplay');

            if (timerText) {
                timerText.textContent = minutes + ':' + seconds.toString().padStart(2, '0');
            }

            if (timerDisplay) {
                if (remaining <= 60000) {
                    timerDisplay.classList.remove('warning');
                    timerDisplay.classList.add('danger');
                } else if (remaining <= 120000) {
                    timerDisplay.classList.remove('danger');
                    timerDisplay.classList.add('warning');
                } else {
                    timerDisplay.classList.remove('warning', 'danger');
                }
            }

            if (remaining <= 0) {
                clearInterval(timerDisplayInterval);
            }
        }

        function showIdleToast() {
            const toast = document.getElementById('idleToast');
            if (toast) {
                toast.classList.add('show');
            }
        }

        function hideIdleToast() {
            const toast = document.getElementById('idleToast');
            if (toast) {
                toast.classList.remove('show');
            }
        }

        function showSessionWarning() {
            const warningModal = document.getElementById('sessionWarningModal');
            if (!warningModal) {
                console.error('Warning modal not found');
                return;
            }

            // Hide idle toast if shown
            hideIdleToast();

            // Clear any existing countdown
            if (countdownInterval) clearInterval(countdownInterval);

            // Show the modal
            const modal = new bootstrap.Modal(warningModal, {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();

            // Start countdown
            let countdown = COUNTDOWN_SECONDS;
            const countdownEl = document.getElementById('sessionCountdown');

            // Update display immediately
            if (countdownEl) {
                const mins = Math.floor(countdown / 60);
                const secs = countdown % 60;
                countdownEl.textContent = mins + ':' + secs.toString().padStart(2, '0');
            }

            countdownInterval = setInterval(function () {
                countdown--;
                if (countdownEl) {
                    const mins = Math.floor(countdown / 60);
                    const secs = countdown % 60;
                    countdownEl.textContent = mins + ':' + secs.toString().padStart(2, '0');
                }
                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                }
            }, 1000);
        }

        function extendSession() {
            // Clear countdown
            if (countdownInterval) clearInterval(countdownInterval);

            // Make a request to extend session
            fetch('/Account/ExtendSession', {
                method: 'POST',
                credentials: 'same-origin'
            })
                .then(function (response) {
                    if (response.ok) {
                        resetSessionTimer();
                        toastr.success('Session extended!');
                    } else {
                        window.location.href = '/Account/Login';
                    }
                })
                .catch(function (error) {
                    console.error('Error extending session:', error);
                    resetSessionTimer();
                });
        }

        // Debounce function to limit activity detection calls
        function debounce(func, wait) {
            let timeout;
            return function () {
                const context = this;
                const args = arguments;
                clearTimeout(timeout);
                timeout = setTimeout(function () {
                    func.apply(context, args);
                }, wait);
            };
        }
    </script>

    @if (TempData["success"] != null)
    {
        <script>toastr.success("@TempData["success"]");</script>
    }
    @if (TempData["error"] != null)
    {
        <script>toastr.error("@TempData["error"]");</script>
    }

    <!-- Idle Notification Toast -->
    <div class="idle-toast" id="idleToast">
        <i class="fa-solid fa-moon"></i>
        <span>You've been idle. Session will expire soon.</span>
        <button class="close-toast" onclick="hideIdleToast()">
            <i class="fa-solid fa-times"></i>
        </button>
    </div>

    <!-- Session Warning Modal -->
    <div class="modal fade" id="sessionWarningModal" tabindex="-1" aria-labelledby="sessionWarningModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden;">
                <div class="modal-body text-center" style="padding: 40px;">
                    <div
                        style="width: 80px; height: 80px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
                        <i class="fa-solid fa-clock" style="font-size: 36px; color: #d97706;"></i>
                    </div>
                    <h4 id="sessionWarningModalLabel" style="font-weight: 700; color: #1e293b; margin-bottom: 12px;">
                        Session Expiring Soon</h4>
                        <p style="color: #64748b; margin-bottom: 8px;">Your session will expire in</p>
                        <div id="sessionCountdown"
                             style="font-size: 48px; font-weight: 800; color: #dc2626; margin-bottom: 24px;">1:00</div>
                        <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Click below to stay logged in</p>
                        <div class="d-flex gap-3 justify-content-center">
                            <a href="/Account/Logout" class="btn btn-outline-secondary"
                               style="border-radius: 12px; padding: 12px 24px; font-weight: 600;">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                            </a>
                            <button type="button" class="btn btn-primary" onclick="extendSession()" data-bs-dismiss="modal"
                                    style="border-radius: 12px; padding: 12px 24px; font-weight: 600; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border: none;">
                                <i class="fa-solid fa-rotate me-2"></i>Stay Logged In
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function toggleProfileMenu() {
                const menu = document.getElementById('profileMenu');
                menu.classList.toggle('show');
            }

            document.addEventListener('click', function (event) {
                const profileDropdown = document.querySelector('.profile-dropdown');
                const menu = document.getElementById('profileMenu');
                if (profileDropdown && !profileDropdown.contains(event.target)) {
                    menu.classList.remove('show');
                }
            });

            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const content = document.getElementById('content');
                const overlay = document.querySelector('.sidebar-overlay');
                const hamburger = document.getElementById('hamburgerBtn');

                if (window.innerWidth >= 992) {
                    sidebar.classList.toggle('collapsed');
                    content.classList.toggle('expanded');
                    hamburger.classList.toggle('active');
                    localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                } else {
                    sidebar.classList.toggle('show');
                    overlay.classList.toggle('show');
                    hamburger.classList.toggle('active');
                }
            }

            function closeSidebarOnMobile() {
                if (window.innerWidth < 992) {
                    const sidebar = document.getElementById('sidebar');
                    const overlay = document.querySelector('.sidebar-overlay');
                    const hamburger = document.getElementById('hamburgerBtn');
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                    hamburger.classList.remove('active');
                }
            }

            // FULLSCREEN TOGGLE
            function toggleFullScreen() {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen();
                } else {
                    document.exitFullscreen();
                }
            }

            function updateFullscreenIcons(isFs) {
                var icons = document.querySelectorAll('#dashboardFullscreenIcon, #navFullscreenIcon');
                icons.forEach(function (icon) {
                    if (isFs) { icon.classList.remove('fa-expand'); icon.classList.add('fa-compress'); }
                    else { icon.classList.remove('fa-compress'); icon.classList.add('fa-expand'); }
                });
                var cb = document.getElementById('settingFullscreen');
                if (cb) cb.checked = isFs;
            }

            document.addEventListener('fullscreenchange', function () {
                updateFullscreenIcons(!!document.fullscreenElement);
            });

            // DARK MODE TOGGLE
            function toggleTheme() {
                const html = document.documentElement;
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
            }

            // Apply saved theme immediately (before DOMContentLoaded to prevent flash)
            (function () {
                const savedTheme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
            })();

            // Initialize on page load
            document.addEventListener('DOMContentLoaded', function () {
                const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                const hamburger = document.getElementById('hamburgerBtn');

                if (isCollapsed && window.innerWidth >= 992) {
                    document.getElementById('sidebar').classList.add('collapsed');
                    document.getElementById('content').classList.add('expanded');
                    hamburger.classList.add('active');
                }
            });

            // Handle window resize
            window.addEventListener('resize', function () {
                const sidebar = document.getElementById('sidebar');
                const content = document.getElementById('content');
                const overlay = document.querySelector('.sidebar-overlay');
                const hamburger = document.getElementById('hamburgerBtn');

                if (window.innerWidth >= 992) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                    if (localStorage.getItem('sidebarCollapsed') === 'true') {
                        sidebar.classList.add('collapsed');
                        content.classList.add('expanded');
                        hamburger.classList.add('active');
                    } else {
                        sidebar.classList.remove('collapsed');
                        content.classList.remove('expanded');
                        hamburger.classList.remove('active');
                    }
                } else {
                    sidebar.classList.remove('collapsed');
                    content.classList.remove('expanded');
                    if (!sidebar.classList.contains('show')) {
                        hamburger.classList.remove('active');
                    }
                }
            });
        </script>
    </body>

</html>
