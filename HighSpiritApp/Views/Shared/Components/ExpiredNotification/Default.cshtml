@model List<CustomerMembership>

<div class="dropdown">
    <a href="#"
       class="nav-link position-relative dropdown-toggle"
       data-bs-toggle="dropdown"
       title="Gym Expired Members">

        <!-- Gym Icon: Dumbbell with orange/warning color -->
        <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded bg-warning bg-opacity-10">
            <i class="fa-solid fa-dumbbell text-warning"></i>
            @if (Model.Count > 0)
            {
                <span class="badge rounded-pill bg-danger">
                    @Model.Count
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-success">0</span>
            }
        </span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end shadow notification-dropdown">

        <li class="dropdown-header fw-bold text-warning">
            <i class="fa-solid fa-dumbbell me-2"></i>Expired Gym Memberships
        </li>

        @if (Model.Count == 0)
        {
            <li class="px-3 text-muted">
                No expired members 🎉
            </li>
        }
        else
        {
            foreach (var m in Model)
            {
                <li class="dropdown-item-text border-bottom">
                    <div class="fw-semibold">@m.Customer.FullName</div>
                    <small class="text-danger">
                        <i class="fa-solid fa-calendar-xmark me-1"></i>
                        Expired: @m.ExpireDate.ToString("dd MMM yyyy")
                        <span class="text-muted">(Due @m.DueDaysComputed days)</span>
                    </small>
                    <div>
                        <a href="/Customers/Details/@m.CustomerID"
                           class="text-primary small">
                            <i class="fa-solid fa-eye"></i> View
                        </a>
                        <a href="/Memberships/Renew/@m.CustomerID"
                           class="text-success small ms-2">
                            <i class="fa-solid fa-rotate"></i> Renew
                        </a>
                    </div>
                </li>
            }
        }
    </ul>
</div>
