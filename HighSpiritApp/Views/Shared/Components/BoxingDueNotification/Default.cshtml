@model List<HighSpiritApp.Models.Boxing.BoxingMember>
@{
    var category = ViewBag.Category as string;
    var isAll = string.IsNullOrEmpty(category);

    var config = category switch
    {
        "Children" => (icon: "fa-child", color: "#f59e0b", bg: "rgba(245, 158, 11, 0.1)", label: "Children Boxing"),
        "Adult" => (icon: "fa-person", color: "#ef4444", bg: "rgba(239, 68, 68, 0.1)", label: "Adult Boxing"),
        _ => (icon: "fa-hand-fist", color: "#dc2626", bg: "rgba(220, 38, 38, 0.1)", label: "Boxing")
    };
}

<div class="nav-item dropdown list-unstyled">

    <a href="#" class="nav-link position-relative dropdown-toggle"    data-bs-toggle="dropdown"
           title="@config.label Due Members">

        <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded" style="background: @config.bg;">
            <i class="fa-solid @config.icon" style="color: @config.color;"></i>
            @if (ViewBag.DueCount > 0)
            {
                <span class="badge rounded-pill bg-danger">
                    @ViewBag.DueCount
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-success">0</span>
            }
        </span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end shadow notification-dropdown">
        <li class="dropdown-header fw-bold" style="color: @config.color;">
            <i class="fa-solid @config.icon me-2"></i>@config.label Due
        </li>

        @if (!Model.Any())
        {
            <li class="px-3 text-muted">
                No dues 🎉
            </li>
        }
        else
        {
            foreach (var b in Model)
            {
                <li class="dropdown-item-text border-bottom">
                    <div class="fw-semibold">@b.Name</div>
                    <small class="text-danger">
                        <i class="fa-solid fa-money-bill-wave me-1"></i>
                        Due: Rs @b.DueAmount
                    </small>
                    <div>
                        <a href="/Boxing/Details/@b.BoxingMemberID"                     class="text-primary small">
                            <i class="fa-solid fa-eye"></i> View
                        </a>
                    </div>
                </li>
            }
        }
    </ul>
</div>