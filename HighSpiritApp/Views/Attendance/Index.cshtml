@model List<HighSpiritApp.Models.Attendance>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Attendance";

    var search = ViewBag.Search as string;
    var date = ViewBag.Date as string;
    int totalToday = ViewBag.TotalToday;
    int currentlyIn = ViewBag.CurrentlyIn;
    int punchedOut = ViewBag.PunchedOut;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-primary);">
            <i class="fa-solid fa-clipboard-user me-2" style="color: var(--accent-color);"></i>Attendance
        </h4>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Track daily gym check-ins and check-outs</p>
    </div>
    <a href="/Attendance/Display" target="_blank" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-tv me-1"></i> Open iPad Display
    </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px; height:48px; background: linear-gradient(135deg, #3b82f6, #60a5fa);">
                    <i class="fa-solid fa-users text-white"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: var(--text-primary);">@totalToday</div>
                    <div class="text-muted" style="font-size:0.85rem;">Total Today</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px; height:48px; background: linear-gradient(135deg, #10b981, #34d399);">
                    <i class="fa-solid fa-person-running text-white"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: var(--text-primary);">@currentlyIn</div>
                    <div class="text-muted" style="font-size:0.85rem;">Currently In</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px; height:48px; background: linear-gradient(135deg, #f59e0b, #fbbf24);">
                    <i class="fa-solid fa-right-from-bracket text-white"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: var(--text-primary);">@punchedOut</div>
                    <div class="text-muted" style="font-size:0.85rem;">Punched Out</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="/Attendance" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted" style="font-size:0.8rem;">Search by Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Enter name..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted" style="font-size:0.8rem;">Date</label>
                <input type="date" name="date" class="form-control" value="@date" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
                <a href="/Attendance" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-clipboard-user fa-3x text-muted mb-3" style="opacity:0.3;"></i>
                <p class="text-muted">No attendance records found for this date.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr style="background: var(--table-stripe);">
                            <th class="ps-4" style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">#</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Name</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Punch In</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Punch Out</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Duration</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 0; }
                        @foreach (var item in Model)
                        {
                            idx++;
                            var duration = item.CheckOutTime.HasValue
                                ? (item.CheckOutTime.Value - item.CheckInTime).ToString(@"h\h\ m\m")
                                : "—";
                            var isIn = !item.CheckOutTime.HasValue;
                            <tr>
                                <td class="ps-4 text-muted">@idx</td>
                                <td>
                                    <span class="fw-semibold" style="color: var(--text-primary);">@item.CustomerName</span>
                                </td>
                                <td>
                                    <span style="color: var(--text-secondary);">
                                        <i class="fa-solid fa-right-to-bracket me-1" style="color:#10b981; font-size:0.8rem;"></i>
                                        @item.CheckInTime.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span style="color: var(--text-secondary);">
                                            <i class="fa-solid fa-right-from-bracket me-1" style="color:#f59e0b; font-size:0.8rem;"></i>
                                            @item.CheckOutTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td style="color: var(--text-secondary);">@duration</td>
                                <td>
                                    @if (isIn)
                                    {
                                        <span class="badge rounded-pill" style="background:#ecfdf5; color:#059669; font-weight:500;">
                                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> In
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background:#fef3c7; color:#92400e; font-weight:500;">
                                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> Out
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        // Live update: when someone checks in/out, refresh the page stats
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/attendance")
            .withAutomaticReconnect()
            .build();

        connection.on("PunchIn", () => location.reload());
        connection.on("PunchOut", () => location.reload());

        connection.start().then(() => {
            connection.invoke("JoinDisplayGroup");
        }).catch(err => console.error("SignalR error:", err));
    </script>
}
