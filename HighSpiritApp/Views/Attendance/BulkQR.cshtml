@{
    ViewData["Title"] = "Bulk QR / Email";
    var activeCustomers = ViewBag.ActiveCustomers as List<HighSpiritApp.Models.Customer> ?? new List<HighSpiritApp.Models.Customer>();
    var allCustomers = ViewBag.AllCustomers as List<HighSpiritApp.Models.Customer> ?? new List<HighSpiritApp.Models.Customer>();

    var activeWithEmail = activeCustomers.Where(c => !string.IsNullOrWhiteSpace(c.Email)).ToList();
    var activeAlreadySent = activeCustomers.Where(c => c.QREmailSentAt.HasValue).ToList();
    var allWithEmail = allCustomers.Where(c => !string.IsNullOrWhiteSpace(c.Email)).ToList();
    var allAlreadySent = allCustomers.Where(c => c.QREmailSentAt.HasValue).ToList();

    var activeEmailOnly = activeCustomers.Where(c => !string.IsNullOrWhiteSpace(c.Email)).OrderBy(c => c.FullName).ToList();
    var activeEmailSent = activeEmailOnly.Where(c => c.QREmailSentAt.HasValue).ToList();
    var activeEmailPending = activeEmailOnly.Where(c => !c.QREmailSentAt.HasValue).ToList();
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4" style="min-height: 60px;">
    <div>
        <h4 class="mb-1" style="font-weight: 700; color: #1e293b;">
            <i class="fa-solid fa-envelopes-bulk me-2" style="color: #8b5cf6;"></i>Bulk QR / Email
        </h4>
        <p class="text-muted mb-0" style="font-size: 13px;">Generate and send personalized QR codes to your members</p>
    </div>
    <a href="/Attendance" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Records
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6 col-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width:44px; background: rgba(16, 185, 129, 0.1);">
                    <i class="fa-solid fa-user-check" style="color: #10b981; font-size: 18px;"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Active Members</div>
                    <div class="fw-bold" style="font-size: 22px; color: #10b981;">@activeCustomers.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width:44px; background: rgba(59, 130, 246, 0.1);">
                    <i class="fa-solid fa-at" style="color: #3b82f6; font-size: 18px;"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Active + Email</div>
                    <div class="fw-bold" style="font-size: 22px; color: #3b82f6;">@activeEmailOnly.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width:44px; background: rgba(139, 92, 246, 0.1);">
                    <i class="fa-solid fa-paper-plane" style="color: #8b5cf6; font-size: 18px;"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Already Sent</div>
                    <div class="fw-bold" style="font-size: 22px; color: #8b5cf6;">@activeEmailSent.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width:44px; background: rgba(6, 182, 212, 0.1);">
                    <i class="fa-solid fa-check-double" style="color: #06b6d4; font-size: 18px;"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Selected</div>
                    <div class="fw-bold" style="font-size: 22px; color: #06b6d4;" id="selectedCount">0</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-0" id="memberTabs" role="tablist" style="border-bottom: 2px solid #e2e8f0;">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="activeEmail-tab" data-bs-toggle="tab" data-bs-target="#activeEmailPanel" type="button" role="tab" style="font-weight: 600; font-size: 14px; border-radius: 10px 10px 0 0;">
            <i class="fa-solid fa-envelope-circle-check me-1" style="color: #3b82f6;"></i> Active + Email
            <span class="badge bg-primary bg-opacity-10 text-primary ms-1" style="font-size: 11px;">@activeEmailOnly.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="active-tab" data-bs-toggle="tab" data-bs-target="#activePanel" type="button" role="tab" style="font-weight: 600; font-size: 14px; border-radius: 10px 10px 0 0;">
            <i class="fa-solid fa-bolt me-1" style="color: #10b981;"></i> Active Members
            <span class="badge bg-success bg-opacity-10 text-success ms-1" style="font-size: 11px;">@activeCustomers.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="all-tab" data-bs-toggle="tab" data-bs-target="#allPanel" type="button" role="tab" style="font-weight: 600; font-size: 14px; border-radius: 10px 10px 0 0;">
            <i class="fa-solid fa-users me-1" style="color: #64748b;"></i> All Members
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1" style="font-size: 11px;">@allCustomers.Count</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content">

    <!-- ==================== ACTIVE + EMAIL TAB ==================== -->
    <div class="tab-pane fade show active" id="activeEmailPanel" role="tabpanel">
        <div class="card border-0 shadow-sm" style="border-radius: 0 0 14px 14px;">
            <div class="card-header bg-white border-0 py-3 px-4">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-sm btn-outline-primary" onclick="selectAllInTab('activeEmail')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-check-double me-1"></i> Select All
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="deselectAllInTab('activeEmail')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-xmark me-1"></i> Deselect
                        </button>
                        <div class="vr d-none d-md-block"></div>
                        <div class="input-group input-group-sm" style="max-width: 240px;">
                            <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px;"><i class="fa-solid fa-search text-muted" style="font-size: 12px;"></i></span>
                            <input type="text" class="form-control border-start-0 search-input" data-target="activeEmail" placeholder="Search member..." style="border-radius: 0 8px 8px 0; font-size: 13px;" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="form-check form-switch" style="font-size: 13px;">
                            <input class="form-check-input" type="checkbox" id="skipSentActiveEmail" checked />
                            <label class="form-check-label text-muted" for="skipSentActiveEmail">Skip already sent</label>
                        </div>
                        <button class="btn btn-primary btn-sm btn-send-email" data-tab="activeEmail" onclick="sendBulkEmail('activeEmail')" style="border-radius: 8px; font-size: 13px;" disabled>
                            <i class="fa-solid fa-paper-plane me-1"></i> Send QR Emails
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead>
                            <tr style="background: #f8fafc;">
                                <th style="width: 40px; padding: 12px 16px;"><input type="checkbox" class="form-check-input check-all-tab" data-tab="activeEmail" /></th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Member</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Email</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Phone</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Email Status</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in activeEmailOnly)
                            {
                                var sent = c.QREmailSentAt.HasValue;
                                <tr class="customer-row" data-tab="activeEmail" data-name="@c.FullName.ToLower()" data-email="yes" data-sent="@(sent ? "yes" : "no")">
                                    <td class="checkbox-cell" style="padding: 10px 16px;">
                                        <input type="checkbox" class="form-check-input customer-check" data-tab="activeEmail" value="@c.CustomerID" />
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (c.Photo != null && c.Photo.Length > 0)
                                            {
                                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(c.Photo)" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover; border: 2px solid #e2e8f0;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; font-size: 14px; font-weight: 700;">@c.FullName.Substring(0, 1).ToUpper()</div>
                                            }
                                            <div>
                                                <div class="fw-semibold" style="color: #1e293b; font-size: 14px;">@c.FullName</div>
                                                <div class="text-muted" style="font-size: 11px;">#@c.CustomerID</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px; font-size: 13px; color: #1e293b;">@c.Email</td>
                                    <td style="padding: 10px 8px; color: #64748b; font-size: 13px;">@c.Phone</td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        @if (sent)
                                        {
                                            <span class="badge" style="background: rgba(139, 92, 246, 0.1); color: #7c3aed; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-check me-1"></i>Sent @c.QREmailSentAt.Value.ToString("dd MMM")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(245, 158, 11, 0.1); color: #d97706; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <button class="btn btn-sm btn-send-single" data-id="@c.CustomerID" data-name="@c.FullName" data-sent="@(sent ? "yes" : "no")" title="Send QR email"
                                                    style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(59, 130, 246, 0.1); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.2);">
                                                <i class="fa-solid fa-paper-plane"></i>
                                            </button>
                                            <a href="/Attendance/CustomerQR/@c.CustomerID" class="btn btn-sm" title="View QR" style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(139, 92, 246, 0.1); color: #7c3aed; border: 1px solid rgba(139, 92, 246, 0.2);">
                                                <i class="fa-solid fa-qrcode"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!activeEmailOnly.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-envelope-circle-check d-block mb-2" style="font-size: 36px; opacity: 0.3;"></i>
                            <p class="mb-0 small">No active members with email found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ACTIVE MEMBERS TAB ==================== -->
    <div class="tab-pane fade" id="activePanel" role="tabpanel">
        <div class="card border-0 shadow-sm" style="border-radius: 0 0 14px 14px;">
            <div class="card-header bg-white border-0 py-3 px-4">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-sm btn-outline-success" onclick="selectAllInTab('active')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-check-double me-1"></i> Select All
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="deselectAllInTab('active')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-xmark me-1"></i> Deselect
                        </button>
                        <div class="vr d-none d-md-block"></div>
                        <div class="input-group input-group-sm" style="max-width: 240px;">
                            <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px;"><i class="fa-solid fa-search text-muted" style="font-size: 12px;"></i></span>
                            <input type="text" class="form-control border-start-0 search-input" data-target="active" placeholder="Search member..." style="border-radius: 0 8px 8px 0; font-size: 13px;" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="form-check form-switch" style="font-size: 13px;">
                            <input class="form-check-input" type="checkbox" id="skipSentActive" checked />
                            <label class="form-check-label text-muted" for="skipSentActive">Skip already sent</label>
                        </div>
                        <button class="btn btn-primary btn-sm btn-send-email" data-tab="active" onclick="sendBulkEmail('active')" style="border-radius: 8px; font-size: 13px;" disabled>
                            <i class="fa-solid fa-paper-plane me-1"></i> Send QR Emails
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead>
                            <tr style="background: #f8fafc;">
                                <th style="width: 40px; padding: 12px 16px;"><input type="checkbox" class="form-check-input check-all-tab" data-tab="active" /></th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Member</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Email</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Phone</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Email Status</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in activeCustomers)
                            {
                                var hasEmail = !string.IsNullOrWhiteSpace(c.Email);
                                var sent = c.QREmailSentAt.HasValue;
                                <tr class="customer-row" data-tab="active" data-name="@c.FullName.ToLower()" data-email="@(hasEmail ? "yes" : "no")" data-sent="@(sent ? "yes" : "no")">
                                    <td class="checkbox-cell" style="padding: 10px 16px;">
                                        @if (hasEmail)
                                        {
                                            <input type="checkbox" class="form-check-input customer-check" data-tab="active" value="@c.CustomerID" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-ban text-muted" title="No email" style="font-size: 11px;"></i>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (c.Photo != null && c.Photo.Length > 0)
                                            {
                                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(c.Photo)" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover; border: 2px solid #e2e8f0;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px; background: linear-gradient(135deg, #10b981, #059669); color: white; font-size: 14px; font-weight: 700;">@c.FullName.Substring(0, 1).ToUpper()</div>
                                            }
                                            <div>
                                                <div class="fw-semibold" style="color: #1e293b; font-size: 14px;">@c.FullName</div>
                                                <div class="text-muted" style="font-size: 11px;">#@c.CustomerID</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        @if (hasEmail)
                                        {
                                            <span style="color: #1e293b; font-size: 13px;">@c.Email</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic" style="font-size: 12px;">No email</span>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; color: #64748b; font-size: 13px;">@c.Phone</td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        @if (sent)
                                        {
                                            <span class="badge" style="background: rgba(139, 92, 246, 0.1); color: #7c3aed; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-check me-1"></i>Sent @c.QREmailSentAt.Value.ToString("dd MMM")
                                            </span>
                                        }
                                        else if (hasEmail)
                                        {
                                            <span class="badge" style="background: rgba(245, 158, 11, 0.1); color: #d97706; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 12px;">—</span>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        <div class="d-flex gap-1 justify-content-center">
                                            @if (hasEmail)
                                            {
                                                <button class="btn btn-sm btn-send-single" data-id="@c.CustomerID" data-name="@c.FullName" data-sent="@(sent ? "yes" : "no")" title="Send QR email"
                                                        style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(59, 130, 246, 0.1); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.2);">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            }
                                            <a href="/Attendance/CustomerQR/@c.CustomerID" class="btn btn-sm" title="View QR" style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(139, 92, 246, 0.1); color: #7c3aed; border: 1px solid rgba(139, 92, 246, 0.2);">
                                                <i class="fa-solid fa-qrcode"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!activeCustomers.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users-slash d-block mb-2" style="font-size: 36px; opacity: 0.3;"></i>
                            <p class="mb-0 small">No active members found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ALL MEMBERS TAB ==================== -->
    <div class="tab-pane fade" id="allPanel" role="tabpanel">
        <div class="card border-0 shadow-sm" style="border-radius: 0 0 14px 14px;">
            <div class="card-header bg-white border-0 py-3 px-4">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-sm btn-outline-secondary" onclick="selectAllInTab('all')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-check-double me-1"></i> Select All
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="deselectAllInTab('all')" style="border-radius: 8px; font-size: 13px;">
                            <i class="fa-solid fa-xmark me-1"></i> Deselect
                        </button>
                        <div class="vr d-none d-md-block"></div>
                        <div class="input-group input-group-sm" style="max-width: 240px;">
                            <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px;"><i class="fa-solid fa-search text-muted" style="font-size: 12px;"></i></span>
                            <input type="text" class="form-control border-start-0 search-input" data-target="all" placeholder="Search member..." style="border-radius: 0 8px 8px 0; font-size: 13px;" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="form-check form-switch" style="font-size: 13px;">
                            <input class="form-check-input" type="checkbox" id="skipSentAll" checked />
                            <label class="form-check-label text-muted" for="skipSentAll">Skip already sent</label>
                        </div>
                        <button class="btn btn-primary btn-sm btn-send-email" data-tab="all" onclick="sendBulkEmail('all')" style="border-radius: 8px; font-size: 13px;" disabled>
                            <i class="fa-solid fa-paper-plane me-1"></i> Send QR Emails
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead>
                            <tr style="background: #f8fafc;">
                                <th style="width: 40px; padding: 12px 16px;"><input type="checkbox" class="form-check-input check-all-tab" data-tab="all" /></th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Member</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Email</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px;">Phone</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Email Status</th>
                                <th style="padding: 12px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in allCustomers)
                            {
                                var hasEmail = !string.IsNullOrWhiteSpace(c.Email);
                                var sent = c.QREmailSentAt.HasValue;
                                <tr class="customer-row" data-tab="all" data-name="@c.FullName.ToLower()" data-email="@(hasEmail ? "yes" : "no")" data-sent="@(sent ? "yes" : "no")">
                                    <td class="checkbox-cell" style="padding: 10px 16px;">
                                        @if (hasEmail)
                                        {
                                            <input type="checkbox" class="form-check-input customer-check" data-tab="all" value="@c.CustomerID" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-ban text-muted" title="No email" style="font-size: 11px;"></i>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (c.Photo != null && c.Photo.Length > 0)
                                            {
                                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(c.Photo)" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover; border: 2px solid #e2e8f0;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px; background: linear-gradient(135deg, #64748b, #475569); color: white; font-size: 14px; font-weight: 700;">@c.FullName.Substring(0, 1).ToUpper()</div>
                                            }
                                            <div>
                                                <div class="fw-semibold" style="color: #1e293b; font-size: 14px;">@c.FullName</div>
                                                <div class="text-muted" style="font-size: 11px;">#@c.CustomerID</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        @if (hasEmail)
                                        {
                                            <span style="color: #1e293b; font-size: 13px;">@c.Email</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic" style="font-size: 12px;">No email</span>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; color: #64748b; font-size: 13px;">@c.Phone</td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        @if (sent)
                                        {
                                            <span class="badge" style="background: rgba(139, 92, 246, 0.1); color: #7c3aed; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-check me-1"></i>Sent @c.QREmailSentAt.Value.ToString("dd MMM")
                                            </span>
                                        }
                                        else if (hasEmail)
                                        {
                                            <span class="badge" style="background: rgba(245, 158, 11, 0.1); color: #d97706; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                                <i class="fa-solid fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 12px;">—</span>
                                        }
                                    </td>
                                    <td style="padding: 10px 8px; text-align: center;">
                                        <div class="d-flex gap-1 justify-content-center">
                                            @if (hasEmail)
                                            {
                                                <button class="btn btn-sm btn-send-single" data-id="@c.CustomerID" data-name="@c.FullName" data-sent="@(sent ? "yes" : "no")" title="Send QR email"
                                                        style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(59, 130, 246, 0.1); color: #2563eb; border: 1px solid rgba(59, 130, 246, 0.2);">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            }
                                            <a href="/Attendance/CustomerQR/@c.CustomerID" class="btn btn-sm" title="View QR" style="border-radius: 6px; font-size: 11px; padding: 3px 10px; background: rgba(139, 92, 246, 0.1); color: #7c3aed; border: 1px solid rgba(139, 92, 246, 0.2);">
                                                <i class="fa-solid fa-qrcode"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!allCustomers.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users-slash d-block mb-2" style="font-size: 36px; opacity: 0.3;"></i>
                            <p class="mb-0 small">No members found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Progress Bar (hidden) -->
<div class="card border-0 shadow-sm mt-3" id="progressCard" style="border-radius: 14px; display: none;">
    <div class="card-body py-3 px-4">
        <div class="d-flex justify-content-between mb-2">
            <span class="fw-semibold" style="font-size: 14px;" id="progressText">Sending emails...</span>
            <span class="text-muted" style="font-size: 13px;" id="progressPercent">0%</span>
        </div>
        <div class="progress" style="height: 8px; border-radius: 4px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" role="progressbar" style="width: 0%; border-radius: 4px;"></div>
        </div>
    </div>
</div>

<style>
    .btn-send-single:hover { background: rgba(59, 130, 246, 0.2) !important; transform: translateY(-1px); }
    .btn-send-single:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }
    /* Make checkboxes easier to click */
    .customer-check, .check-all-tab { width: 18px; height: 18px; cursor: pointer; }
    .checkbox-cell { cursor: pointer; user-select: none; }
    .customer-row { cursor: default; }
    .customer-row td:first-child { cursor: pointer; }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    window.addEventListener('load', function () {

        // Checkbox change -> update counts
        document.querySelectorAll('.customer-check').forEach(function (cb) {
            cb.addEventListener('change', updateCount);
        });

        // Click anywhere in the checkbox cell to toggle
        document.querySelectorAll('.checkbox-cell').forEach(function (td) {
            td.addEventListener('click', function (e) {
                if (e.target.tagName === 'INPUT') return; // already toggled natively
                var cb = td.querySelector('.customer-check');
                if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
            });
        });

        // Also allow clicking the entire row to toggle (except action buttons/links)
        document.querySelectorAll('.customer-row').forEach(function (row) {
            row.addEventListener('click', function (e) {
                // Don't toggle if clicking buttons, links, or the checkbox cell itself
                if (e.target.closest('a') || e.target.closest('button') || e.target.closest('.checkbox-cell') || e.target.tagName === 'INPUT') return;
                var cb = row.querySelector('.customer-check');
                if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
            });
        });

        // Check-all per tab
        document.querySelectorAll('.check-all-tab').forEach(function (master) {
            master.addEventListener('change', function () {
                var tab = this.getAttribute('data-tab');
                document.querySelectorAll('.customer-check[data-tab="' + tab + '"]').forEach(function (cb) {
                    if (cb.closest('tr').style.display !== 'none') cb.checked = master.checked;
                });
                updateCount();
            });
        });

        // Search per tab
        document.querySelectorAll('.search-input').forEach(function (input) {
            input.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                var tab = this.getAttribute('data-target');
                document.querySelectorAll('.customer-row[data-tab="' + tab + '"]').forEach(function (row) {
                    row.style.display = row.getAttribute('data-name').indexOf(term) >= 0 ? '' : 'none';
                });
            });
        });

        // Tab switch -> update counts
        document.querySelectorAll('#memberTabs button[data-bs-toggle="tab"]').forEach(function (tabBtn) {
            tabBtn.addEventListener('shown.bs.tab', function () { updateCount(); });
        });

        // Individual send buttons
        document.querySelectorAll('.btn-send-single').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = parseInt(this.getAttribute('data-id'));
                var name = this.getAttribute('data-name');
                var alreadySent = this.getAttribute('data-sent') === 'yes';
                var button = this;

                var msg = alreadySent
                    ? 'QR email was already sent to <strong>' + name + '</strong>. Send again?'
                    : 'Send QR code email to <strong>' + name + '</strong>?';

                Swal.fire({
                    title: alreadySent ? 'Resend QR Email?' : 'Send QR Email?',
                    html: msg,
                    icon: alreadySent ? 'warning' : 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3b82f6',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="fa-solid fa-paper-plane me-1"></i> ' + (alreadySent ? 'Resend' : 'Send'),
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    fetch('/Attendance/SendBulkEmail', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ customerIds: [id], skipAlreadySent: false })
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Email Sent!',
                                html: 'QR code email sent to <strong>' + name + '</strong>',
                                timer: 1800,
                                showConfirmButton: false
                            });
                            setTimeout(function () { location.reload(); }, 1900);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Failed', text: data.message, confirmButtonColor: '#ef4444' });
                            button.disabled = false;
                            button.innerHTML = '<i class="fa-solid fa-paper-plane"></i>';
                        }
                    })
                    .catch(function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to send email. Check SMTP settings.', confirmButtonColor: '#ef4444' });
                        button.disabled = false;
                        button.innerHTML = '<i class="fa-solid fa-paper-plane"></i>';
                    });
                });
            });
        });
    });

    function getActiveTab() {
        var active = document.querySelector('#memberTabs .nav-link.active');
        if (active && active.id === 'all-tab') return 'all';
        if (active && active.id === 'active-tab') return 'active';
        return 'activeEmail';
    }

    function updateCount() {
        var tab = getActiveTab();
        var checked = document.querySelectorAll('.customer-check[data-tab="' + tab + '"]:checked').length;
        document.getElementById('selectedCount').textContent = checked;

        document.querySelectorAll('.btn-send-email').forEach(function (btn) {
            var btnTab = btn.getAttribute('data-tab');
            var cnt = document.querySelectorAll('.customer-check[data-tab="' + btnTab + '"]:checked').length;
            btn.disabled = cnt === 0;
        });
    }

    function selectAllInTab(tab) {
        document.querySelectorAll('.customer-check[data-tab="' + tab + '"]').forEach(function (cb) {
            if (cb.closest('tr').style.display !== 'none') cb.checked = true;
        });
        var master = document.querySelector('.check-all-tab[data-tab="' + tab + '"]');
        if (master) master.checked = true;
        updateCount();
    }

    function deselectAllInTab(tab) {
        document.querySelectorAll('.customer-check[data-tab="' + tab + '"]').forEach(function (cb) { cb.checked = false; });
        var master = document.querySelector('.check-all-tab[data-tab="' + tab + '"]');
        if (master) master.checked = false;
        updateCount();
    }

    function sendBulkEmail(tab) {
        var ids = [];
        document.querySelectorAll('.customer-check[data-tab="' + tab + '"]:checked').forEach(function (cb) {
            ids.push(parseInt(cb.value));
        });
        if (ids.length === 0) return;

        var skipMap = { 'activeEmail': 'skipSentActiveEmail', 'active': 'skipSentActive', 'all': 'skipSentAll' };
        var skipAlreadySent = document.getElementById(skipMap[tab]).checked;

        Swal.fire({
            title: 'Send QR Emails?',
            html: 'Send QR code emails to <strong>' + ids.length + '</strong> member(s)?' +
                  (skipAlreadySent ? '<br/><small class="text-muted">Members who already received emails will be skipped.</small>' : ''),
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="fa-solid fa-paper-plane me-1"></i> Yes, Send',
            cancelButtonText: 'Cancel'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var btn = document.querySelector('.btn-send-email[data-tab="' + tab + '"]');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...';

            var progressCard = document.getElementById('progressCard');
            var progressBar = document.getElementById('progressBar');
            var progressText = document.getElementById('progressText');
            var progressPercent = document.getElementById('progressPercent');
            progressCard.style.display = 'block';
            progressBar.style.width = '15%';
            progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated';
            progressText.textContent = 'Sending ' + ids.length + ' email(s)... Please wait.';
            progressPercent.textContent = '';

            fetch('/Attendance/SendBulkEmail', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerIds: ids, skipAlreadySent: skipAlreadySent })
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                progressBar.style.width = '100%';
                progressBar.classList.remove('progress-bar-striped', 'progress-bar-animated');

                if (data.success) {
                    progressBar.classList.add('bg-success');
                    progressText.textContent = 'Done! ' + data.message;
                    progressPercent.textContent = '100%';
                    Swal.fire({
                        icon: 'success',
                        title: 'Emails Sent!',
                        html: '<b>Sent:</b> ' + data.sent + '<br/><b>Failed:</b> ' + data.failed +
                              (data.alreadySentCount > 0 ? '<br/><b>Already sent (skipped):</b> ' + data.alreadySentCount : '') +
                              (data.skippedCount > 0 ? '<br/><b>No email (skipped):</b> ' + data.skippedCount : ''),
                        confirmButtonColor: '#3b82f6'
                    }).then(function () { location.reload(); });
                } else {
                    progressBar.classList.add('bg-warning');
                    progressText.textContent = data.message;
                    Swal.fire({ icon: 'warning', title: 'Notice', text: data.message, confirmButtonColor: '#f59e0b' });
                }

                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Send QR Emails';
            })
            .catch(function () {
                progressBar.style.width = '100%';
                progressBar.classList.add('bg-danger');
                progressText.textContent = 'Something went wrong.';
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to send emails. Check SMTP settings.', confirmButtonColor: '#ef4444' });
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Send QR Emails';
            });
        });
    }
</script>
}
