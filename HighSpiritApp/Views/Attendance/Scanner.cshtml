@{
    ViewData["Title"] = "QR Scanner";
}

<!-- Page Header -->
<div class="page-header-row d-flex flex-wrap justify-content-between align-items-center mb-4" style="min-height: 70px;">
    <h4 class="page-title mb-0">
        <i class="fa-solid fa-camera me-2" style="color: #8b5cf6;"></i>
        <span>QR Scanner</span>
    </h4>
    <a href="/Attendance" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-list-check me-1"></i> View Records
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <!-- Scanner Card -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 text-center">
                <h5 class="fw-bold mb-1" style="color: #1e293b;">
                    <i class="fa-solid fa-qrcode me-2 text-primary"></i>Scan Customer QR
                </h5>
                <p class="text-muted mb-3" style="font-size: 14px;">Point the camera at a customer's QR code to punch in/out</p>

                <!-- Camera preview -->
                <div id="qr-reader" style="width: 100%; max-width: 400px; margin: 0 auto; border-radius: 12px; overflow: hidden;"></div>

                <!-- Manual ID entry fallback -->
                <div class="mt-3 pt-3 border-top">
                    <p class="text-muted mb-2" style="font-size: 13px;">Or enter Customer ID manually:</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <input type="number" id="manualIdInput" class="form-control" placeholder="Customer ID"
                               min="1" style="max-width: 180px; border-radius: 8px;" inputmode="numeric" />
                        <button class="btn btn-primary" onclick="manualPunch()" style="border-radius: 8px;">
                            <i class="fa-solid fa-fingerprint me-1"></i> Punch
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Display -->
        <div class="card border-0 shadow-sm mt-3" id="resultCard" style="border-radius: 16px; display: none;">
            <div class="card-body p-4 text-center" id="resultBody">
                <div id="resultIcon" style="font-size: 48px;"></div>
                <div id="resultName" class="fw-bold mt-2" style="font-size: 20px; color: #1e293b;"></div>
                <div id="resultType" class="fw-semibold" style="font-size: 16px;"></div>
                <div id="resultTime" class="text-muted" style="font-size: 14px;"></div>
                <div id="resultMessage" class="text-muted mt-1" style="font-size: 14px;"></div>
            </div>
        </div>

        <!-- Today's Quick Stats -->
        <div class="row mt-3 g-3">
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center" style="border-radius: 12px;">
                    <div class="card-body py-3">
                        <div class="text-muted" style="font-size: 11px;">Check-ins</div>
                        <div class="fw-bold text-primary" style="font-size: 24px;" id="statCheckIns">0</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center" style="border-radius: 12px;">
                    <div class="card-body py-3">
                        <div class="text-muted" style="font-size: 11px;">In Gym</div>
                        <div class="fw-bold text-success" style="font-size: 24px;" id="statInGym">0</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm text-center" style="border-radius: 12px;">
                    <div class="card-body py-3">
                        <div class="text-muted" style="font-size: 11px;">Left</div>
                        <div class="fw-bold" style="font-size: 24px; color: #f59e0b;" id="statLeft">0</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Scans -->
        <div class="card border-0 shadow-sm mt-3" style="border-radius: 16px;">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-2" style="color: #1e293b;">
                    <i class="fa-solid fa-clock-rotate-left me-2 text-muted"></i>Recent Scans
                </h6>
                <div id="recentScans" class="d-flex flex-column gap-1">
                    <p class="text-muted text-center mb-0" style="font-size: 13px;">No scans yet. Start scanning!</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- html5-qrcode library for camera-based QR scanning -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        window.addEventListener('load', function () {
            var scanCooldown = false;
            var recentScansList = [];

            var html5QrCode = new Html5Qrcode("qr-reader");

            var config = {
                fps: 10,
                qrbox: { width: 250, height: 250 },
                aspectRatio: 1.0
            };

            html5QrCode.start(
                { facingMode: "environment" },
                config,
                onScanSuccess,
                onScanFailure
            ).catch(function (err) {
                console.warn('Camera start failed:', err);
                document.getElementById('qr-reader').innerHTML =
                    '<div class="alert alert-warning m-3">' +
                    '<i class="fa-solid fa-camera-rotate me-2"></i>' +
                    '<strong>Camera not available.</strong> Use manual entry below.' +
                    '</div>';
            });

            function onScanSuccess(decodedText, decodedResult) {
                if (scanCooldown) return;
                if (!decodedText || decodedText.trim().length === 0) {
                    toastr.warning('Empty QR code.');
                    return;
                }
                scanCooldown = true;
                processPunchByQR(decodedText.trim());
                setTimeout(function () { scanCooldown = false; }, 3000);
            }

            function onScanFailure(error) { }

            window.manualPunch = function () {
                var input = document.getElementById('manualIdInput');
                var customerId = parseInt(input.value);
                if (isNaN(customerId) || customerId <= 0) {
                    toastr.warning('Please enter a valid Customer ID.');
                    input.focus();
                    return;
                }
                processPunchByManual(customerId);
                input.value = '';
            };

            document.getElementById('manualIdInput').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') window.manualPunch();
            });

            function processPunchByQR(qrCode) {
                $.ajax({
                    url: '/Attendance/ProcessPunch',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ qrCode: qrCode }),
                    success: function (response) {
                        showResult(response);
                        addRecentScan(response);
                        playBeep(response.success);
                    },
                    error: function () {
                        toastr.error('Something went wrong. Please try again.');
                    }
                });
            }

            function processPunchByManual(customerId) {
                $.ajax({
                    url: '/Attendance/ProcessPunch',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ customerId: customerId }),
                    success: function (response) {
                        showResult(response);
                        addRecentScan(response);
                        playBeep(response.success);
                    },
                    error: function () {
                        toastr.error('Something went wrong. Please try again.');
                    }
                });
            }

            function showResult(response) {
                var card = document.getElementById('resultCard');
                var icon = document.getElementById('resultIcon');
                var name = document.getElementById('resultName');
                var type = document.getElementById('resultType');
                var time = document.getElementById('resultTime');
                var message = document.getElementById('resultMessage');

                card.style.borderLeft = '5px solid';

                if (response.punchType === 'PunchIn') {
                    card.style.borderLeftColor = '#10b981';
                    icon.innerHTML = '<i class="fa-solid fa-right-to-bracket" style="color: #10b981;"></i>';
                    type.textContent = 'Punched In';
                    type.style.color = '#10b981';
                    time.textContent = response.time ? 'at ' + response.time : '';
                } else if (response.punchType === 'PunchOut') {
                    card.style.borderLeftColor = '#f59e0b';
                    icon.innerHTML = '<i class="fa-solid fa-right-from-bracket" style="color: #f59e0b;"></i>';
                    type.textContent = 'Punched Out';
                    type.style.color = '#f59e0b';
                    time.textContent = response.time ? 'at ' + response.time : '';
                } else if (response.punchType === 'AlreadyDone') {
                    card.style.borderLeftColor = '#6366f1';
                    icon.innerHTML = '<i class="fa-solid fa-circle-info" style="color: #6366f1;"></i>';
                    type.textContent = 'Already Done';
                    type.style.color = '#6366f1';
                    time.textContent = '';
                } else {
                    card.style.borderLeftColor = '#ef4444';
                    icon.innerHTML = '<i class="fa-solid fa-circle-xmark" style="color: #ef4444;"></i>';
                    type.textContent = 'Error';
                    type.style.color = '#ef4444';
                    time.textContent = '';
                }

                name.textContent = response.customerName || '';
                message.textContent = response.message;
                card.style.display = 'block';
                setTimeout(function () { card.style.display = 'none'; }, 6000);
            }

            function addRecentScan(response) {
                var now = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
                var statusColor = response.punchType === 'PunchIn' ? '#10b981' :
                                  response.punchType === 'PunchOut' ? '#f59e0b' :
                                  response.punchType === 'AlreadyDone' ? '#6366f1' : '#ef4444';
                var statusText = response.punchType === 'PunchIn' ? 'IN' :
                                 response.punchType === 'PunchOut' ? 'OUT' :
                                 response.punchType === 'AlreadyDone' ? 'DONE' : 'ERR';

                recentScansList.unshift({ name: response.customerName || 'Unknown', status: statusText, color: statusColor, time: now });
                if (recentScansList.length > 8) recentScansList.pop();

                var container = document.getElementById('recentScans');
                container.innerHTML = '';
                recentScansList.forEach(function (scan) {
                    container.innerHTML +=
                        '<div class="d-flex justify-content-between align-items-center py-1 px-2" style="border-radius: 8px; background: #f8fafc;">' +
                        '<span style="font-size: 14px; font-weight: 600; color: #1e293b;">' + scan.name + '</span>' +
                        '<div class="d-flex align-items-center gap-2">' +
                        '<span class="badge" style="background:' + scan.color + '15; color:' + scan.color + '; font-size: 11px; padding: 3px 8px; border-radius: 5px;">' + scan.status + '</span>' +
                        '<span class="text-muted" style="font-size: 12px;">' + scan.time + '</span>' +
                        '</div></div>';
                });

                if (response.success && response.punchType === 'PunchIn') {
                    var ci = document.getElementById('statCheckIns');
                    ci.textContent = parseInt(ci.textContent) + 1;
                    var ig = document.getElementById('statInGym');
                    ig.textContent = parseInt(ig.textContent) + 1;
                } else if (response.success && response.punchType === 'PunchOut') {
                    var ig2 = document.getElementById('statInGym');
                    ig2.textContent = Math.max(0, parseInt(ig2.textContent) - 1);
                    var left = document.getElementById('statLeft');
                    left.textContent = parseInt(left.textContent) + 1;
                }
            }

            function playBeep(success) {
                try {
                    var ctx = new (window.AudioContext || window.webkitAudioContext)();
                    var oscillator = ctx.createOscillator();
                    var gainNode = ctx.createGain();
                    oscillator.connect(gainNode);
                    gainNode.connect(ctx.destination);
                    oscillator.frequency.value = success ? 800 : 300;
                    oscillator.type = 'sine';
                    gainNode.gain.value = 0.3;
                    oscillator.start();
                    setTimeout(function () { oscillator.stop(); ctx.close(); }, success ? 150 : 400);
                } catch (e) { }
            }
        });
    </script>
}
