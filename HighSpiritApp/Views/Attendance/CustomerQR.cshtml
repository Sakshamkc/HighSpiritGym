@{
    ViewData["Title"] = "Customer QR Code";
    var customer = ViewBag.Customer as HighSpiritApp.Models.Customer;
}

<style>
    @@media print {
        .page-header-row, .action-buttons, .sidebar, .navbar, .topbar, header, footer, nav {
            display: none !important;
        }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .content-area { margin: 0 !important; padding: 0 !important; }
        body { background: white !important; }
        .qr-print-card { box-shadow: none !important; border: 2px solid #e2e8f0 !important; margin: 20px auto !important; }
    }
</style>

<!-- Page Header -->
<div class="page-header-row d-flex flex-wrap justify-content-between align-items-center mb-4" style="min-height: 70px;">
    <h4 class="page-title mb-0">
        <i class="fa-solid fa-qrcode me-2" style="color: #8b5cf6;"></i>
        <span>Customer QR Code</span>
    </h4>
    <a href="/Customers/Details/@customer?.CustomerID" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Profile
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <!-- QR Card - designed as a printable membership card -->
        <div class="card border-0 shadow-sm qr-print-card" id="qrCard" style="border-radius: 16px;">
            <div class="card-body text-center p-4">
                <!-- Gym header -->
                <div class="mb-3 pb-3 border-bottom">
                    <h5 class="fw-bold mb-0" style="color: #1e293b;">
                        <i class="fa-solid fa-dumbbell me-2 text-primary"></i>High Spirit Gym
                    </h5>
                    <small class="text-muted">Membership QR Card</small>
                </div>

                <!-- Customer info -->
                <div class="mb-3">
                    @if (customer?.Photo != null && customer.Photo.Length > 0)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(customer.Photo)"
                             alt="Photo" class="rounded-circle mb-2"
                             style="width: 70px; height: 70px; object-fit: cover; border: 3px solid #e2e8f0;" />
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2"
                             style="width: 70px; height: 70px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; font-size: 28px; font-weight: 700;">
                            @(customer?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                    }
                    <h5 class="fw-bold mb-0" style="color: #1e293b;">@customer?.FullName</h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary mt-1" style="font-size: 13px;">
                        ID: #@customer?.CustomerID
                    </span>
                </div>

                <!-- QR Code -->
                <div class="d-inline-block p-3 bg-white border rounded-3 shadow-sm mb-3">
                    <img src="@ViewBag.QRCodeImage" alt="Customer QR Code" style="width: 200px; height: 200px;" id="qrImage" />
                </div>

                <p class="text-muted mb-0" style="font-size: 12px;">
                    <i class="fa-solid fa-info-circle me-1"></i>
                    Show this QR at the gym entrance for attendance
                </p>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-2 justify-content-center mt-3 action-buttons">
            <button class="btn btn-primary px-4" onclick="window.print()" style="border-radius: 10px;">
                <i class="fa-solid fa-print me-2"></i>Print Card
            </button>
            <button class="btn btn-outline-secondary px-4" id="downloadBtn" style="border-radius: 10px;">
                <i class="fa-solid fa-download me-2"></i>Download
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('downloadBtn').addEventListener('click', function () {
            var link = document.createElement('a');
            var img = document.getElementById('qrImage');
            link.href = img.src;
            link.download = 'QR-Card.png';
            link.click();
        });
    </script>
}
