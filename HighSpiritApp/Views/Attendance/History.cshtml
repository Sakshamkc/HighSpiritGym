@model List<HighSpiritApp.Models.Attendance>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Attendance History";

    var search = ViewBag.Search as string;
    var fromDate = ViewBag.From as string;
    var toDate = ViewBag.To as string;
    int totalRecords = ViewBag.TotalRecords;
    int uniqueCustomers = ViewBag.UniqueCustomers;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-primary);">
            <i class="fa-solid fa-clock-rotate-left me-2" style="color: var(--accent-color);"></i>Attendance History
        </h4>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">View past attendance records</p>
    </div>
    <a href="/Attendance" class="btn btn-sm btn-outline-primary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Today
    </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px; height:48px; background: linear-gradient(135deg, #3b82f6, #60a5fa);">
                    <i class="fa-solid fa-list-check text-white"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: var(--text-primary);">@totalRecords</div>
                    <div class="text-muted" style="font-size:0.85rem;">Total Records</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px; height:48px; background: linear-gradient(135deg, #8b5cf6, #a78bfa);">
                    <i class="fa-solid fa-user-group text-white"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: var(--text-primary);">@uniqueCustomers</div>
                    <div class="text-muted" style="font-size:0.85rem;">Unique Customers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="/Attendance/History" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted" style="font-size:0.8rem;">Search Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Name..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted" style="font-size:0.8rem;">From</label>
                <input type="date" name="from" class="form-control" value="@fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted" style="font-size:0.8rem;">To</label>
                <input type="date" name="to" class="form-control" value="@toDate" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
                <a href="/Attendance/History" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- History Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-clock-rotate-left fa-3x text-muted mb-3" style="opacity:0.3;"></i>
                <p class="text-muted">No attendance records found for this period.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr style="background: var(--table-stripe);">
                            <th class="ps-4" style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">#</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Date</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Name</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Phone</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Punch In</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Punch Out</th>
                            <th style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var idx = 0;
                        }
                        @foreach (var item in Model)
                        {
                            idx++;
                            var duration = item.CheckOutTime.HasValue
                                ? (item.CheckOutTime.Value - item.CheckInTime).ToString(@"h\h\ m\m")
                                : "—";
                            <tr>
                                <td class="ps-4 text-muted">@idx</td>
                                <td style="color: var(--text-secondary);">@item.CheckInTime.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="fw-semibold" style="color: var(--text-primary);">@item.CustomerName</span>
                                </td>
                                <td style="color: var(--text-secondary);">@(item.Notes ?? "—")</td>
                                <td>
                                    <span style="color: var(--text-secondary);">
                                        <i class="fa-solid fa-right-to-bracket me-1"
                                           style="color:#10b981; font-size:0.8rem;"></i>
                                        @item.CheckInTime.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span style="color: var(--text-secondary);">
                                            <i class="fa-solid fa-right-from-bracket me-1"
                                               style="color:#f59e0b; font-size:0.8rem;"></i>
                                            @item.CheckOutTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td style="color: var(--text-secondary);">@duration</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
