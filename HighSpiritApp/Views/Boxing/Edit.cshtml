@model HighSpiritApp.Models.Boxing.BoxingMember
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var joinDateValue = Model.JoinDate.HasValue && Model.JoinDate.Value > DateTime.MinValue
        ? Model.JoinDate.Value.ToString("yyyy-MM-dd")
        : "";
    string category = ViewBag.Category ?? Model.Category ?? "Children";
    bool isAdult = category == "Adult";

    var returnUrlRaw = Context.Request.Query["returnUrl"].FirstOrDefault();
    var backUrl = !string.IsNullOrEmpty(returnUrlRaw) ? Uri.UnescapeDataString(returnUrlRaw) : $"/Boxing?category={category}";
    string memberLabel = isAdult ? "Member" : "Kid";
}

<style>
    .edit-header {
        background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%);
        border-radius: 16px;
        padding: 20px 25px;
        color: white;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .edit-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .edit-header h4 i {
        font-size: 24px;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }
    .form-card-header {
        background: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .form-card-header i {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .form-card-header.kid i {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }
    .form-card-header.guardian i {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }
    .form-card-header.payment i {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    .form-card-header.class i {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
    }
    .form-card-header h5 {
        margin: 0;
        font-weight: 600;
        color: #1e293b;
    }
    .form-card-body {
        padding: 25px;
    }

    .photo-preview {
        width: 150px;
        height: 150px;
        border-radius: 16px;
        object-fit: cover;
        border: 3px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .photo-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 16px;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        color: #94a3b8;
        border: 3px dashed #cbd5e1;
    }

    .form-label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
    }
    .form-label .required {
        color: #ef4444;
    }
    .form-control {
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        padding: 10px 14px;
        transition: all 0.2s ease;
    }
    .form-control:focus {
        border-color: #ef4444;
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
    }

    .payment-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    .payment-input-group {
        position: relative;
    }
    .payment-input-group .icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        z-index: 1;
    }
    .payment-input-group .icon.cash { color: #2563eb; }
    .payment-input-group .icon.esewa { color: #65a30d; }
    .payment-input-group .icon.due { color: #dc2626; }
    .payment-input-group input {
        padding-left: 45px;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
    }
    .payment-input-group.cash input {
        background: #eff6ff;
        border-color: #bfdbfe;
    }
    .payment-input-group.esewa input {
        background: #f7fee7;
        border-color: #bef264;
    }
    .payment-input-group.due input {
        background: #fef2f2;
        border-color: #fecaca;
    }

    .class-input-hint {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 10px;
        padding: 12px 16px;
        margin-top: 10px;
    }
    .class-input-hint i {
        color: #0284c7;
    }

    .btn-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        padding: 12px 30px;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.2s ease;
    }
    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }
    .btn-cancel {
        padding: 12px 30px;
        font-weight: 600;
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        .payment-grid {
            grid-template-columns: 1fr;
        }
        .edit-header {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }
    }
</style>

<!-- Header -->
<div class="edit-header">
    <h4>
        <i class="fa-solid fa-user-pen"></i>
        Edit @(isAdult ? "Adult" : "Children") Boxing Member
    </h4>
    <a href="@backUrl" class="btn btn-outline-light">
        <i class="fa-solid fa-arrow-left me-2"></i> Back
    </a>
</div>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="BoxingMemberID" />

    <div class="row">
        <!-- Left Column -->
        <div class="col-lg-8">
            <!-- Kid Information -->
            <div class="form-card">
                <div class="form-card-header kid">
                    <i class="fa-solid @(isAdult ? "fa-person" : "fa-child")"></i>
                    <h5>@memberLabel Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@memberLabel Name <span class="required">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter @(memberLabel.ToLower())'s full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Join Date</label>
                            <input name="JoinDate" type="date" class="form-control" value="@joinDateValue" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guardian Information -->
            <div class="form-card">
                <div class="form-card-header guardian">
                    <i class="fa-solid fa-user-shield"></i>
                    <h5>Guardian Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Guardian Name <span class="required">*</span></label>
                            <input asp-for="GuardianName" class="form-control" placeholder="Enter guardian's name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Number <span class="required">*</span></label>
                            <input asp-for="GuardianContact" class="form-control" placeholder="Enter phone number" required />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Class Schedule -->
            <div class="form-card">
                <div class="form-card-header class">
                    <i class="fa-solid fa-calendar-days"></i>
                    <h5>Class Schedule</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Per Month Class</label>
                            <input asp-for="PerMonthClass" class="form-control" placeholder="e.g. 1+1+1+1" />
                            <div class="class-input-hint">
                                <i class="fa-solid fa-lightbulb me-2"></i>
                                <small>Format: Classes per week (e.g., <strong>1+1+1+1</strong> = 1 class each week)</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Any additional notes..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Information -->
            <div class="form-card">
                <div class="form-card-header payment">
                    <i class="fa-solid fa-money-bill-wave"></i>
                    <h5>Payment Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="payment-grid">
                        <div>
                            <label class="form-label"><i class="fa-solid fa-money-bill me-2 text-primary"></i>Cash Amount</label>
                            <div class="payment-input-group cash">
                                <i class="fa-solid fa-money-bill icon cash"></i>
                                <input asp-for="CashAmount" type="number" class="form-control" placeholder="0" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label"><i class="fa-solid fa-mobile-screen me-2 text-success"></i>eSewa Amount</label>
                            <div class="payment-input-group esewa">
                                <i class="fa-solid fa-mobile-screen icon esewa"></i>
                                <input asp-for="EsewaAmount" type="number" class="form-control" placeholder="0" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label"><i class="fa-solid fa-clock me-2 text-danger"></i>Due Amount</label>
                            <div class="payment-input-group due">
                                <i class="fa-solid fa-clock icon due"></i>
                                <input asp-for="DueAmount" type="number" class="form-control" placeholder="0" />
                            </div>
                        </div>
                    </div>
                    <input type="hidden" asp-for="Price" />
                </div>
            </div>
        </div>

        <!-- Right Column - Photo -->
        <div class="col-lg-4">
            <div class="form-card">
                <div class="form-card-header kid">
                    <i class="fa-solid fa-camera"></i>
                    <h5>Photo</h5>
                </div>
                <div class="form-card-body text-center">
                    @if (Model.Photo != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Photo)" 
                             class="photo-preview mb-3" alt="@Model.Name" id="photoPreview" />
                    }
                    else
                    {
                        <div class="photo-placeholder mb-3 mx-auto" id="photoPlaceholder">
                            <i class="fa-solid fa-child"></i>
                        </div>
                        <img src="" class="photo-preview mb-3 d-none" alt="Preview" id="photoPreview" />
                    }
                    
                    <label class="form-label d-block">Change Photo</label>
                    <input type="file" name="photoFile" class="form-control" accept="image/*" 
                           onchange="previewPhoto(this)" />
                    <small class="text-muted d-block mt-2">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        Supported: JPG, PNG (Max 5MB)
                    </small>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="form-card">
                <div class="form-card-header payment">
                    <i class="fa-solid fa-chart-pie"></i>
                    <h5>Payment Summary</h5>
                </div>
                <div class="form-card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Total Paid:</span>
                        <span class="fw-bold text-success fs-5" id="totalPaidDisplay">
                            Rs. @((Model.CashAmount + Model.EsewaAmount).ToString("N0"))
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Due Amount:</span>
                        <span class="fw-bold @(Model.DueAmount > 0 ? "text-danger" : "text-success") fs-5" id="dueDisplay">
                            Rs. @Model.DueAmount.ToString("N0")
                        </span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Status:</span>
                        <span class="badge @(Model.DueAmount > 0 ? "bg-warning" : "bg-success") fs-6" id="statusBadge">
                            @(Model.DueAmount > 0 ? "Partial" : "Paid")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success btn-save btn-lg">
            <i class="fa-solid fa-check me-2"></i> Save Changes
        </button>
        <a href="@backUrl" class="btn btn-outline-secondary btn-cancel btn-lg">
            Cancel
        </a>
    </div>
</form>

<script>
    function previewPhoto(input) {
        const preview = document.getElementById('photoPreview');
        const placeholder = document.getElementById('photoPlaceholder');
        
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
                if (placeholder) placeholder.classList.add('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Update payment summary in real-time
    const cashInput = document.querySelector('input[name="CashAmount"]');
    const esewaInput = document.querySelector('input[name="EsewaAmount"]');
    const dueInput = document.querySelector('input[name="DueAmount"]');
    const totalPaidDisplay = document.getElementById('totalPaidDisplay');
    const dueDisplay = document.getElementById('dueDisplay');
    const statusBadge = document.getElementById('statusBadge');

    function updateSummary() {
        const cash = parseInt(cashInput.value) || 0;
        const esewa = parseInt(esewaInput.value) || 0;
        const due = parseInt(dueInput.value) || 0;
        const total = cash + esewa;

        totalPaidDisplay.textContent = 'Rs. ' + total.toLocaleString();
        dueDisplay.textContent = 'Rs. ' + due.toLocaleString();
        
        if (due > 0) {
            dueDisplay.className = 'fw-bold text-danger fs-5';
            statusBadge.className = 'badge bg-warning fs-6';
            statusBadge.textContent = 'Partial';
        } else {
            dueDisplay.className = 'fw-bold text-success fs-5';
            statusBadge.className = 'badge bg-success fs-6';
            statusBadge.textContent = 'Paid';
        }
    }

    cashInput.addEventListener('input', updateSummary);
    esewaInput.addEventListener('input', updateSummary);
    dueInput.addEventListener('input', updateSummary);
</script>
