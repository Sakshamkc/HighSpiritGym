@model List<HighSpiritApp.Models.Boxing.BoxingMember>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int sn = (ViewBag.Page - 1) * 10 + 1;
    string category = ViewBag.Category ?? "Children";
    bool isAdult = category == "Adult";
    bool isAll = category == "All";
    string categoryLabel = isAll ? "All" : (isAdult ? "Adult" : "Children");
    string categoryIcon = isAll ? "fa-hand-fist" : (isAdult ? "fa-person" : "fa-child");
    
    // Build query string for links
    string BuildQuery(string? overridePayment = null, int? overridePage = null)
    {
        var parts = new List<string>();
        parts.Add($"category={category}");
        if (!string.IsNullOrEmpty(ViewBag.Search as string))
            parts.Add($"search={ViewBag.Search}");
        if (!string.IsNullOrEmpty(overridePayment) || !string.IsNullOrEmpty(ViewBag.PaymentStatus as string))
            parts.Add($"paymentStatus={overridePayment ?? ViewBag.PaymentStatus}");
        if (overridePage.HasValue)
            parts.Add($"page={overridePage}");
        return "?" + string.Join("&", parts);
    }
    
    // Check if any filters are active
    bool hasActiveFilters = !string.IsNullOrEmpty(ViewBag.PaymentStatus as string);
}

<h4 class="mb-3 page-title">
    <i class="fa-solid fa-hand-fist me-2 text-danger"></i>
    <span>@categoryLabel Boxing Members</span>
</h4>

<form method="get" class="mb-3" id="searchForm">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="search-container">
            <i class="fa-solid fa-search search-icon"></i>
            <input name="search"
                   id="searchInput"
                   value="@ViewBag.Search"
                   class="form-control search-input"
                   placeholder="Search by @(isAdult ? "member" : "kid") or guardian name..."
                   autocomplete="off" />
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <button type="button" class="search-clear" id="clearSearch" title="Clear search">
                    <i class="fa-solid fa-times"></i>
                </button>
            }
            <button type="submit" class="search-btn" title="Search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>Search</span>
            </button>
        </div>
        <input type="hidden" name="category" value="@category" />
        <input type="hidden" name="paymentStatus" value="@ViewBag.PaymentStatus" />

        @if (!isAll)
        {
            <a href="/Boxing/Create?category=@category"
               class="btn btn-primary ms-auto" style="border-radius:10px; font-weight:500; padding:10px 18px;">
                <i class="fa-solid fa-user-plus me-1"></i> Add Member
            </a>
            <a href="/Boxing/Import?category=@category"
               class="btn btn-warning" style="border-radius:10px; font-weight:500; padding:10px 18px;">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </a>
        }
        <a href="/Boxing/ExportAll?category=@category"
           class="btn btn-success export-btn @(isAll ? "ms-auto" : "")">
            <i class="fa-solid fa-file-excel me-1"></i> Export
        </a>
    </div>
</form>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <a href="@BuildQuery(overridePayment: "")" class="text-decoration-none">
            <div class="card shadow-sm stats-card stats-all @(string.IsNullOrEmpty(ViewBag.PaymentStatus as string) ? "active" : "")">
                <div class="card-body text-center py-3">
                    <div class="stats-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="fs-2 fw-bold">@ViewBag.CountAll</div>
                    <div class="text-muted small">Total Members</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="@BuildQuery(overridePayment: "paid")" class="text-decoration-none">
            <div class="card shadow-sm stats-card stats-paid @(ViewBag.PaymentStatus == "paid" ? "active" : "")">
                <div class="card-body text-center py-3">
                    <div class="stats-icon">
                        <i class="fa-solid fa-check-circle"></i>
                    </div>
                    <div class="fs-2 fw-bold">@ViewBag.CountPaid</div>
                    <div class="text-muted small">Fully Paid</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="@BuildQuery(overridePayment: "due")" class="text-decoration-none">
            <div class="card shadow-sm stats-card stats-due @(ViewBag.PaymentStatus == "due" ? "active" : "")">
                <div class="card-body text-center py-3">
                    <div class="stats-icon">
                        <i class="fa-solid fa-exclamation-triangle"></i>
                    </div>
                    <div class="fs-2 fw-bold">@ViewBag.CountWithDue</div>
                    <div class="text-muted small">With Due</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar card shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Filter Icon & Label -->
            <div class="filter-label me-2">
                <i class="fa-solid fa-filter text-danger"></i>
                <span class="fw-semibold text-muted ms-1">Filters:</span>
            </div>
            
            <!-- Status Filter Buttons -->
            <div class="status-filter-group d-flex gap-2">
                <a class="status-pill status-all @(string.IsNullOrEmpty(ViewBag.PaymentStatus as string) ? "active" : "")"
                   href="@BuildQuery(overridePayment: "")">
                    <i class="fa-solid fa-users"></i>
                    <span>All</span>
                    <span class="pill-count">@ViewBag.CountAll</span>
                </a>
                <a class="status-pill status-active @(ViewBag.PaymentStatus == "paid" ? "active" : "")"
                   href="@BuildQuery(overridePayment: "paid")">
                    <i class="fa-solid fa-check-circle"></i>
                    <span>Paid</span>
                </a>
                <a class="status-pill status-expired @(ViewBag.PaymentStatus == "due" ? "active" : "")"
                   href="@BuildQuery(overridePayment: "due")">
                    <i class="fa-solid fa-exclamation-triangle"></i>
                    <span>With Due</span>
                </a>
            </div>
            
            <!-- Clear Filters Button -->
            @if (hasActiveFilters)
            {
                <div class="ms-auto">
                    <a href="?category=@category&search=@ViewBag.Search" class="btn btn-clear-filters">
                        <i class="fa-solid fa-times me-1"></i>Clear
                    </a>
                </div>
            }
        </div>
        
        <!-- Active Filters Tags -->
        @if (hasActiveFilters)
        {
            <div class="active-filters-tags mt-3 pt-3 border-top">
                <span class="text-muted small me-2"><i class="fa-solid fa-tag me-1"></i>Active:</span>
        @if (!string.IsNullOrEmpty((string)ViewBag.PaymentStatus))
                {
                    <span class="filter-tag @(ViewBag.PaymentStatus == "due" ? "tag-due" : "tag-paid")">
                        <i class="fa-solid @(ViewBag.PaymentStatus == "due" ? "fa-exclamation-triangle" : "fa-check-circle") me-1"></i>@(ViewBag.PaymentStatus == "due" ? "With Due" : "Fully Paid")
                        <a href="@BuildQuery(overridePayment: "")" class="tag-close"><i class="fa-solid fa-times"></i></a>
                    </span>
                }
            </div>
        }
    </div>
</div>

<style>
    /* Page Title */
    .page-title {
        color: #1e293b;
        font-weight: 600;
        display: flex;
        align-items: center;
    }
    
    .page-title span {
        color: #334155;
    }

    /* Search Container Styles */
    .search-container {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 500px;
        width: 100%;
    }
    
    .search-icon {
        position: absolute;
        left: 16px;
        color: #94a3b8;
        font-size: 14px;
        z-index: 1;
    }
    
    .search-input {
        padding: 12px 120px 12px 44px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        transition: all 0.2s ease;
        background: #f8fafc;
        width: 100%;
    }
    
    .search-input:focus {
        border-color: #ef4444;
        background: white;
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
        outline: none;
    }
    
    .search-input::placeholder {
        color: #94a3b8;
    }
    
    .search-clear {
        position: absolute;
        right: 95px;
        background: #f1f5f9;
        border: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #64748b;
        font-size: 11px;
        transition: all 0.15s ease;
    }
    
    .search-clear:hover {
        background: #fee2e2;
        color: #dc2626;
    }
    
    .search-btn {
        position: absolute;
        right: 6px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        color: white;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    
    .search-btn:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }
    
    .search-btn:active {
        transform: translateY(0);
    }
    
    .export-btn {
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 500;
        font-size: 14px;
    }
    
    /* Stats Cards */
    .stats-card {
        border: 2px solid transparent;
        border-radius: 16px;
        transition: all 0.25s ease;
        overflow: hidden;
    }
    
    .stats-card .stats-icon {
        font-size: 1.5rem;
        margin-bottom: 8px;
        opacity: 0.8;
    }
    
    .stats-card.stats-all {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    }
    .stats-card.stats-all .stats-icon { color: #6366f1; }
    .stats-card.stats-all .fs-2 { color: #4338ca; }
    .stats-card.stats-all.active {
        border-color: #6366f1;
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
    }
    
    .stats-card.stats-paid {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    }
    .stats-card.stats-paid .stats-icon { color: #22c55e; }
    .stats-card.stats-paid .fs-2 { color: #16a34a; }
    .stats-card.stats-paid.active {
        border-color: #22c55e;
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    }
    
    .stats-card.stats-due {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
    }
    .stats-card.stats-due .stats-icon { color: #ef4444; }
    .stats-card.stats-due .fs-2 { color: #dc2626; }
    .stats-card.stats-due.active {
        border-color: #ef4444;
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    }
    
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    /* Filter Bar Styles */
    .filter-bar {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border: none;
        border-radius: 16px;
    }
    
    .filter-label {
        display: flex;
        align-items: center;
    }
    
    /* Status Filter Pills */
    .status-filter-group {
        display: flex;
        flex-wrap: wrap;
    }
    
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 25px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 2px solid transparent;
    }
    
    .status-pill i {
        font-size: 0.9rem;
    }
    
    .status-pill .pill-count {
        background: rgba(255,255,255,0.3);
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    /* All - Blue/Indigo */
    .status-pill.status-all {
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
        color: #4338ca;
    }
    .status-pill.status-all:hover {
        background: linear-gradient(135deg, #c7d2fe 0%, #a5b4fc 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    .status-pill.status-all.active {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }
    .status-pill.status-all.active .pill-count {
        background: rgba(255,255,255,0.25);
    }
    
    /* Paid - Green */
    .status-pill.status-active {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        color: #047857;
    }
    .status-pill.status-active:hover {
        background: linear-gradient(135deg, #a7f3d0 0%, #6ee7b7 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }
    .status-pill.status-active.active {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }
    
    /* Due - Red */
    .status-pill.status-expired {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #b91c1c;
    }
    .status-pill.status-expired:hover {
        background: linear-gradient(135deg, #fecaca 0%, #fca5a5 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }
    .status-pill.status-expired.active {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
    }
    
    /* Clear Button */
    .btn-clear-filters {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 1px solid #fca5a5;
        border-radius: 10px;
        font-size: 0.85rem;
        padding: 0.45rem 0.85rem;
        color: #dc2626;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .btn-clear-filters:hover {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border-color: #f87171;
        color: #b91c1c;
        transform: translateY(-1px);
    }
    
    /* Filter Tags */
    .filter-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.6rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        margin-right: 0.5rem;
        margin-bottom: 0.25rem;
    }
    
    .filter-tag .tag-close {
        margin-left: 0.4rem;
        opacity: 0.7;
        text-decoration: none;
    }
    .filter-tag .tag-close:hover {
        opacity: 1;
    }
    
    .tag-paid {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        color: #166534;
    }
    .tag-paid .tag-close { color: #166534; }
    
    .tag-due {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #991b1b;
    }
    .tag-due .tag-close { color: #991b1b; }
    
    /* Table Styles */
    .price-cell {
        font-weight: 600;
        white-space: nowrap;
    }
    .price-cell.cash { color: #2563eb; }
    .price-cell.esewa { color: #65a30d; }
    
    .due-cell {
        font-weight: 600;
        white-space: nowrap;
    }
    .due-cell.has-due { color: #dc2626; }
    .due-cell.no-due { color: #16a34a; }
    
    /* Responsive */
    @@media (max-width: 576px) {
        .search-container {
            max-width: 100%;
        }
        .search-btn span {
            display: none;
        }
        .search-btn {
            padding: 8px 12px;
        }
        .search-input {
            padding-right: 100px;
        }
        .search-clear {
            right: 55px;
        }
    }
</style>

<div class="card shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>S.No</th>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Joined</th>
                    <th>Guardian</th>
                    <th>Contact</th>
                    <th>Classes/Month</th>
                    <th>Cash</th>
                    <th>eSewa</th>
                    <th>Due</th>
                    <th>Remarks</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@(sn++)</td>
                        <td>
                            @if (b.Photo != null)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(b.Photo)"
                                     class="rounded-circle"
                                     style="width:40px;height:40px;object-fit:cover;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-child fa-2x text-secondary"></i>
                            }
                        </td>
                        <td class="fw-semibold">@b.Name</td>
                        <td>
                            @if (b.JoinDate != null)
                            {
                                @b.JoinDate.Value.ToString("dd MMM yy")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>@b.GuardianName</td>
                        <td>
                            <a href="tel:@b.GuardianContact" class="text-decoration-none">
                                <i class="fa-solid fa-phone me-1 text-muted small"></i>@b.GuardianContact
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">
                                <i class="fa-solid fa-calendar-days me-1"></i>@b.PerMonthClass
                            </span>
                        </td>
                        <td class="price-cell cash">
                            @if (b.CashAmount > 0)
                            {
                                <span>Rs. @b.CashAmount.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="price-cell esewa">
                            @if (b.EsewaAmount > 0)
                            {
                                <span>Rs. @b.EsewaAmount.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="due-cell @(b.DueAmount > 0 ? "has-due" : "no-due")">
                            @if (b.DueAmount > 0)
                            {
                                <span>Rs. @b.DueAmount.ToString("N0")</span>
                                <i class="fa-solid fa-exclamation-circle ms-1" title="Payment pending"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-check-circle" title="Fully paid"></i>
                            }
                        </td>
                        <td title="@b.Remarks">
                            @(string.IsNullOrWhiteSpace(b.Remarks)
                                ? "-"
                                : (b.Remarks.Length > 15
                                ? b.Remarks.Substring(0, 12) + "..."
                                : b.Remarks))
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" href="/Boxing/Details/@b.BoxingMemberID" title="View">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a class="btn btn-outline-secondary" href="/Boxing/Edit/@b.BoxingMemberID" title="Edit">
                                    <i class="fa-solid fa-edit"></i>
                                </a>
                                <button class="btn btn-outline-danger" data-bs-toggle="modal" 
                                        data-bs-target="#delBoxing_@b.BoxingMemberID" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>

                            <div class="modal fade" id="delBoxing_@b.BoxingMemberID" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5>Confirm Delete</h5>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete <b>@b.Name</b>?
                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <form method="post" action="/Boxing/Delete/@b.BoxingMemberID" style="display:inline;">
                                                <button class="btn btn-danger">Yes, Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <nav class="mt-3">
            @{
                int current = ViewBag.Page;
                int total = ViewBag.TotalPages;
                int start = Math.Max(1, current - 2);
                int end = Math.Min(total, current + 2);
            }

            <ul class="pagination justify-content-center">
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="@BuildQuery(overridePage: current - 1)">Prev</a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(overridePage: 1)">1</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link" href="@BuildQuery(overridePage: i)">@i</a>
                    </li>
                }

                @if (end < total)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                    <li class="page-item">
                        <a class="page-link" href="@BuildQuery(overridePage: total)">@total</a>
                    </li>
                }

                <li class="page-item @(current == total ? "disabled" : "")">
                    <a class="page-link" href="@BuildQuery(overridePage: current + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    // Clear search button functionality
    const clearBtn = document.getElementById('clearSearch');
    const searchInput = document.getElementById('searchInput');
    const searchForm = document.getElementById('searchForm');
    
    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            const url = new URL(window.location.href);
            url.searchParams.delete('search');
            url.searchParams.set('page', '1');
            if (!url.searchParams.has('category')) {
                url.searchParams.set('category', '@category');
            }
            window.location.href = url.toString();
        });
    }
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            let existingClear = document.getElementById('clearSearch');
            if (this.value.trim() !== '' && !existingClear) {
                const clearButton = document.createElement('button');
                clearButton.type = 'button';
                clearButton.className = 'search-clear';
                clearButton.id = 'clearSearch';
                clearButton.title = 'Clear search';
                clearButton.innerHTML = '<i class="fa-solid fa-times"></i>';
                clearButton.addEventListener('click', function() {
                    searchInput.value = '';
                    this.remove();
                    searchInput.focus();
                });
                searchInput.parentNode.insertBefore(clearButton, searchInput.nextSibling.nextSibling);
            } else if (this.value.trim() === '' && existingClear) {
                existingClear.remove();
            }
        });
        
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                searchForm.submit();
            }
        });
    }
</script>

