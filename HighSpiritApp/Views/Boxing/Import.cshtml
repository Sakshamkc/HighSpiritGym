@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string category = ViewBag.Category ?? "Children";
    bool isAdult = category == "Adult";

    var returnUrlRaw = Context.Request.Query["returnUrl"].FirstOrDefault();
    var backUrl = !string.IsNullOrEmpty(returnUrlRaw) ? Uri.UnescapeDataString(returnUrlRaw) : $"/Boxing?category={category}";
}

<h4 class="mb-3"><i class="fa-solid fa-file-import me-2 text-danger"></i> Import @(isAdult ? "Adult" : "Children") Boxing Members (Excel)</h4>

<form asp-action="Import"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" name="category" value="@category" />

    <div class="mb-3">
        <label class="form-label">Select Excel File</label>
        <input type="file"
               name="file"
               class="form-control"
               accept=".xlsx"
               required />
    </div>

    <button class="btn btn-success">
        <i class="fa-solid fa-file-import me-1"></i> Import
    </button>
    <a href="@backUrl" class="btn btn-secondary">Cancel</a>

</form>


<div class="mt-3 text-muted" style="font-size:13px;">
    Excel headers must be exactly:
    Name, JoinDate, GuardianName, GuardianContact, PerMonthClass, Cash, Esewa, Due, Remarks
</div>
