@using HighSpiritApp.Services.Interfaces
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var report = ViewBag.RevenueReport as RevenueReport;
    var monthlyData = ViewBag.MonthlyData as MonthlyRevenueData;
    var transactions = ViewBag.RecentTransactions as List<RecentTransaction>;
    var categoryWise = ViewBag.CategoryWise as CategoryWiseRevenue;
    var selectedYear = (int)ViewBag.SelectedYear;
    var availableYears = ViewBag.AvailableYears as List<int>;
}

<style>
    .report-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 20px;
        padding: 25px 30px;
        color: white;
        margin-bottom: 25px;
    }
    .report-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .report-header h4 i {
        font-size: 24px;
        color: #60a5fa;
    }

    /* Stats Cards */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        position: relative;
        overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }
    .stat-card.total::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .stat-card.gym::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .stat-card.boxing::before { background: linear-gradient(90deg, #ef4444, #f87171); }
    .stat-card.locker::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
    .stat-card.due::before { background: linear-gradient(90deg, #dc2626, #ef4444); }
    .stat-card.growth::before { background: linear-gradient(90deg, #10b981, #34d399); }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 15px;
    }
    .stat-card.total .stat-icon { background: #eff6ff; color: #3b82f6; }
    .stat-card.gym .stat-icon { background: #fef3c7; color: #f59e0b; }
    .stat-card.boxing .stat-icon { background: #fee2e2; color: #ef4444; }
    .stat-card.locker .stat-icon { background: #f3e8ff; color: #8b5cf6; }
    .stat-card.due .stat-icon { background: #fee2e2; color: #dc2626; }
    .stat-card.growth .stat-icon { background: #d1fae5; color: #10b981; }

    .stat-label {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 5px;
    }
    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
    }
    .stat-sub {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 5px;
    }
    .stat-sub.positive { color: #10b981; }
    .stat-sub.negative { color: #ef4444; }

    /* Charts Section */
    .chart-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }
    .chart-header {
        padding: 20px 25px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .chart-header h5 {
        margin: 0;
        font-weight: 600;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chart-header h5 i {
        color: #3b82f6;
    }
    .chart-body {
        padding: 25px;
    }

    /* Category Cards */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    .category-card {
        text-align: center;
        padding: 25px;
        border-radius: 16px;
        position: relative;
    }
    .category-card.gym { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); }
    .category-card.boxing { background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); }
    .category-card.locker { background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%); }
    .category-percentage {
        font-size: 42px;
        font-weight: 700;
    }
    .category-card.gym .category-percentage { color: #d97706; }
    .category-card.boxing .category-percentage { color: #dc2626; }
    .category-card.locker .category-percentage { color: #7c3aed; }
    .category-amount {
        font-size: 18px;
        font-weight: 600;
        margin-top: 5px;
    }
    .category-label {
        font-size: 14px;
        color: #64748b;
        margin-top: 8px;
    }

    /* Transaction Table */
    .transaction-table {
        width: 100%;
    }
    .transaction-table th {
        background: #f8fafc;
        padding: 12px 16px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    .transaction-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .transaction-table tbody tr:hover {
        background: #f8fafc;
    }
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .type-badge.gym { background: #fef3c7; color: #92400e; }
    .type-badge.boxing { background: #fee2e2; color: #991b1b; }
    .type-badge.locker { background: #f3e8ff; color: #6b21a8; }

    .status-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }
    .status-badge.paid { background: #dcfce7; color: #166534; }
    .status-badge.partial { background: #fef3c7; color: #92400e; }
    .status-badge.due { background: #fee2e2; color: #991b1b; }

    .amount-cell {
        font-weight: 600;
        color: #059669;
    }

    /* Year Selector */
    .year-selector {
        display: flex;
        gap: 8px;
    }
    .year-btn {
        padding: 6px 16px;
        border-radius: 8px;
        border: 2px solid #e2e8f0;
        background: white;
        font-weight: 600;
        font-size: 13px;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .year-btn:hover {
        border-color: #3b82f6;
        color: #3b82f6;
    }
    .year-btn.active {
        background: #3b82f6;
        border-color: #3b82f6;
        color: white;
    }

    /* Bar Chart Styles */
    .bar-chart {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 250px;
        padding: 20px 0;
    }
    .bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .bar-stack {
        width: 40px;
        display: flex;
        flex-direction: column-reverse;
        border-radius: 6px 6px 0 0;
        overflow: hidden;
    }
    .bar-segment {
        width: 100%;
        transition: height 0.5s ease;
    }
    .bar-segment.gym { background: linear-gradient(180deg, #fbbf24, #f59e0b); }
    .bar-segment.boxing { background: linear-gradient(180deg, #f87171, #ef4444); }
    .bar-segment.locker { background: linear-gradient(180deg, #a78bfa, #8b5cf6); }
    .bar-label {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
    }
    .bar-value {
        font-size: 10px;
        color: #94a3b8;
    }

    @@media (max-width: 992px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .category-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 576px) {
        .stats-row { grid-template-columns: 1fr; }
    }
</style>

<!-- Header -->
<div class="report-header">
    <div class="d-flex justify-content-between align-items-center">
        <h4>
            <i class="fa-solid fa-chart-line"></i>
            Revenue Report
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print
            </button>
        </div>
    </div>
</div>

<!-- Main Stats -->
<div class="stats-row">
    <div class="stat-card total">
        <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">Rs. @(report?.TotalRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">All time collected</div>
    </div>
    <div class="stat-card gym">
        <div class="stat-icon"><i class="fa-solid fa-dumbbell"></i></div>
        <div class="stat-label">Gym Revenue</div>
        <div class="stat-value">Rs. @(report?.GymRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TotalGymMembers ?? 0) members</div>
    </div>
    <div class="stat-card boxing">
        <div class="stat-icon"><i class="fa-solid fa-hand-fist"></i></div>
        <div class="stat-label">Boxing Revenue</div>
        <div class="stat-value">Rs. @(report?.BoxingRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TotalBoxingMembers ?? 0) members</div>
    </div>
    <div class="stat-card locker">
        <div class="stat-icon"><i class="fa-solid fa-lock"></i></div>
        <div class="stat-label">Locker Revenue</div>
        <div class="stat-value">Rs. @(report?.LockerRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.ActiveLockers ?? 0) / @(report?.TotalLockers ?? 0) active</div>
    </div>
</div>

<!-- Secondary Stats -->
<div class="stats-row">
    <div class="stat-card due">
        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-label">Total Due Amount</div>
        <div class="stat-value">Rs. @(report?.TotalDue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">Pending collection</div>
    </div>
    <div class="stat-card growth">
        <div class="stat-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
        <div class="stat-label">This Month</div>
        <div class="stat-value">Rs. @(report?.ThisMonthRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub @(report?.RevenueGrowth >= 0 ? "positive" : "negative")">
            <i class="fa-solid @(report?.RevenueGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
            @(Math.Abs(report?.RevenueGrowth ?? 0).ToString("F1"))% vs last month
        </div>
    </div>
    <div class="stat-card total">
        <div class="stat-icon"><i class="fa-solid fa-calendar-day"></i></div>
        <div class="stat-label">Today's Revenue</div>
        <div class="stat-value">Rs. @(report?.TodayRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TodayTransactions ?? 0) transactions</div>
    </div>
    <div class="stat-card gym">
        <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
        <div class="stat-label">Last Month</div>
        <div class="stat-value">Rs. @(report?.LastMonthRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">Previous month total</div>
    </div>
</div>

<div class="row">
    <!-- Monthly Chart -->
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="fa-solid fa-chart-bar"></i> Monthly Revenue</h5>
                <div class="year-selector">
                    @foreach (var yr in availableYears ?? new List<int>())
                    {
                        <button class="year-btn @(yr == selectedYear ? "active" : "")" 
                                onclick="window.location.href='/Report?year=@yr'">
                            @yr
                        </button>
                    }
                </div>
            </div>
            <div class="chart-body">
                <div class="bar-chart" id="monthlyChart">
                    @if (monthlyData?.Months != null)
                    {
                        var maxValue = monthlyData.Months.Max(m => m.Total);
                        maxValue = maxValue > 0 ? maxValue : 1;

                        foreach (var month in monthlyData.Months)
                        {
                            var totalHeight = (month.Total / maxValue) * 200;
                            var gymHeight = maxValue > 0 ? (month.GymRevenue / maxValue) * 200 : 0;
                            var boxingHeight = maxValue > 0 ? (month.BoxingRevenue / maxValue) * 200 : 0;
                            var lockerHeight = maxValue > 0 ? (month.LockerRevenue / maxValue) * 200 : 0;
                            
                            <div class="bar-group">
                                <div class="bar-value">@(month.Total > 0 ? $"Rs.{(month.Total/1000):F0}K" : "")</div>
                                <div class="bar-stack" style="height: @(totalHeight)px;">
                                    <div class="bar-segment gym" style="height: @(gymHeight)px;" title="Gym: Rs. @month.GymRevenue.ToString("N0")"></div>
                                    <div class="bar-segment boxing" style="height: @(boxingHeight)px;" title="Boxing: Rs. @month.BoxingRevenue.ToString("N0")"></div>
                                    <div class="bar-segment locker" style="height: @(lockerHeight)px;" title="Locker: Rs. @month.LockerRevenue.ToString("N0")"></div>
                                </div>
                                <div class="bar-label">@month.MonthName</div>
                            </div>
                        }
                    }
                </div>
                <div class="d-flex justify-content-center gap-4 mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #fbbf24, #f59e0b); border-radius: 4px;"></div>
                        <span class="small text-muted">Gym</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #f87171, #ef4444); border-radius: 4px;"></div>
                        <span class="small text-muted">Boxing</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #a78bfa, #8b5cf6); border-radius: 4px;"></div>
                        <span class="small text-muted">Locker</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Distribution -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="fa-solid fa-pie-chart"></i> Revenue Distribution</h5>
            </div>
            <div class="chart-body">
                <div class="category-grid" style="grid-template-columns: 1fr;">
                    <div class="category-card gym">
                        <div class="category-percentage">@(categoryWise?.GymPercentage.ToString("F1") ?? "0")%</div>
                        <div class="category-amount">Rs. @(categoryWise?.GymAmount.ToString("N0") ?? "0")</div>
                        <div class="category-label"><i class="fa-solid fa-dumbbell me-1"></i> Gym Memberships</div>
                    </div>
                    <div class="category-card boxing">
                        <div class="category-percentage">@(categoryWise?.BoxingPercentage.ToString("F1") ?? "0")%</div>
                        <div class="category-amount">Rs. @(categoryWise?.BoxingAmount.ToString("N0") ?? "0")</div>
                        <div class="category-label"><i class="fa-solid fa-hand-fist me-1"></i> Boxing Classes</div>
                    </div>
                    <div class="category-card locker">
                        <div class="category-percentage">@(categoryWise?.LockerPercentage.ToString("F1") ?? "0")%</div>
                        <div class="category-amount">Rs. @(categoryWise?.LockerAmount.ToString("N0") ?? "0")</div>
                        <div class="category-label"><i class="fa-solid fa-lock me-1"></i> Locker Rentals</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions -->
<div class="chart-card">
    <div class="chart-header">
        <h5><i class="fa-solid fa-clock-rotate-left"></i> Recent Transactions</h5>
    </div>
    <div class="chart-body p-0">
        <div class="table-responsive">
            <table class="transaction-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Member</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (transactions != null && transactions.Any())
                    {
                        foreach (var t in transactions)
                        {
                            <tr>
                                <td>
                                    <span class="type-badge @t.Type.ToLower()">
                                        <i class="fa-solid @(t.Type == "Gym" ? "fa-dumbbell" : t.Type == "Boxing" ? "fa-hand-fist" : "fa-lock")"></i>
                                        @t.Type
                                    </span>
                                </td>
                                <td><strong>@t.MemberName</strong></td>
                                <td class="text-muted">@t.Description</td>
                                <td class="amount-cell">Rs. @t.Amount.ToString("N0")</td>
                                <td class="text-muted">@t.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="status-badge @t.Status.ToLower()">
                                        @t.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No transactions found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
