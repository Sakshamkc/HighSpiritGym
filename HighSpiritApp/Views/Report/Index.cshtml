@using HighSpiritApp.Services.Interfaces
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var report = ViewBag.RevenueReport as RevenueReport;
    var monthlyData = ViewBag.MonthlyData as MonthlyRevenueData;
    var categoryWise = ViewBag.CategoryWise as CategoryWiseRevenue;
    var selectedYear = (int)ViewBag.SelectedYear;
    var availableYears = ViewBag.AvailableYears as List<int>;
}

<style>
    .report-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 20px;
        padding: 25px 30px;
        color: white;
        margin-bottom: 25px;
    }
    .report-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .report-header h4 i {
        font-size: 24px;
        color: #60a5fa;
    }

    /* Stats Cards */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        position: relative;
        overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }
    .stat-card.total::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .stat-card.gym::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .stat-card.boxing::before { background: linear-gradient(90deg, #ef4444, #f87171); }
    .stat-card.locker::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
    .stat-card.due::before { background: linear-gradient(90deg, #dc2626, #ef4444); }
    .stat-card.growth::before { background: linear-gradient(90deg, #10b981, #34d399); }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 15px;
    }
    .stat-card.total .stat-icon { background: #eff6ff; color: #3b82f6; }
    .stat-card.gym .stat-icon { background: #fef3c7; color: #f59e0b; }
    .stat-card.boxing .stat-icon { background: #fee2e2; color: #ef4444; }
    .stat-card.locker .stat-icon { background: #f3e8ff; color: #8b5cf6; }
    .stat-card.due .stat-icon { background: #fee2e2; color: #dc2626; }
    .stat-card.growth .stat-icon { background: #d1fae5; color: #10b981; }

    .stat-label {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 5px;
    }
    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
    }
    .stat-sub {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 5px;
    }
    .stat-sub.positive { color: #10b981; }
    .stat-sub.negative { color: #ef4444; }

    /* Charts Section */
    .chart-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }
    .chart-header {
        padding: 20px 25px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .chart-header h5 {
        margin: 0;
        font-weight: 600;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chart-header h5 i {
        color: #3b82f6;
    }
    .chart-body {
        padding: 25px;
    }

    /* Year Selector */
    .year-selector {
        display: flex;
        gap: 8px;
    }
    .year-btn {
        padding: 6px 16px;
        border-radius: 8px;
        border: 2px solid #e2e8f0;
        background: white;
        font-weight: 600;
        font-size: 13px;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .year-btn:hover {
        border-color: #3b82f6;
        color: #3b82f6;
    }
    .year-btn.active {
        background: #3b82f6;
        border-color: #3b82f6;
        color: white;
    }

    /* Bar Chart Styles */
    .bar-chart {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 250px;
        padding: 20px 0;
    }
    .bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .bar-stack {
        width: 40px;
        display: flex;
        flex-direction: column-reverse;
        border-radius: 6px 6px 0 0;
        overflow: hidden;
    }
    .bar-segment {
        width: 100%;
        transition: height 0.5s ease;
    }
    .bar-segment.gym { background: linear-gradient(180deg, #fbbf24, #f59e0b); }
    .bar-segment.boxing { background: linear-gradient(180deg, #f87171, #ef4444); }
    .bar-segment.locker { background: linear-gradient(180deg, #a78bfa, #8b5cf6); }
    .bar-label {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
    }
    .bar-value {
        font-size: 10px;
        color: #94a3b8;
    }

    /* Pie Chart Container */
    .pie-chart-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 40px;
        padding: 20px;
    }
    .pie-chart-wrapper {
        position: relative;
        width: 280px;
        height: 280px;
    }
    .pie-chart-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }
    .pie-chart-center .total-label {
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .pie-chart-center .total-value {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
    }
    .pie-legend {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .pie-legend-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 12px;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .pie-legend-item:hover {
        background: #f8fafc;
    }
    .pie-legend-item .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }
    .pie-legend-item .legend-color.gym { background: linear-gradient(135deg, #fbbf24, #f59e0b); }
    .pie-legend-item .legend-color.boxing { background: linear-gradient(135deg, #f87171, #ef4444); }
    .pie-legend-item .legend-color.locker { background: linear-gradient(135deg, #a78bfa, #8b5cf6); }
    .pie-legend-item .legend-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
    .pie-legend-item .legend-icon.gym { background: #fef3c7; color: #d97706; }
    .pie-legend-item .legend-icon.boxing { background: #fee2e2; color: #dc2626; }
    .pie-legend-item .legend-icon.locker { background: #f3e8ff; color: #7c3aed; }
    .pie-legend-item .legend-info {
        flex: 1;
    }
    .pie-legend-item .legend-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 14px;
    }
    .pie-legend-item .legend-amount {
        font-size: 12px;
        color: #64748b;
    }
    .pie-legend-item .legend-percentage {
        font-size: 18px;
        font-weight: 700;
    }
    .pie-legend-item .legend-percentage.gym { color: #d97706; }
    .pie-legend-item .legend-percentage.boxing { color: #dc2626; }
    .pie-legend-item .legend-percentage.locker { color: #7c3aed; }

    /* Due Summary Cards */
    .due-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    .due-card {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
    }
    .due-card.gym {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fde68a;
    }
    .due-card.boxing {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fecaca;
    }
    .due-card.locker {
        background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
        border-color: #e9d5ff;
    }
    .due-card .due-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin: 0 auto 12px;
    }
    .due-card.gym .due-icon { background: #fef3c7; color: #d97706; }
    .due-card.boxing .due-icon { background: #fee2e2; color: #dc2626; }
    .due-card.locker .due-icon { background: #f3e8ff; color: #7c3aed; }
    .due-card .due-label {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 5px;
    }
    .due-card .due-value {
        font-size: 24px;
        font-weight: 700;
    }
    .due-card.gym .due-value { color: #92400e; }
    .due-card.boxing .due-value { color: #991b1b; }
    .due-card.locker .due-value { color: #6b21a8; }

    @@media (max-width: 992px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .pie-chart-container { flex-direction: column; }
        .due-summary-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 576px) {
        .stats-row { grid-template-columns: 1fr; }
    }
</style>

<!-- Header -->
<div class="report-header">
    <div class="d-flex justify-content-between align-items-center">
        <h4>
            <i class="fa-solid fa-chart-line"></i>
            Revenue Report
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print
            </button>
        </div>
    </div>
</div>

<!-- Main Stats -->
<div class="stats-row">
    <div class="stat-card total">
        <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">Rs. @(report?.TotalRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">All time collected</div>
    </div>
    <div class="stat-card gym">
        <div class="stat-icon"><i class="fa-solid fa-dumbbell"></i></div>
        <div class="stat-label">Gym Revenue</div>
        <div class="stat-value">Rs. @(report?.GymRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TotalGymMembers ?? 0) members</div>
    </div>
    <div class="stat-card boxing">
        <div class="stat-icon"><i class="fa-solid fa-hand-fist"></i></div>
        <div class="stat-label">Boxing Revenue</div>
        <div class="stat-value">Rs. @(report?.BoxingRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TotalBoxingMembers ?? 0) members</div>
    </div>
    <div class="stat-card locker">
        <div class="stat-icon"><i class="fa-solid fa-lock"></i></div>
        <div class="stat-label">Locker Revenue</div>
        <div class="stat-value">Rs. @(report?.LockerRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.ActiveLockers ?? 0) / @(report?.TotalLockers ?? 0) active</div>
    </div>
</div>

<!-- Secondary Stats -->
<div class="stats-row">
    <div class="stat-card due">
        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-label">Total Due Amount</div>
        <div class="stat-value">Rs. @(report?.TotalDue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">Pending collection</div>
    </div>
    <div class="stat-card growth">
        <div class="stat-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
        <div class="stat-label">This Month</div>
        <div class="stat-value">Rs. @(report?.ThisMonthRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub @(report?.RevenueGrowth >= 0 ? "positive" : "negative")">
            <i class="fa-solid @(report?.RevenueGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i>
            @(Math.Abs(report?.RevenueGrowth ?? 0).ToString("F1"))% vs last month
        </div>
    </div>
    <div class="stat-card total">
        <div class="stat-icon"><i class="fa-solid fa-calendar-day"></i></div>
        <div class="stat-label">Today's Revenue</div>
        <div class="stat-value">Rs. @(report?.TodayRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">@(report?.TodayTransactions ?? 0) transactions</div>
    </div>
    <div class="stat-card gym">
        <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
        <div class="stat-label">Last Month</div>
        <div class="stat-value">Rs. @(report?.LastMonthRevenue.ToString("N0") ?? "0")</div>
        <div class="stat-sub">Previous month total</div>
    </div>
</div>

<div class="row">
    <!-- Monthly Chart -->
    <div class="col-lg-7">
        <div class="chart-card">
            <div class="chart-header">
                <h5><i class="fa-solid fa-chart-bar"></i> Monthly Revenue (@selectedYear)</h5>
                <div class="year-selector">
                    @foreach (var yr in availableYears ?? new List<int>())
                    {
                        <button class="year-btn @(yr == selectedYear ? "active" : "")" 
                                onclick="window.location.href='/Report?year=@yr'">
                            @yr
                        </button>
                    }
                </div>
            </div>
            <div class="chart-body">
                <div class="bar-chart" id="monthlyChart">
                    @if (monthlyData?.Months != null)
                    {
                        var maxValue = monthlyData.Months.Max(m => m.Total);
                        maxValue = maxValue > 0 ? maxValue : 1;

                        foreach (var month in monthlyData.Months)
                        {
                            var totalHeight = (month.Total / maxValue) * 200;
                            var gymHeight = maxValue > 0 ? (month.GymRevenue / maxValue) * 200 : 0;
                            var boxingHeight = maxValue > 0 ? (month.BoxingRevenue / maxValue) * 200 : 0;
                            var lockerHeight = maxValue > 0 ? (month.LockerRevenue / maxValue) * 200 : 0;
                            
                            <div class="bar-group">
                                <div class="bar-value">@(month.Total > 0 ? $"Rs.{(month.Total/1000):F0}K" : "")</div>
                                <div class="bar-stack" style="height: @(totalHeight)px;">
                                    <div class="bar-segment gym" style="height: @(gymHeight)px;" title="Gym: Rs. @month.GymRevenue.ToString("N0")"></div>
                                    <div class="bar-segment boxing" style="height: @(boxingHeight)px;" title="Boxing: Rs. @month.BoxingRevenue.ToString("N0")"></div>
                                    <div class="bar-segment locker" style="height: @(lockerHeight)px;" title="Locker: Rs. @month.LockerRevenue.ToString("N0")"></div>
                                </div>
                                <div class="bar-label">@month.MonthName</div>
                            </div>
                        }
                    }
                </div>
                <div class="d-flex justify-content-center gap-4 mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #fbbf24, #f59e0b); border-radius: 4px;"></div>
                        <span class="small text-muted">Gym</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #f87171, #ef4444); border-radius: 4px;"></div>
                        <span class="small text-muted">Boxing</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 16px; height: 16px; background: linear-gradient(180deg, #a78bfa, #8b5cf6); border-radius: 4px;"></div>
                        <span class="small text-muted">Locker</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pie Chart - Revenue Distribution -->
    <div class="col-lg-5">
        <div class="chart-card" style="height: 100%;">
            <div class="chart-header">
                <h5><i class="fa-solid fa-chart-pie"></i> Revenue Distribution</h5>
            </div>
            <div class="chart-body">
                <div class="pie-chart-container">
                    <div class="pie-chart-wrapper">
                        <canvas id="revenuePieChart"></canvas>
                        <div class="pie-chart-center">
                            <div class="total-label">Total</div>
                            <div class="total-value">Rs. @((categoryWise?.Total ?? 0).ToString("N0"))</div>
                        </div>
                    </div>
                </div>
                <div class="pie-legend mt-4">
                    <div class="pie-legend-item">
                        <div class="legend-icon gym"><i class="fa-solid fa-dumbbell"></i></div>
                        <div class="legend-info">
                            <div class="legend-name">Gym Memberships</div>
                            <div class="legend-amount">Rs. @((categoryWise?.GymAmount ?? 0).ToString("N0"))</div>
                        </div>
                        <div class="legend-percentage gym">@((categoryWise?.GymPercentage ?? 0).ToString("F1"))%</div>
                    </div>
                    <div class="pie-legend-item">
                        <div class="legend-icon boxing"><i class="fa-solid fa-hand-fist"></i></div>
                        <div class="legend-info">
                            <div class="legend-name">Boxing Classes</div>
                            <div class="legend-amount">Rs. @((categoryWise?.BoxingAmount ?? 0).ToString("N0"))</div>
                        </div>
                        <div class="legend-percentage boxing">@((categoryWise?.BoxingPercentage ?? 0).ToString("F1"))%</div>
                    </div>
                    <div class="pie-legend-item">
                        <div class="legend-icon locker"><i class="fa-solid fa-lock"></i></div>
                        <div class="legend-info">
                            <div class="legend-name">Locker Rentals</div>
                            <div class="legend-amount">Rs. @((categoryWise?.LockerAmount ?? 0).ToString("N0"))</div>
                        </div>
                        <div class="legend-percentage locker">@((categoryWise?.LockerPercentage ?? 0).ToString("F1"))%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Due Amount Summary -->
<div class="chart-card">
    <div class="chart-header">
        <h5><i class="fa-solid fa-exclamation-triangle text-warning"></i> Pending Due Summary</h5>
    </div>
    <div class="chart-body">
        <div class="due-summary-grid">
            <div class="due-card gym">
                <div class="due-icon"><i class="fa-solid fa-dumbbell"></i></div>
                <div class="due-label">Gym Membership Due</div>
                <div class="due-value">Rs. @((report?.GymDue ?? 0).ToString("N0"))</div>
            </div>
            <div class="due-card boxing">
                <div class="due-icon"><i class="fa-solid fa-hand-fist"></i></div>
                <div class="due-label">Boxing Class Due</div>
                <div class="due-value">Rs. @((report?.BoxingDue ?? 0).ToString("N0"))</div>
            </div>
            <div class="due-card locker">
                <div class="due-icon"><i class="fa-solid fa-lock"></i></div>
                <div class="due-label">Locker Rental Due</div>
                <div class="due-value">Rs. @((report?.LockerDue ?? 0).ToString("N0"))</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Pie Chart
        const ctx = document.getElementById('revenuePieChart').getContext('2d');
        
        const gymAmount = @(categoryWise?.GymAmount ?? 0);
        const boxingAmount = @(categoryWise?.BoxingAmount ?? 0);
        const lockerAmount = @(categoryWise?.LockerAmount ?? 0);
        
        // Check if there's any data
        const hasData = gymAmount > 0 || boxingAmount > 0 || lockerAmount > 0;
        
        const pieChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Gym', 'Boxing', 'Locker'],
                datasets: [{
                    data: hasData ? [gymAmount, boxingAmount, lockerAmount] : [1, 1, 1],
                    backgroundColor: [
                        '#f59e0b',  // Gym - Amber
                        '#ef4444',  // Boxing - Red
                        '#8b5cf6'   // Locker - Purple
                    ],
                    borderColor: [
                        '#fbbf24',
                        '#f87171',
                        '#a78bfa'
                    ],
                    borderWidth: 2,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                cutout: '65%',
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        enabled: hasData,
                        backgroundColor: '#1e293b',
                        titleFont: {
                            size: 14,
                            weight: '600'
                        },
                        bodyFont: {
                            size: 13
                        },
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return `Rs. ${value.toLocaleString()} (${percentage}%)`;
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    animateScale: true
                }
            }
        });
    </script>
}
