@model HighSpiritApp.Models.CustomerMembership
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lastExpireDate = ViewBag.LastExpireDate as DateTime?;
}

<div class="card shadow">
    <div class="card-body">
        <h4>Renew Membership</h4>
        
        @if (ViewBag.CustomerName != null)
        {
            <p class="text-muted mb-3">
                <i class="fa-solid fa-user"></i> <strong>@ViewBag.CustomerName</strong>
                @if (lastExpireDate.HasValue)
                {
                    <span class="ms-3">
                        <i class="fa-solid fa-calendar-xmark"></i> 
                        Last Expire: <strong>@lastExpireDate.Value.ToString("dd MMM yyyy")</strong>
                    </span>
                }
            </p>
        }

        <form method="post" class="row g-3">

            <input type="hidden" asp-for="CustomerID" />

            <div class="col-md-6">
                <label>Plan Name</label>
                <input asp-for="PlanName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label>Paid Price</label>
                <input asp-for="PaidPrice" class="form-control" />
            </div>

            <div class="col-md-6">
                <label>Duration (Months)</label>
                <input asp-for="Duration" class="form-control" />
            </div>

            <div class="col-md-6">
                <label>Start Date</label>
                <input asp-for="StartDate"
                       type="date"
                       class="form-control" />
                @if (lastExpireDate.HasValue && lastExpireDate.Value >= DateTime.Today)
                {
                    <small class="text-success">
                        <i class="fa-solid fa-info-circle"></i> 
                        Suggested: Day after last expire (@lastExpireDate.Value.AddDays(1).ToString("dd MMM yyyy"))
                    </small>
                }
            </div>

            <div class="col-md-6">
                <label>Expire Date <span class="text-muted">(Optional)</span></label>
                <input name="ExpireDate"
                       type="date"
                       class="form-control"
                       value="" />
                <small class="text-muted">
                    <i class="fa-solid fa-calculator"></i> Leave empty to auto-calculate from Start Date + Duration
                </small>
            </div>

            <div class="col-12">
                <button class="btn btn-success">
                    <i class="fa-solid fa-rotate"></i> Renew Membership
                </button>
                <a href="/Customers" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>
