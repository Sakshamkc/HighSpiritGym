@model List<CustomerMembership>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Dashboard Header with Quick Actions -->
<div class="dashboard-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <div class="dashboard-icon me-3">
            <i class="fa-solid fa-chart-pie"></i>
        </div>
        <div>
            <h3 class="mb-0">Dashboard</h3>
            <small class="text-muted">Welcome back! Here's your gym overview</small>
        </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="quick-actions d-flex gap-2 flex-wrap mt-3 mt-md-0">
        <a href="/Customers/Create" class="btn btn-quick-action btn-gym">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add Gym Member</span>
        </a>
        <a href="/Boxing/Create" class="btn btn-quick-action btn-boxing">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add Boxing Member</span>
        </a>
        <a href="/Locker" class="btn btn-quick-action btn-locker">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add Locker</span>
        </a>
    </div>
</div>

<style>
    /* Dashboard Header */
    .dashboard-header {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 20px 24px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .dashboard-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    /* Quick Action Buttons */
    .btn-quick-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        border: none;
        transition: all 0.25s ease;
        color: white;
    }

    .btn-quick-action:hover {
        transform: translateY(-3px);
        color: white;
    }

    .btn-quick-action i {
        font-size: 16px;
    }

    .btn-gym {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .btn-gym:hover {
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
    }

    .btn-boxing {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .btn-boxing:hover {
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }

    .btn-locker {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    }

    .btn-locker:hover {
        box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
    }

    /* Responsive - Dashboard Header */
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            text-align: center;
            padding: 16px;
            gap: 16px;
        }

        .dashboard-header>.d-flex:first-child {
            flex-direction: column;
            align-items: center;
        }

        .dashboard-header .dashboard-icon {
            margin-right: 0 !important;
            margin-bottom: 12px;
        }

        .quick-actions {
            width: 100%;
            justify-content: center;
        }

        .btn-quick-action {
            flex: 1;
            justify-content: center;
            padding: 10px 14px;
            font-size: 13px;
        }
    }

    @@media (max-width: 576px) {
        .dashboard-header {
            padding: 14px;
        }

        .dashboard-header h3 {
            font-size: 1.25rem;
        }

        .dashboard-icon {
            width: 44px;
            height: 44px;
            font-size: 20px;
        }

        .quick-actions {
            flex-direction: column;
            width: 100%;
        }

        .btn-quick-action {
            width: 100%;
            padding: 12px 16px;
        }
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .section-icon.gym {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
    }

    .section-icon.locker {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
    }

    .section-icon.boxing {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .stat-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
    }

    .stat-card .card-body {
        padding: 20px;
    }

    .stat-card .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        background: rgba(255, 255, 255, 0.2);
        margin-bottom: 15px;
    }

    .stat-card h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-card p {
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .data-table {
        border-radius: 12px;
        overflow: hidden;
    }

    .data-table .table {
        margin-bottom: 0;
    }

    .table-header-icon {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .divider {
        border: none;
        height: 2px;
        background: linear-gradient(to right, transparent, #e5e7eb, transparent);
        margin: 40px 0;
    }

    .locker-stats-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .locker-gender-card {
        flex: 1;
        min-width: 280px;
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .locker-gender-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f1f5f9;
    }

    .locker-gender-header.gents {
        border-bottom-color: #3b82f6;
    }

    .locker-gender-header.ladies {
        border-bottom-color: #ec4899;
    }

    .locker-gender-header i {
        font-size: 20px;
    }

    .locker-gender-header.gents i {
        color: #3b82f6;
    }

    .locker-gender-header.ladies i {
        color: #ec4899;
    }

    .locker-mini-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .locker-mini-stat {
        background: #f8fafc;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
    }

    .locker-mini-stat .value {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .locker-mini-stat .label {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
    }

    .locker-mini-stat.total .value {
        color: #6366f1;
    }

    .locker-mini-stat.occupied .value {
        color: #3b82f6;
    }

    .locker-mini-stat.empty .value {
        color: #10b981;
    }

    .locker-mini-stat.expired .value {
        color: #ef4444;
    }

    /* Collapse button styles */
    .collapse-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .collapse-btn:hover {
        background: #f1f5f9;
    }

    .collapse-btn i {
        transition: transform 0.3s ease;
    }

    .collapse-btn[aria-expanded="false"] i {
        transform: rotate(180deg);
    }

    .collapse-btn[aria-expanded="true"] i {
        transform: rotate(0deg);
    }

    .text-purple {
        color: #8b5cf6 !important;
    }

    /* ========== DARK MODE OVERRIDES ========== */
    [data-theme="dark"] .dashboard-header {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        border-color: #475569;
    }

    [data-theme="dark"] .dashboard-header h3 {
        color: #e2e8f0;
    }

    [data-theme="dark"] .section-header h5 {
        color: #e2e8f0;
    }

    [data-theme="dark"] .locker-gender-card {
        background: #1e293b;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    }

    [data-theme="dark"] .locker-gender-header h6 {
        color: #e2e8f0;
    }

    [data-theme="dark"] .locker-gender-header {
        border-bottom-color: #475569;
    }

    [data-theme="dark"] .locker-gender-header.gents {
        border-bottom-color: #3b82f6;
    }

    [data-theme="dark"] .locker-gender-header.ladies {
        border-bottom-color: #ec4899;
    }

    [data-theme="dark"] .locker-mini-stat {
        background: #0f172a;
    }

    [data-theme="dark"] .locker-mini-stat .label {
        color: #94a3b8;
    }

    [data-theme="dark"] .data-table {
        background: #1e293b;
    }

    [data-theme="dark"] .data-table .card-body {
        background: #1e293b !important;
    }

    [data-theme="dark"] .collapse-btn:hover {
        background: #334155;
    }

    [data-theme="dark"] .divider {
        background: linear-gradient(to right, transparent, #475569, transparent);
    }

    [data-theme="dark"] .btn-outline-primary {
        color: #60a5fa;
        border-color: #60a5fa;
    }

    [data-theme="dark"] .btn-outline-primary:hover {
        background: rgba(59, 130, 246, 0.15);
        color: #93bbfd;
    }

    /* Table text visibility in dark mode */
    [data-theme="dark"] .table {
        color: #e2e8f0;
    }

    [data-theme="dark"] .table td {
        color: #cbd5e1;
        border-color: #334155;
    }

    [data-theme="dark"] .table td.fw-semibold {
        color: #f1f5f9;
    }

    [data-theme="dark"] .table th {
        border-color: #334155;
    }

    [data-theme="dark"] .table-hover>tbody>tr:hover {
        --bs-table-hover-bg: rgba(255, 255, 255, 0.05);
        color: #f1f5f9;
    }

    /* Card & heading text */
    [data-theme="dark"] .card:not(.stat-card) {
        background-color: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .stat-card {
        border-color: transparent;
        background-color: transparent !important;
    }

    html[data-theme="dark"] .stat-card>.card-body {
        background-color: transparent !important;
        background: transparent !important;
    }

    [data-theme="dark"] .table-header-icon {
        color: #e2e8f0;
    }

    [data-theme="dark"] .badge.bg-warning.text-dark {
        color: #1e293b !important;
    }

    /* Buttons in dark mode */
    [data-theme="dark"] .btn-outline-secondary {
        color: #94a3b8;
        border-color: #475569;
    }

    [data-theme="dark"] .btn-outline-secondary:hover {
        background: #334155;
        color: #e2e8f0;
        border-color: #64748b;
    }

    [data-theme="dark"] .btn-sm.btn-outline-primary {
        color: #60a5fa;
        border-color: #3b82f6;
    }

    [data-theme="dark"] .btn-sm.btn-outline-primary:hover {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
    }

    [data-theme="dark"] .text-muted {
        color: #64748b !important;
    }
</style>

<!-- ======================= GYM DASHBOARD ======================= -->
<div class="section-header">
    <div class="section-icon gym">
        <i class="fa-solid fa-dumbbell"></i>
    </div>
    <div>
        <h5 class="mb-0">Gym Overview</h5>
        <small class="text-muted">Membership statistics</small>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h2>@ViewBag.Total</h2>
                <p class="mb-0">Total Members</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h2>@ViewBag.Active</h2>
                <p class="mb-0">Active Members</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <h2>@ViewBag.Expired</h2>
                <p class="mb-0">Expired</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <h2>@ViewBag.ExpiringSoon</h2>
                <p class="mb-0">Expiring Soon</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <h2>@ViewBag.JoinedThisMonth</h2>
                <p class="mb-0">Joined This Month</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-6 mb-3">
        <div class="card stat-card shadow text-white"
             style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%) !important;">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <h2>Rs @ViewBag.GymTotalDue.ToString("N0")</h2>
                <p class="mb-0">Total Due Amount</p>
            </div>
        </div>
    </div>
</div>

<!-- Gym Expiring Table -->
<div class="card shadow data-table mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0 table-header-icon">
                <span class="section-icon gym" style="width:32px;height:32px;font-size:14px;">
                    <i class="fa-solid fa-hourglass-half"></i>
                </span>
                Gym Members Expiring in 7 Days
                <span class="badge bg-warning text-dark ms-2">@Model.Count()</span>
            </h5>
            <button class="btn btn-sm btn-outline-secondary collapse-btn" type="button" data-bs-toggle="collapse"
                    data-bs-target="#gymExpiringTable" aria-expanded="true">
                <i class="fa-solid fa-chevron-up"></i>
            </button>
        </div>

        <div class="collapse show" id="gymExpiringTable">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Plan</th>
                            <th>Expire Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var m in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@(m.Customer?.FullName ?? "Unknown")</td>
                                    <td>@(m.Customer?.Phone ?? "-")</td>
                                    <td><span class="badge bg-secondary">@m.PlanName</span></td>
                                    <td>
                                        <span class="text-warning fw-semibold">
                                            <i class="fa-solid fa-calendar-day me-1"></i>
                                            @m.ExpireDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" href="/Customers/Details/@m.CustomerID">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>
                                        <a class="btn btn-sm btn-success" href="/Memberships/Renew/@m.CustomerID">
                                            <i class="fa-solid fa-rotate"></i> Renew
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-party-horn fa-2x mb-2 d-block"></i>
                                    No members expiring soon 🎉
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<hr class="divider" />

<!-- ======================= LOCKER DASHBOARD ======================= -->
<div class="section-header">
    <div class="section-icon locker">
        <i class="fa-solid fa-lock"></i>
    </div>
    <div>
        <h5 class="mb-0">Locker Overview</h5>
        <small class="text-muted">Locker allocation statistics</small>
    </div>
    <a href="/Locker" class="btn btn-sm btn-outline-primary ms-auto">
        <i class="fa-solid fa-arrow-right me-1"></i> View All
    </a>
</div>

<div class="locker-stats-row mb-4">
    <!-- Gents Lockers -->
    <div class="locker-gender-card">
        <div class="locker-gender-header gents">
            <i class="fa-solid fa-mars"></i>
            <h6 class="mb-0 fw-bold">Gents Lockers</h6>
        </div>
        <div class="locker-mini-stats">
            <div class="locker-mini-stat total">
                <div class="value">@ViewBag.LockerGentsTotal</div>
                <div class="label">Total</div>
            </div>
            <div class="locker-mini-stat occupied">
                <div class="value">@ViewBag.LockerGentsOccupied</div>
                <div class="label">Occupied</div>
            </div>
            <div class="locker-mini-stat empty">
                <div class="value">@ViewBag.LockerGentsEmpty</div>
                <div class="label">Empty</div>
            </div>
            <div class="locker-mini-stat expired">
                <div class="value">@ViewBag.LockerGentsExpired</div>
                <div class="label">Expired</div>
            </div>
        </div>
    </div>

    <!-- Ladies Lockers -->
    <div class="locker-gender-card">
        <div class="locker-gender-header ladies">
            <i class="fa-solid fa-venus"></i>
            <h6 class="mb-0 fw-bold">Ladies Lockers</h6>
        </div>
        <div class="locker-mini-stats">
            <div class="locker-mini-stat total">
                <div class="value">@ViewBag.LockerLadiesTotal</div>
                <div class="label">Total</div>
            </div>
            <div class="locker-mini-stat occupied">
                <div class="value">@ViewBag.LockerLadiesOccupied</div>
                <div class="label">Occupied</div>
            </div>
            <div class="locker-mini-stat empty">
                <div class="value">@ViewBag.LockerLadiesEmpty</div>
                <div class="label">Empty</div>
            </div>
            <div class="locker-mini-stat expired">
                <div class="value">@ViewBag.LockerLadiesExpired</div>
                <div class="label">Expired</div>
            </div>
        </div>
    </div>

    <!-- Total Due Card -->
    <div class="card stat-card shadow text-white"
         style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%) !important; min-width: 200px; flex: 0.5;">
        <div class="card-body d-flex flex-column justify-content-center">
            <div class="stat-icon">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <h2>Rs @ViewBag.LockerTotalDue.ToString("N0")</h2>
            <p class="mb-0">Total Locker Due</p>
        </div>
    </div>
</div>

<!-- Locker Expired Table -->
<div class="card shadow data-table mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0 table-header-icon">
                <span class="section-icon locker" style="width:32px;height:32px;font-size:14px;">
                    <i class="fa-solid fa-clock"></i>
                </span>
                Expired Lockers
                @if (ViewBag.LockerExpiredList != null)
                {
                    <span class="badge bg-danger ms-2">@ViewBag.LockerExpiredList.Count</span>
                }
            </h5>
            <button class="btn btn-sm btn-outline-secondary collapse-btn" type="button" data-bs-toggle="collapse"
                    data-bs-target="#lockerExpiredTable" aria-expanded="true">
                <i class="fa-solid fa-chevron-up"></i>
            </button>
        </div>

        <div class="collapse show" id="lockerExpiredTable">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Locker #</th>
                            <th>Gender</th>
                            <th>Assigned To</th>
                            <th>Expired Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.LockerExpiredList != null && ViewBag.LockerExpiredList.Count > 0)
                        {
                            foreach (var l in ViewBag.LockerExpiredList)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <i class="fa-solid fa-lock me-1 text-purple"></i>#@l.LockerNumber
                                    </td>
                                    <td>
                                        <span class="badge @(l.Gender == "Gents" ? "bg-primary" : "bg-danger")">
                                            <i class="fa-solid fa-@(l.Gender == "Gents" ? "mars" : "venus") me-1"></i>@l.Gender
                                        </span>
                                    </td>
                                    <td>@l.AssignedTo</td>
                                    <td>
                                        <span class="text-danger fw-semibold">
                                            <i class="fa-solid fa-calendar-xmark me-1"></i>
                                            @(l.EndDate?.ToString("dd MMM yyyy") ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" href="/Locker/Edit/@l.LockerID">
                                            <i class="fa-solid fa-edit"></i> Edit
                                        </a>
                                        <a class="btn btn-sm btn-success" href="/Locker/Renew/@l.LockerID">
                                            <i class="fa-solid fa-rotate"></i> Renew
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-thumbs-up fa-2x mb-2 d-block"></i>
                                    No expired lockers 🎉
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

