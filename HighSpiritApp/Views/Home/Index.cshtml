<!-- Boxing Due Table -->
<div class="card shadow data-table">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0 table-header-icon">
                <span class="section-icon boxing" style="width:32px;height:32px;font-size:14px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                Boxing Members with Due
                @if (ViewBag.BoxingDueList != null)
                {
                    <span class="badge bg-danger ms-2">@ViewBag.BoxingDueList.Count</span>
                }
            </h5>
            <button class="btn btn-sm btn-outline-secondary collapse-btn" type="button" data-bs-toggle="collapse"
                    data-bs-target="#boxingDueTable" aria-expanded="true">
                <i class="fa-solid fa-chevron-up"></i>
            </button>
        </div>

        <div class="collapse show" id="boxingDueTable">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Guardian</th>
                            <th>Contact</th>
                            <th>Due Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.BoxingDueList != null && ViewBag.BoxingDueList.Count > 0)
                        {
                            foreach (var b in ViewBag.BoxingDueList)
                            {
                                <tr>
                                    <td class="fw-semibold">@b.Name</td>
                                    <td>@b.GuardianName</td>
                                    <td>
                                        <i class="fa-solid fa-phone me-1 text-muted"></i>
                                        @b.GuardianContact
                                    </td>
                                    <td>
                                        <span class="badge bg-danger fs-6">
                                            <i class="fa-solid fa-indian-rupee-sign me-1"></i>@b.DueAmount
                                        </span>
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" href="/Boxing/Details/@b.BoxingMemberID">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-thumbs-up fa-2x mb-2 d-block"></i>
                                    No boxing dues 🎉
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                        // Handle collapse button aria-expanded state for chevron rotation
                        document.addEventListener('DOMContentLoaded', function () {
                            const collapseButtons = document.querySelectorAll('.collapse-btn');

                            collapseButtons.forEach(function (btn) {
                                const targetId = btn.getAttribute('data-bs-target');
                                const targetEl = document.querySelector(targetId);

                                if (targetEl) {
                                    // Listen for Bootstrap collapse events
                                    targetEl.addEventListener('show.bs.collapse', function () {
                                        btn.setAttribute('aria-expanded', 'true');
                                    });

                                    targetEl.addEventListener('hide.bs.collapse', function () {
                                        btn.setAttribute('aria-expanded', 'false');
                                    });
                                }
                            });
                        });
    </script>
}