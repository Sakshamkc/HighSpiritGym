@model List<HighSpiritApp.Models.TransactionLog>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Transaction History";
    string? entityType = ViewBag.EntityType;
    string? transactionType = ViewBag.TransactionType;
    string? search = ViewBag.Search;
    string? fromDate = ViewBag.From;
    string? toDate = ViewBag.To;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    decimal totalAmount = ViewBag.TotalAmount;
    decimal totalDue = ViewBag.TotalDue;
    decimal todayTotal = ViewBag.TodayTotal;
    decimal monthTotal = ViewBag.MonthTotal;
}

<style>
    .txn-header {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        border-radius: 16px;
        padding: 20px 25px;
        color: white;
        margin-bottom: 20px;
    }

    .txn-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .stat-cards {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .stat-card {
        flex: 1;
        min-width: 180px;
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        padding: 16px 20px;
        text-align: center;
    }

    .stat-card .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
    }

    .stat-card .stat-label {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
    }

    .stat-card.green .stat-value {
        color: #059669;
    }

    .stat-card.blue .stat-value {
        color: #2563eb;
    }

    .stat-card.orange .stat-value {
        color: #ea580c;
    }

    .stat-card.purple .stat-value {
        color: #7c3aed;
    }

    .filter-bar {
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }

    .filter-bar .fg {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .filter-bar label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
    }

    .filter-bar select,
    .filter-bar input {
        padding: 8px 12px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .txn-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .txn-table thead th {
        background: #f8fafc;
        padding: 12px 16px;
        text-align: left;
        font-size: 0.78rem;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0;
    }

    .txn-table tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
        color: #1e293b;
    }

    .txn-table tbody tr:hover {
        background: #f8fafc;
    }

    .badge-type {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-payment {
        background: #dcfce7;
        color: #166534;
    }

    .badge-renewal {
        background: #e0e7ff;
        color: #3730a3;
    }

    .badge-refund {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-entity {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .badge-customer {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-boxing {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-locker {
        background: #f3e8ff;
        color: #6b21a8;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #94a3b8;
    }

    .empty-state i {
        font-size: 48px;
        margin-bottom: 16px;
        display: block;
    }

    [data-theme="dark"] .stat-card {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .filter-bar {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .filter-bar select,
    [data-theme="dark"] .filter-bar input {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    [data-theme="dark"] .txn-table {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .txn-table thead th {
        background: #0f172a;
        color: #94a3b8;
        border-color: #334155;
    }

    [data-theme="dark"] .txn-table tbody td {
        color: #e2e8f0;
        border-color: #334155;
    }
</style>

<div class="txn-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h4><i class="fa-solid fa-receipt"></i> Transaction History</h4>
        <span style="background:rgba(255,255,255,0.15);padding:6px 14px;border-radius:10px;font-size:13px;">
            @totalCount transactions
        </span>
    </div>
</div>

<div class="stat-cards">
    <div class="stat-card green">
        <div class="stat-value">Rs. @todayTotal.ToString("N0")</div>
        <div class="stat-label"><i class="fa-solid fa-calendar-day"></i> Today's Collection</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-value">Rs. @monthTotal.ToString("N0")</div>
        <div class="stat-label"><i class="fa-solid fa-calendar"></i> This Month</div>
    </div>
    <div class="stat-card purple">
        <div class="stat-value">Rs. @totalAmount.ToString("N0")</div>
        <div class="stat-label"><i class="fa-solid fa-coins"></i> Filtered Total</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-value">Rs. @totalDue.ToString("N0")</div>
        <div class="stat-label"><i class="fa-solid fa-exclamation-circle"></i> Filtered Due</div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="fg">
        <label>Category</label>
        <select name="entityType">
            <option value="">All</option>
            <option value="Customer" selected="@(entityType == "Customer")">Gym Members</option>
            <option value="Boxing" selected="@(entityType == "Boxing")">Boxing</option>
            <option value="Locker" selected="@(entityType == "Locker")">Locker</option>
        </select>
    </div>
    <div class="fg">
        <label>Type</label>
        <select name="transactionType">
            <option value="">All</option>
            <option value="Payment" selected="@(transactionType == "Payment")">Payment</option>
            <option value="Renewal" selected="@(transactionType == "Renewal")">Renewal</option>
        </select>
    </div>
    <div class="fg">
        <label>From</label>
        <input type="date" name="from" value="@fromDate" />
    </div>
    <div class="fg">
        <label>To</label>
        <input type="date" name="to" value="@toDate" />
    </div>
    <div class="fg">
        <label>Search</label>
        <input type="text" name="search" value="@search" placeholder="Name..." />
    </div>
    <button type="submit" class="btn btn-primary" style="border-radius:8px;height:38px;">
        <i class="fa-solid fa-filter me-1"></i> Filter
    </button>
    <a href="/Transaction" class="btn btn-outline-secondary" style="border-radius:8px;height:38px;">Clear</a>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="fa-solid fa-receipt"></i>
        <p>No transactions found</p>
    </div>
}
else
{
    <table class="txn-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Name</th>
                <th>Category</th>
                <th>Type</th>
                <th>Plan</th>
                <th>Paid</th>
                <th>Due</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sn = (page - 1) * 30 + 1;
            }
            @foreach (var t in Model)
            {
                var typeClass = t.TransactionType switch
                {
                    "Payment" => "badge-payment",
                    "Renewal" => "badge-renewal",
                    "Refund" => "badge-refund",
                    _ => "badge-payment"
                };
                var entityClass = t.EntityType switch
                {
                    "Customer" => "badge-customer",
                    "Boxing" => "badge-boxing",
                    "Locker" => "badge-locker",
                    _ => "badge-customer"
                };
                <tr>
                    <td>@(sn++)</td>
                    <td>@t.TransactionDate.ToString("dd MMM yyyy")<br /><small
                        style="color:#94a3b8;">@t.TransactionDate.ToString("hh:mm tt")</small></td>
                        <td><strong>@t.EntityName</strong></td>
                        <td><span class="badge-entity @entityClass">@t.EntityType</span></td>
                        <td><span class="badge-type @typeClass">@t.TransactionType</span></td>
                        <td>@(t.PlanName ?? "—")</td>
                        <td style="color:#059669;font-weight:600;">Rs. @t.Amount.ToString("N0")</td>
                        <td>
                            @if (t.DueAmount > 0)
                            {
                                <span style="color:#ef4444;font-weight:600;">Rs. @t.DueAmount.ToString("N0")</span>
                            }
                            else
                            {
                                <span style="color:#10b981;"><i class="fa-solid fa-check-circle"></i></span>
                            }
                        </td>
                        <td><small style="color:#64748b;">@t.PerformedBy</small></td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link"
                               href="/Transaction?entityType=@entityType&transactionType=@transactionType&search=@search&from=@fromDate&to=@toDate&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
