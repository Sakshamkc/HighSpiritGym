@model List<HighSpiritApp.Models.StaffAttendance>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Attendance";
    var staffList = ViewBag.StaffList as List<HighSpiritApp.Models.Staff> ?? new List<HighSpiritApp.Models.Staff>();
    int? selectedStaffId = ViewBag.SelectedStaffId;
    string fromDate = ViewBag.From;
    string toDate = ViewBag.To;
    int totalRecords = ViewBag.TotalRecords;
}

<style>
    .att-header {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        border-radius: 16px;
        padding: 20px 25px;
        color: white;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .att-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .filter-form {
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }

    .filter-form .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .filter-form label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
    }

    .filter-form select,
    .filter-form input {
        padding: 8px 12px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .att-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .att-table thead th {
        background: #f8fafc;
        padding: 12px 16px;
        text-align: left;
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        border-bottom: 1px solid #e2e8f0;
    }

    .att-table tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
        color: #1e293b;
    }

    .att-table tbody tr:hover {
        background: #f8fafc;
    }

    .duration-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        background: #eff6ff;
        color: #2563eb;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    .status-dot.in {
        background: #10b981;
    }

    .status-dot.out {
        background: #94a3b8;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #94a3b8;
    }

    .empty-state i {
        font-size: 48px;
        margin-bottom: 16px;
        display: block;
    }

    [data-theme="dark"] .filter-form {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .filter-form select,
    [data-theme="dark"] .filter-form input {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    [data-theme="dark"] .att-table {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .att-table thead th {
        background: #0f172a;
        color: #94a3b8;
        border-color: #334155;
    }

    [data-theme="dark"] .att-table tbody td {
        color: #e2e8f0;
        border-color: #334155;
    }
</style>

<div class="att-header">
    <h4><i class="fa-solid fa-clock-rotate-left"></i> Staff Attendance History</h4>
    <div style="display:flex;gap:10px;align-items:center;">
        <a href="/Staff/MobileScan" target="_blank" class="btn btn-sm" style="background:rgba(255,255,255,0.15);color:white;border-radius:10px;font-size:13px;padding:6px 14px;text-decoration:none;">
            <i class="fa-solid fa-mobile-screen"></i> Mobile Scanner
        </a>
        <a href="/Staff/QrScan" target="_blank" class="btn btn-sm" style="background:rgba(255,255,255,0.15);color:white;border-radius:10px;font-size:13px;padding:6px 14px;text-decoration:none;">
            <i class="fa-solid fa-qrcode"></i> USB Scanner
        </a>
        <span style="background:rgba(255,255,255,0.15);padding:6px 14px;border-radius:10px;font-size:13px;">@totalRecords records</span>
    </div>
    </div>

    <form method="get" class="filter-form">
        <div class="form-group">
            <label>Staff Member</label>
            <select name="staffId">
                <option value="">All Staff</option>
                @foreach (var s in staffList)
                {
                    if (selectedStaffId == s.StaffID)
                    {
                        <option value="@s.StaffID" selected>@s.FullName</option>
                    }
                    else
                    {
                        <option value="@s.StaffID">@s.FullName</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>From</label>
            <input type="date" name="from" value="@fromDate" />
        </div>
        <div class="form-group">
            <label>To</label>
            <input type="date" name="to" value="@toDate" />
        </div>
        <button type="submit" class="btn btn-primary" style="border-radius:8px;height:38px;"><i
            class="fa-solid fa-filter me-1"></i> Filter</button>
            <a href="/Staff/Attendance" class="btn btn-outline-secondary" style="border-radius:8px;height:38px;">Clear</a>
        </form>

        <!-- Manual Punch In/Out Section -->
        <div
            style="background:white;border-radius:14px;border:1px solid #e2e8f0;padding:16px 20px;margin-bottom:20px;display:flex;flex-wrap:wrap;gap:12px;align-items:end;">
            <div style="flex:1;min-width:200px;">
                <label
                    style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;display:block;margin-bottom:4px;">Staff</label>
                    <select id="manualStaffSelect"
                            style="width:100%;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.9rem;">
                        <option value="">-- Select Staff --</option>
                        @foreach (var s in staffList)
                        {
                            <option value="@s.StaffID">@s.FullName</option>
                        }
                    </select>
                </div>
                <div style="min-width:140px;">
                    <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;display:block;margin-bottom:4px;">Date</label>
                    <input type="date" id="manualDate" style="width:100%;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.9rem;" />
                </div>
                <div style="min-width:80px;">
                    <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;display:block;margin-bottom:4px;">Hour</label>
                    <select id="manualHour" style="width:100%;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.9rem;">
                        @for (int h = 1; h <= 12; h++)
                        {
                            <option value="@h">@h</option>
                        }
                    </select>
                </div>
                <div style="min-width:80px;">
                    <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;display:block;margin-bottom:4px;">Min</label>
                    <select id="manualMinute" style="width:100%;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.9rem;">
                        @for (int m = 0; m < 60; m += 5)
                        {
                            <option value="@m">@m.ToString("D2")</option>
                        }
                    </select>
                </div>
                <div style="min-width:70px;">
                    <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;display:block;margin-bottom:4px;">AM/PM</label>
                    <select id="manualAmPm" style="width:100%;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.9rem;">
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>
                </div>
                <form method="post" asp-action="ManualPunchIn" id="manualPunchInForm" style="margin:0;">
                    <input type="hidden" name="staffId" id="manualPunchInStaffId" />
                    <input type="hidden" name="checkInTime" id="manualPunchInTime" />
                    <button type="submit" class="btn btn-success" style="border-radius:8px;height:38px;" disabled id="btnManualPunchIn">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Punch In
                    </button>
                </form>
                <form method="post" asp-action="PunchIn" id="punchInForm" style="margin:0;display:none;">
                    <input type="hidden" name="staffId" id="punchInStaffId" />
                    <input type="hidden" name="returnTo" value="attendance" />
                </form>
                <form method="post" asp-action="PunchOut" id="punchOutForm" style="margin:0;display:none;">
                    <input type="hidden" name="staffId" id="punchOutStaffId" />
                    <input type="hidden" name="returnTo" value="attendance" />
                </form>
                <button type="button" class="btn btn-primary" style="border-radius:8px;height:38px;" disabled id="btnQuickPunchIn" onclick="document.getElementById('punchInForm').submit();">
                    <i class="fa-solid fa-bolt me-1"></i> Quick In (Now)
                </button>
                <button type="button" class="btn btn-warning" style="border-radius:8px;height:38px;" disabled id="btnQuickPunchOut" onclick="document.getElementById('punchOutForm').submit();">
                    <i class="fa-solid fa-bolt me-1"></i> Quick Out (Now)
                </button>
            </div>

            <script>
                // Set defaults to Nepal time now
                (function() {
                    var now = new Date();
                    var nepalOffset = 5 * 60 + 45;
                    var utc = now.getTime() + now.getTimezoneOffset() * 60000;
                    var nepal = new Date(utc + nepalOffset * 60000);
                    document.getElementById('manualDate').value = nepal.toISOString().slice(0, 10);
                    var h = nepal.getHours();
                    var m = nepal.getMinutes();
                    var ampm = h >= 12 ? 'PM' : 'AM';
                    h = h % 12 || 12;
                    document.getElementById('manualHour').value = h;
                    // Round to nearest 5 min
                    var roundedMin = Math.round(m / 5) * 5;
                    if (roundedMin === 60) roundedMin = 55;
                    document.getElementById('manualMinute').value = roundedMin;
                    document.getElementById('manualAmPm').value = ampm;
                })();

                document.getElementById('manualStaffSelect').addEventListener('change', function () {
                    var staffId = this.value;
                    document.getElementById('manualPunchInStaffId').value = staffId;
                    document.getElementById('punchInStaffId').value = staffId;
                    document.getElementById('punchOutStaffId').value = staffId;
                    document.getElementById('btnManualPunchIn').disabled = !staffId;
                    document.getElementById('btnQuickPunchIn').disabled = !staffId;
                    document.getElementById('btnQuickPunchOut').disabled = !staffId;
                });

                document.getElementById('manualPunchInForm').addEventListener('submit', function() {
                    var date = document.getElementById('manualDate').value;
                    var hour = parseInt(document.getElementById('manualHour').value);
                    var min = document.getElementById('manualMinute').value.padStart(2, '0');
                    var ampm = document.getElementById('manualAmPm').value;
                    // Convert to 24hr
                    if (ampm === 'PM' && hour !== 12) hour += 12;
                    if (ampm === 'AM' && hour === 12) hour = 0;
                    var h24 = hour.toString().padStart(2, '0');
                    document.getElementById('manualPunchInTime').value = date + 'T' + h24 + ':' + min;
                });
            </script>

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <p>No attendance records found</p>
                </div>
            }
            else
            {
                <table class="att-table">
                    <thead>
                        <tr>
                            <th>Staff</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var duration = a.CheckOutTime.HasValue ? (a.CheckOutTime.Value - a.CheckInTime) : (TimeSpan?)null;
                            var isActive = !a.CheckOutTime.HasValue;
                            <tr>
                                <td><strong>@a.StaffName</strong></td>
                                <td>@a.CheckInTime.ToString("dd MMM yyyy")</td>
                                <td>@a.CheckInTime.ToString("hh:mm tt")</td>
                                <td>@(a.CheckOutTime?.ToString("hh:mm tt") ?? "—")</td>
                                <td>
                                    @if (duration.HasValue)
                                    {
                                        <span class="duration-badge">@($"{(int)duration.Value.TotalHours}h {duration.Value.Minutes}m")</span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-dot @(isActive ? "in" : "out")"></span>
                                    @(isActive ? "Active" : "Completed")
                                </td>
                                <td style="white-space:nowrap;">
                                    @if (isActive)
                                    {
                                        <form method="post" asp-action="ManualPunchOut" style="display:inline;">
                                            <input type="hidden" name="attendanceId" value="@a.Id" />
                                            <input type="hidden" name="checkOutTime" class="punchout-time" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning punchout-btn" style="border-radius:6px;font-size:0.75rem;" title="Punch Out">
                                                <i class="fa-solid fa-right-from-bracket"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-action="DeleteAttendance" style="display:inline;" onsubmit="return confirm('Delete this attendance record?');">
                                        <input type="hidden" name="attendanceId" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:6px;font-size:0.75rem;" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <script>
                    // Set punch out time to now (Nepal) for manual punch out buttons
                    document.querySelectorAll('.punchout-btn').forEach(function(btn) {
                        btn.closest('form').addEventListener('submit', function() {
                            var now = new Date();
                            var nepalOffset = 5 * 60 + 45;
                            var utc = now.getTime() + now.getTimezoneOffset() * 60000;
                            var nepal = new Date(utc + nepalOffset * 60000);
                            this.querySelector('.punchout-time').value = nepal.toISOString().slice(0, 16);
                        });
                    });
                </script>
            }

            <div class="mt-3">
                <a href="/Staff" class="btn btn-outline-secondary" style="border-radius:10px;"><i
                    class="fa-solid fa-arrow-left me-1"></i> Back to Staff</a>
                </div>
