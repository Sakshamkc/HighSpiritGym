@model HighSpiritApp.Models.Staff
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Staff Member";
}

<style>
    .create-header {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        border-radius: 16px;
        padding: 20px 25px;
        color: white;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .create-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .form-card-header {
        background: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        color: #1e293b;
    }

    .form-card-header i {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white;
    }

    .form-card-body {
        padding: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        font-weight: 500;
        color: #374151;
        margin-bottom: 6px;
        display: block;
        font-size: 0.9rem;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: border 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: #4f46e5;
        outline: none;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .photo-preview {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 12px;
        border: 2px dashed #e2e8f0;
    }

    .photo-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .btn-submit {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white;
        border: none;
        padding: 12px 32px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3);
        transform: translateY(-1px);
    }

    [data-theme="dark"] .form-card {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .form-card-header {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    [data-theme="dark"] .form-group label {
        color: #cbd5e1;
    }

    [data-theme="dark"] .form-group input,
    [data-theme="dark"] .form-group select {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }
</style>

<div class="create-header">
    <h4><i class="fa-solid fa-user-plus"></i> Add Staff Member</h4>
    <a href="/Staff" class="btn btn-light" style="border-radius:10px;"><i class="fa-solid fa-arrow-left me-1"></i>
        Back</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div class="form-card">
            <div class="form-card-header"><i class="fa-solid fa-user"></i> Personal Information</div>
            <div class="form-card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Full Name *</label>
                                    <input type="text" name="FullName" value="@Model.FullName" required
                                           placeholder="Enter full name" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Phone *</label>
                                    <input type="tel" name="Phone" value="@Model.Phone" required
                                           placeholder="Phone number" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Gender</label>
                                    <select name="Gender">
                                        <option value="">Select</option>
                                        @if (Model.Gender == "Male")
                                        {
                                            <option value="Male" selected>Male</option>
                                        }
                                        else
                                        {
                                            <option value="Male">Male</option>
                                        }
                                        @if (Model.Gender == "Female")
                                        {
                                            <option value="Female" selected>Female</option>
                                        }
                                        else
                                        {

                                            <option value="Female">Female</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Age</label>
                                    <input type="number" name="Age" value="@Model.Age" placeholder="Age" min="16"
                                           max="80" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Position</label>
                                    <select name="Position">
                                        <option value="">Select</option>
                                        @{
                                            var positions = new[] { "Trainer", "Receptionist", "Cleaner", "Manager",
                              "Security", "Other" };
                                        }
                                        @foreach (var p in positions)
                                        {
                                            if (Model.Position == p)
                                            {
                                                <option value="@p" selected>@p</option>
                                            }
                                            else
                                            {

                                                <option
                                                value="@p">@p</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Join Date</label>
                                    <input type="date" name="JoinDate" value="@Model.JoinDate.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="form-group">
                            <label>Photo</label>
                            <div class="photo-preview mx-auto" id="photoPreview">
                                <i class="fa-solid fa-camera" style="font-size:24px;color:#94a3b8;"></i>
                            </div>
                            <input type="file" name="photoFile" accept="image/*" class="form-control"
                                   style="border-radius:10px;" onchange="previewPhoto(this)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="/Staff" class="btn btn-outline-secondary" style="border-radius:10px;">Cancel</a>
            <button type="submit" class="btn-submit"><i class="fa-solid fa-check me-1"></i> Add Staff</button>
        </div>
    </form>

    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('photoPreview').innerHTML = `<img src="${e.target.result}" />`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
