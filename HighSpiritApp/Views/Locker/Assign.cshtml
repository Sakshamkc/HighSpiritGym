@model HighSpiritApp.Models.Locker.Locker
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .assign-header {
        background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#3b82f6 0%, #2563eb" : "#ec4899 0%, #db2777") 100%);
        border-radius: 16px; padding: 20px 25px; color: white; margin-bottom: 25px;
        display: flex; align-items: center; justify-content: space-between;
    }
    .assign-header h4 { margin: 0; font-weight: 600; display: flex; align-items: center; gap: 12px; }
    .form-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; margin-bottom: 25px; }
    .form-card-header { background: #f8fafc; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .form-card-header i { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#3b82f6 0%, #2563eb" : "#ec4899 0%, #db2777") 100%); color: white; }
    .form-card-header h5 { margin: 0; font-weight: 600; color: #1e293b; }
    .form-card-body { padding: 25px; }
    .locker-preview { background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#eff6ff 0%, #dbeafe" : "#fdf2f8 0%, #fce7f3") 100%); border: 2px solid @(Model.Gender == "Gents" ? "#93c5fd" : "#f9a8d4"); border-radius: 16px; padding: 25px; text-align: center; }
    .locker-preview .locker-number { font-size: 48px; font-weight: 700; color: @(Model.Gender == "Gents" ? "#2563eb" : "#db2777"); }
    .locker-preview .locker-gender { display: inline-block; padding: 6px 16px; background: white; border-radius: 20px; font-weight: 600; color: @(Model.Gender == "Gents" ? "#1e40af" : "#9d174d"); margin-top: 10px; }
    .form-label { font-weight: 600; color: #475569; margin-bottom: 8px; }
    .form-control, .form-select { border-radius: 10px; border: 2px solid #e2e8f0; padding: 10px 14px; }
    .form-control:focus, .form-select:focus { border-color: @(Model.Gender == "Gents" ? "#3b82f6" : "#ec4899"); box-shadow: 0 0 0 4px @(Model.Gender == "Gents" ? "rgba(59, 130, 246, 0.1)" : "rgba(236, 72, 153, 0.1)"); }
    .duration-selector { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .duration-option { position: relative; }
    .duration-option input { position: absolute; opacity: 0; }
    .duration-option label { display: flex; flex-direction: column; align-items: center; padding: 15px; border: 2px solid #e2e8f0; border-radius: 12px; cursor: pointer; background: #f8fafc; }
    .duration-option label .months { font-size: 24px; font-weight: 700; color: #1e293b; }
    .duration-option input:checked + label { border-color: @(Model.Gender == "Gents" ? "#3b82f6" : "#ec4899"); background: @(Model.Gender == "Gents" ? "#eff6ff" : "#fdf2f8"); box-shadow: 0 0 0 3px @(Model.Gender == "Gents" ? "rgba(59, 130, 246, 0.2)" : "rgba(236, 72, 153, 0.2)"); }
    .btn-assign { background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; padding: 12px 30px; font-weight: 600; border-radius: 10px; }
    .btn-assign:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); }
    .member-dropdown { position: absolute; top: 100%; left: 0; right: 0; background: white; border: 2px solid #e2e8f0; border-top: none; border-radius: 0 0 12px 12px; max-height: 300px; overflow-y: auto; z-index: 100; display: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    .member-dropdown.show { display: block; }
    .member-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #f1f5f9; }
    .member-item:hover { background: #f0fdf4; }
    .member-item .member-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; }
    .member-item img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .selected-member-card { display: none; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 2px solid #86efac; border-radius: 12px; padding: 12px 16px; margin-top: 10px; align-items: center; gap: 12px; }
    .selected-member-card.show { display: flex; }
    @@media (max-width: 576px) { .duration-selector { grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="assign-header">
    <h4><i class="fa-solid fa-user-plus"></i> Assign @Model.Gender Locker #@Model.LockerNumber</h4>
    <a href="/Locker?gender=@Model.Gender" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i> Back</a>
</div>

<form method="post" id="assignForm">
    <input type="hidden" name="id" value="@Model.LockerID" />

    <div class="row">
        <div class="col-lg-4">
            <div class="locker-preview mb-4">
                <div class="locker-number"><i class="fa-solid fa-lock-open me-2"></i>@Model.LockerNumber</div>
                <div class="locker-gender"><i class="fa-solid fa-@(Model.Gender == "Gents" ? "mars" : "venus") me-1"></i> @Model.Gender</div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="form-card">
                <div class="form-card-header">
                    <i class="fa-solid fa-user"></i>
                    <h5>Member Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label"><i class="fa-solid fa-search me-1 text-primary"></i>Search Gym Member</label>
                            <div style="position: relative;">
                                <input type="text" id="memberSearchInput" class="form-control" placeholder="Type to search members..." autocomplete="off" />
                                <div class="member-dropdown" id="memberDropdown"></div>
                            </div>
                            <div class="selected-member-card" id="selectedMemberCard">
                                <div class="member-avatar" id="selectedAvatar">A</div>
                                <div style="flex:1">
                                    <div class="fw-bold" id="selectedName">-</div>
                                    <div class="small text-muted" id="selectedPhone">-</div>
                                    <div class="small text-primary" id="selectedPackage">-</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" id="removeMember"><i class="fa-solid fa-times"></i></button>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" name="memberName" id="memberNameInput" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="text" name="phone" id="phoneInput" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Package (from Member)</label>
                            <input type="text" name="package" id="packageInput" class="form-control" placeholder="e.g., Custom 2 - Gym & Cardio" />
                            <small class="text-muted">This will be auto-filled when you select a member</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="form-card-header">
                    <i class="fa-solid fa-calendar"></i>
                    <h5>Rental Details</h5>
                </div>
                <div class="form-card-body">
                    <label class="form-label mb-3">Duration (Months)</label>
                    <div class="duration-selector mb-4">
                        <div class="duration-option">
                            <input type="radio" name="months" value="1" id="dur1" checked />
                            <label for="dur1"><span class="months">1</span><span class="small text-muted">Month</span></label>
                        </div>
                        <div class="duration-option">
                            <input type="radio" name="months" value="3" id="dur3" />
                            <label for="dur3"><span class="months">3</span><span class="small text-muted">Months</span></label>
                        </div>
                        <div class="duration-option">
                            <input type="radio" name="months" value="6" id="dur6" />
                            <label for="dur6"><span class="months">6</span><span class="small text-muted">Months</span></label>
                        </div>
                        <div class="duration-option">
                            <input type="radio" name="months" value="12" id="dur12" />
                            <label for="dur12"><span class="months">12</span><span class="small text-muted">Months</span></label>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Total Amount (Rs.) <span class="text-danger">*</span></label>
                            <input type="number" name="totalAmount" id="totalInput" class="form-control" value="0" min="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Paid Amount (Rs.) <span class="text-danger">*</span></label>
                            <input type="number" name="paidAmount" id="paidInput" class="form-control" value="0" min="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Due Amount</label>
                            <input type="text" id="dueDisplay" class="form-control" value="Rs. 0" readonly style="background: #f0fdf4; font-weight: 600; color: #166534;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-success btn-assign btn-lg"><i class="fa-solid fa-check me-2"></i> Assign Locker</button>
        <a href="/Locker?gender=@Model.Gender" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>
</form>

<script>
    const totalInput = document.getElementById('totalInput');
    const paidInput = document.getElementById('paidInput');
    const dueDisplayEl = document.getElementById('dueDisplay');

    function updateDue() {
        const total = parseFloat(totalInput.value) || 0;
        const paid = parseFloat(paidInput.value) || 0;
        const due = Math.max(0, total - paid);
        dueDisplayEl.value = 'Rs. ' + due.toLocaleString();
        dueDisplayEl.style.background = due > 0 ? '#fef2f2' : '#f0fdf4';
        dueDisplayEl.style.color = due > 0 ? '#991b1b' : '#166534';
    }

    totalInput.addEventListener('input', updateDue);
    paidInput.addEventListener('input', updateDue);

    // Member Search
    const memberSearchInput = document.getElementById('memberSearchInput');
    const memberDropdown = document.getElementById('memberDropdown');
    const selectedMemberCard = document.getElementById('selectedMemberCard');
    const memberNameInput = document.getElementById('memberNameInput');
    const phoneInput = document.getElementById('phoneInput');
    const packageInput = document.getElementById('packageInput');
    let searchTimeout;

    memberSearchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const term = this.value.trim();
        if (term.length < 2) { memberDropdown.classList.remove('show'); return; }
        searchTimeout = setTimeout(() => {
            fetch(`/Locker/SearchMembers?term=${encodeURIComponent(term)}`)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) {
                        memberDropdown.innerHTML = '<div class="p-3 text-center text-muted">No members found</div>';
                    } else {
                        memberDropdown.innerHTML = data.map(m => `
                            <div class="member-item" data-name="${m.name}" data-phone="${m.phone}" data-package="${m.package}">
                                ${m.photo ? `<img src="data:image/jpeg;base64,${m.photo}" />` : `<div class="member-avatar">${m.name.charAt(0)}</div>`}
                                <div>
                                    <div class="fw-bold">${m.name}</div>
                                    <div class="small text-muted">${m.phone || '-'}</div>
                                    <div class="small text-primary">${m.package || 'No package'}</div>
                                </div>
                            </div>
                        `).join('');
                        memberDropdown.querySelectorAll('.member-item').forEach(item => {
                            item.addEventListener('click', () => {
                                memberNameInput.value = item.dataset.name;
                                phoneInput.value = item.dataset.phone;
                                packageInput.value = item.dataset.package; // Full package name
                                document.getElementById('selectedName').textContent = item.dataset.name;
                                document.getElementById('selectedPhone').textContent = item.dataset.phone || '-';
                                document.getElementById('selectedPackage').textContent = item.dataset.package || '-';
                                selectedMemberCard.classList.add('show');
                                memberDropdown.classList.remove('show');
                                memberSearchInput.value = '';
                            });
                        });
                    }
                    memberDropdown.classList.add('show');
                });
        }, 300);
    });

    document.getElementById('removeMember').addEventListener('click', function() {
        memberNameInput.value = '';
        phoneInput.value = '';
        packageInput.value = '';
        selectedMemberCard.classList.remove('show');
    });

    document.addEventListener('click', function(e) {
        if (!memberSearchInput.contains(e.target) && !memberDropdown.contains(e.target)) {
            memberDropdown.classList.remove('show');
        }
    });
</script>
