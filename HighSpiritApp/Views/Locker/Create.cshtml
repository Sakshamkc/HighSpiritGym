@model HighSpiritApp.Models.Locker.Locker
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var returnUrlRaw = Context.Request.Query["returnUrl"].FirstOrDefault();
    var backUrl = !string.IsNullOrEmpty(returnUrlRaw) ? Uri.UnescapeDataString(returnUrlRaw) : $"/Locker?gender={Model.Gender}";
}

<style>
    .create-header { background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#3b82f6 0%, #2563eb" : "#ec4899 0%, #db2777") 100%); border-radius: 16px; padding: 20px 25px; color: white; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; }
    .create-header h4 { margin: 0; font-weight: 600; display: flex; align-items: center; gap: 12px; }
    .form-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 25px; }
    .form-card-header { background: #f8fafc; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .form-card-header i { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#3b82f6 0%, #2563eb" : "#ec4899 0%, #db2777") 100%); color: white; }
    .form-card-header h5 { margin: 0; font-weight: 600; color: #1e293b; }
    .form-card-body { padding: 25px; }
    .form-label { font-weight: 600; color: #475569; margin-bottom: 8px; }
    .form-control, .form-select { border-radius: 10px; border: 2px solid #e2e8f0; padding: 10px 14px; }
    .form-control:focus, .form-select:focus { border-color: @(Model.Gender == "Gents" ? "#3b82f6" : "#ec4899"); box-shadow: 0 0 0 4px @(Model.Gender == "Gents" ? "rgba(59, 130, 246, 0.1)" : "rgba(236, 72, 153, 0.1)"); }
    .btn-save { background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; padding: 12px 30px; font-weight: 600; border-radius: 10px; }
</style>

<div class="create-header">
    <h4><i class="fa-solid fa-plus"></i> Add New @Model.Gender Locker</h4>
    <a href="@backUrl" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i> Back</a>
</div>

<form method="post">
    <input type="hidden" asp-for="Gender" />
    <input type="hidden" asp-for="Status" />
    
    <div class="row">
        <div class="col-lg-8">
            <div class="form-card">
                <div class="form-card-header">
                    <i class="fa-solid fa-lock"></i>
                    <h5>Locker Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Locker Number <span class="text-danger">*</span></label>
                            <input asp-for="LockerNumber" class="form-control" placeholder="e.g. 1, 2, 3..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Gents">Gents</option>
                                <option value="Ladies">Ladies</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Any additional notes..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-card">
                <div class="form-card-header">
                    <i class="fa-solid fa-circle-info"></i>
                    <h5>Quick Tips</h5>
                </div>
                <div class="form-card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><i class="fa-solid fa-check-circle text-success me-2"></i><small>Locker number must be unique per gender</small></li>
                        <li class="mb-3"><i class="fa-solid fa-check-circle text-success me-2"></i><small>Use simple numbers: 1, 2, 3...</small></li>
                        <li><i class="fa-solid fa-check-circle text-success me-2"></i><small>Gents: 130 lockers, Ladies: 80 lockers</small></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-success btn-save btn-lg"><i class="fa-solid fa-check me-2"></i> Create Locker</button>
        <a href="@backUrl" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>
</form>
