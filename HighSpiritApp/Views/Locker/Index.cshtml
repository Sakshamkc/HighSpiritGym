<div class="locker-page">
    <!-- Header with Gender Toggle -->
    <div class="page-header">
        <h4 class="page-title">
            <i class="fa-solid fa-lock"></i>
            Locker Management
        </h4>
        <div class="gender-toggle">
            <a href="@BuildQuery(overrideGender: "Gents", overrideStatus: ViewBag.Status)"
                   class="@(currentGender == "Gents" ? "active" : "")">
                <i class="fa-solid fa-mars"></i> Gents (@ViewBag.GentsTotal)
            </a>
            <a href="@BuildQuery(overrideGender: "Ladies", overrideStatus: ViewBag.Status)"
                   class="@(currentGender == "Ladies" ? "active" : "")">
                <i class="fa-solid fa-venus"></i> Ladies (@ViewBag.LadiesTotal)
            </a>
        </div>
    </div>

    <!-- Filter Row -->
    <form method="get" class="filter-row" id="filterForm">
        <div class="search-box">
            <i class="fa-solid fa-search"></i>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search locker, name, package..." />
        </div>

        <input type="hidden" name="gender" value="@currentGender" />
        <input type="hidden" name="status" value="@ViewBag.Status" />

        <div class="ms-auto d-flex gap-2 flex-wrap">
            <a href="/Locker/Export?gender=@currentGender@(string.IsNullOrEmpty(ViewBag.Status as string) ? "" : $"&status={ViewBag.Status}")"
                   class="btn-action btn-export" title="Export to Excel">
                <i class="fa-solid fa-file-excel"></i> Export
            </a>
            <a href="/Locker/Import?gender=@currentGender" class="btn-action btn-import">
                <i class="fa-solid fa-file-import"></i> Import
            </a>
            <a href="/Locker/Create?gender=@currentGender" class="btn-action btn-add">
                <i class="fa-solid fa-plus"></i> Add Locker
            </a>
        </div>
    </form>

    <!-- Stats Row -->
    <div class="stats-row">
        <a href="@BuildQuery(overrideStatus: "")"
               class="stat-card total @(string.IsNullOrEmpty(ViewBag.Status as string) ? "active" : "")">
            <div class="stat-icon"><i class="fa-solid fa-lock"></i></div>
            <div class="stat-value">@ViewBag.CountAll</div>
            <div class="stat-label">Total Lockers</div>
        </a>
        <a href="@BuildQuery(overrideStatus: "empty")"
               class="stat-card empty @(ViewBag.Status == "empty" ? "active" : "")">
            <div class="stat-icon"><i class="fa-solid fa-lock-open"></i></div>
            <div class="stat-value">@ViewBag.CountEmpty</div>
            <div class="stat-label">Empty</div>
        </a>
        <a href="@BuildQuery(overrideStatus: "occupied")"
               class="stat-card occupied @(ViewBag.Status == "occupied" ? "active" : "")">
            <div class="stat-icon"><i class="fa-solid fa-user-lock"></i></div>
            <div class="stat-value">@ViewBag.CountOccupied</div>
            <div class="stat-label">Occupied</div>
        </a>
        <a href="@BuildQuery(overrideStatus: "locked")"
               class="stat-card locked @(ViewBag.Status == "locked" ? "active" : "")">
            <div class="stat-icon"><i class="fa-solid fa-ban"></i></div>
            <div class="stat-value">@ViewBag.CountLocked</div>
            <div class="stat-label">Locked</div>
        </a>
        <a href="@BuildQuery(overrideStatus: "expired")"
               class="stat-card expired @(ViewBag.Status == "expired" ? "active" : "")">
            <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
            <div class="stat-value">@ViewBag.CountExpired</div>
            <div class="stat-label">Expired</div>
        </a>
        <div class="stat-card due">
            <div class="stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
            <div class="stat-value">Rs. @(((decimal)ViewBag.TotalDue).ToString("N0"))</div>
            <div class="stat-label">Total Due</div>
        </div>
    </div>

    <!-- Locker Panel -->
    <div class="locker-panel-container">
        <div class="locker-panel-header">
            <h5>
                <i class="fa-solid fa-@(isGents ? "mars" : "venus")"
                   style="color: @(isGents ? "#3b82f6" : "#ec4899");"></i>
                @currentGender Lockers
            </h5>
            <span class="count-info">Showing @Model.Count of @ViewBag.CountAll lockers</span>
        </div>

        <div class="locker-panel">
            @if (Model.Any())
            {
                <div class="locker-grid">
                    @foreach (var locker in Model)
                    {
                        var stateClass = "empty";
                        var statusText = "Empty";
                        var iconClass = "fa-lock-open";

                        if (locker.Status == "Locked")
                        {
                            stateClass = "locked";
                            statusText = "Locked";
                            iconClass = "fa-ban";
                        }
                        else if (locker.Status == "Occupied" && locker.IsExpired)
                        {
                            stateClass = "expired";
                            statusText = "Expired";
                            iconClass = "fa-clock";
                        }
                        else if (locker.Status == "Occupied" && !string.IsNullOrEmpty(locker.AssignedTo))
                        {
                            stateClass = "occupied";
                            statusText = "Occupied";
                            iconClass = "fa-user-lock";
                        }

                        <div class="locker-card @stateClass">
                            @if (locker.DueAmount > 0)
                            {
                                <span class="due-badge">DUE</span>
                            }

                            <!-- Make the main card content clickable to view details -->
                            <a href="/Locker/Details/@locker.LockerID" class="locker-card-link">
                                <div class="locker-icon">
                                    <i class="fa-solid @iconClass"></i>
                                </div>

                                <div class="locker-number">@locker.LockerNumber</div>
                                <span class="locker-status">@statusText</span>

                                @if (!string.IsNullOrEmpty(locker.AssignedTo))
                                {
                                    <div class="member-info">
                                        <div class="member-name" title="@locker.AssignedTo">@locker.AssignedTo</div>
                                        @if (locker.EndDate.HasValue)
                                        {
                                            <div class="member-expiry">
                                                <i class="fa-solid fa-calendar-day me-1"></i>
                                                @locker.EndDate.Value.ToString("dd MMM yy")
                                            </div>
                                        }
                                    </div>
                                }
                            </a>

                            <div class="locker-actions">
                                @if (stateClass == "empty")
                                {
                                    <a href="/Locker/Assign/@locker.LockerID" class="btn-sm-icon assign" title="Assign">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </a>
                                }
                                else if (stateClass == "occupied" || stateClass == "expired")
                                {
                                    <a href="/Locker/Renew/@locker.LockerID" class="btn-sm-icon renew" title="Renew">
                                        <i class="fa-solid fa-rotate"></i>
                                    </a>
                                    <button type="button" class="btn-sm-icon release" title="Release" data-bs-toggle="modal"
                                            data-bs-target="#releaseModal_@locker.LockerID">
                                        <i class="fa-solid fa-lock-open"></i>
                                    </button>
                                }
                                <a href="/Locker/Edit/@locker.LockerID" class="btn-sm-icon edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </div>

                            <!-- Release Modal -->
                            <div class="modal fade" id="releaseModal_@locker.LockerID" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content" style="border-radius: 16px; border: none;">
                                        <div class="modal-header" style="background: #fef3c7; border-radius: 16px 16px 0 0;">
                                            <h5 class="modal-title" style="font-weight: 600;"><i
                                                class="fa-solid fa-lock-open me-2 text-warning"></i>Release Locker</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body" style="padding: 24px;">
                                                <p style="font-size: 15px;">Release locker <strong>#@locker.LockerNumber</strong>?
                                                </p>
                                                @if (!string.IsNullOrEmpty(locker.AssignedTo))
                                                {
                                                    <p class="text-muted" style="font-size: 14px;">Assigned to:
                                                        <strong>@locker.AssignedTo</strong>
                                                    </p>
                                                }
                                                @if (locker.DueAmount > 0)
                                                {
                                                    <div class="alert alert-danger py-2" style="border-radius: 10px;">
                                                        <i class="fa-solid fa-exclamation-triangle me-2"></i>Outstanding: <strong>Rs.
                                                        @locker.DueAmount.ToString("N0")</strong>
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer" style="border: none; padding: 16px 24px;">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal"
                                                        style="border-radius: 8px;">Cancel</button>
                                                <form method="post" action="/Locker/Release/@locker.LockerID"
                                                      style="display:inline;">
                                                    <button type="submit" class="btn btn-warning"
                                                            style="border-radius: 8px; font-weight: 600;">Yes, Release</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-lock"></i>
                        <h5>No lockers found</h5>
                        <p>Get started by importing from Excel or adding a new locker.</p>
                        <div class="d-flex gap-2 justify-content-center mt-3">
                            <a href="/Locker/Import?gender=@currentGender" class="btn-action btn-import">
                                <i class="fa-solid fa-file-import"></i> Import Excel
                            </a>
                            <a href="/Locker/Create?gender=@currentGender" class="btn-action btn-add">
                                <i class="fa-solid fa-plus"></i> Add Locker
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.Any() && ViewBag.TotalPages > 1)
        {
            <div class="pagination-wrapper">
                <ul class="pagination">
                    @{
                        int current = ViewBag.Page;
                        int total = ViewBag.TotalPages;
                        int start = Math.Max(1, current - 2);
                        int end = Math.Min(total, current + 2);
                    }
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" href="@BuildQuery(overridePage: current - 1)">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = start; i <= end; i++)
                    {
                        <li class="page-item @(i == current ? "active" : "")">
                            <a class="page-link" href="@BuildQuery(overridePage: i)">@i</a>
                        </li>
                    }
                    <li class="page-item @(current == total ? "disabled" : "")">
                        <a class="page-link" href="@BuildQuery(overridePage: current + 1)">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>