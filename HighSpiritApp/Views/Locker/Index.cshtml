@model List<HighSpiritApp.Models.Locker.Locker>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentGender = ViewBag.Gender ?? "Gents";
    var isGents = currentGender == "Gents";

    string BuildQuery(string? overrideGender = null, string? overrideStatus = null, int? overridePage = null)
    {
        var parts = new List<string>();
        var genderVal = overrideGender ?? currentGender;
        if (!string.IsNullOrEmpty(genderVal))
            parts.Add($"gender={genderVal}");
        if (!string.IsNullOrEmpty(ViewBag.Search as string))
            parts.Add($"search={ViewBag.Search}");
        if (!string.IsNullOrEmpty(overrideStatus) || !string.IsNullOrEmpty(ViewBag.Status as string))
        {
            var statusVal = overrideStatus ?? ViewBag.Status;
            if (!string.IsNullOrEmpty(statusVal))
                parts.Add($"status={statusVal}");
        }
        if (overridePage.HasValue)
            parts.Add($"page={overridePage}");
        return "?" + string.Join("&", parts);
    }
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .locker-page {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg,
                @(isGents
                ?
                "#3b82f6 0%, #1d4ed8" :
                "#ec4899 0%, #be185d")
                100%);
        border-radius: 16px;
        padding: 25px 30px;
        color: white;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        font-weight: 700;
        font-size: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .gender-toggle {
        display: flex;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 10px;
        padding: 4px;
    }

    .gender-toggle a {
        padding: 8px 20px;
        border-radius: 8px;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .gender-toggle a:hover {
        color: white;
    }

    .gender-toggle a.active {
        background: white;
        color:
            @(isGents
            ?
            "#2563eb" :
            "#db2777")
        ;
    }

    /* Filter Row */
    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 24px;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 250px;
        max-width: 400px;
    }

    .search-box input {
        width: 100%;
        padding: 12px 16px 12px 44px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        background: #fff;
        transition: all 0.2s;
    }

    .search-box input:focus {
        outline: none;
        border-color:
            @(isGents
            ?
            "#3b82f6" :
            "#ec4899")
        ;
        box-shadow: 0 0 0 4px
            @(isGents
            ?
            "rgba(59, 130, 246, 0.1)" :
            "rgba(236, 72, 153, 0.1)")
        ;
    }

    .search-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    .btn-action {
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        text-decoration: none;
        border: none;
    }

    .btn-export {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        color: #16a34a;
    }

    .btn-export:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.2);
        color: #15803d;
    }

    .btn-import {
        background: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }

    .btn-import:hover {
        background: #f1f5f9;
        color: #475569;
    }

    .btn-add {
        background: linear-gradient(135deg,
                @(isGents
                ?
                "#3b82f6 0%, #2563eb" :
                "#ec4899 0%, #db2777")
                100%);
        color: white;
    }

    .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px
            @(isGents
            ?
            "rgba(59, 130, 246, 0.3)" :
            "rgba(236, 72, 153, 0.3)")
        ;
        color: white;
    }

    /* Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border-radius: 14px;
        padding: 18px 20px;
        border: 2px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.25s;
        text-decoration: none;
        display: block;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .stat-card.active {
        border-color:
            @(isGents
            ?
            "#3b82f6" :
            "#ec4899")
        ;
        box-shadow: 0 0 0 4px
            @(isGents
            ?
            "rgba(59, 130, 246, 0.1)" :
            "rgba(236, 72, 153, 0.1)")
        ;
    }

    .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }

    .stat-card .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
    }

    .stat-card .stat-label {
        font-size: 13px;
        color: #64748b;
        margin-top: 6px;
        font-weight: 600;
    }

    .stat-card.total .stat-icon {
        background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%);
        color: #7c3aed;
    }

    .stat-card.empty .stat-icon {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        color: #16a34a;
    }

    .stat-card.occupied .stat-icon {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        color: #2563eb;
    }

    .stat-card.locked .stat-icon {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        color: #64748b;
    }

    .stat-card.expired .stat-icon {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #dc2626;
    }

    .stat-card.due .stat-icon {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #d97706;
    }

    .stat-card.due .stat-value {
        color: #dc2626;
        font-size: 22px;
    }

    /* Locker Panel */
    .locker-panel-container {
        background: white;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .locker-panel-header {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 20px 25px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .locker-panel-header h5 {
        margin: 0;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .locker-panel-header .count-info {
        font-size: 14px;
        color: #64748b;
    }

    .locker-panel {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 25px;
    }

    /* Locker Grid */
    .locker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 16px;
    }

    /* Locker Card */
    .locker-card {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        text-align: center;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .locker-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .locker-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .locker-card:hover::before {
        opacity: 1;
    }

    /* Locker States */
    .locker-card.empty {
        border-color: #bbf7d0;
    }

    .locker-card.empty::before {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .locker-card.empty:hover {
        border-color: #10b981;
    }

    .locker-card.occupied {
        border-color: #bfdbfe;
    }

    .locker-card.occupied::before {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    }

    .locker-card.occupied:hover {
        border-color: #3b82f6;
    }

    .locker-card.expired {
        border-color: #fecaca;
        background: #fef2f2;
    }

    .locker-card.expired::before {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        opacity: 1;
    }

    .locker-card.expired:hover {
        border-color: #ef4444;
    }

    .locker-card.locked {
        border-color: #e2e8f0;
        background: #f8fafc;
    }

    .locker-card.locked::before {
        background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
    }

    .locker-card.locked:hover {
        border-color: #94a3b8;
    }

    .locker-card .locker-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 12px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .locker-card.empty .locker-icon {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        color: #16a34a;
    }

    .locker-card.occupied .locker-icon {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        color: #2563eb;
    }

    .locker-card.expired .locker-icon {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #dc2626;
    }

    .locker-card.locked .locker-icon {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        color: #64748b;
    }

    .locker-card .locker-number {
        font-size: 28px;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
        margin-bottom: 6px;
    }

    .locker-card .locker-status {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 10px;
    }

    .locker-card.empty .locker-status {
        background: #dcfce7;
        color: #166534;
    }

    .locker-card.occupied .locker-status {
        background: #dbeafe;
        color: #1e40af;
    }

    .locker-card.expired .locker-status {
        background: #fee2e2;
        color: #991b1b;
    }

    .locker-card.locked .locker-status {
        background: #f1f5f9;
        color: #475569;
    }

    .locker-card .member-info {
        border-top: 1px solid #f1f5f9;
        padding-top: 10px;
        margin-top: 8px;
    }

    .locker-card .member-name {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 4px;
    }

    .locker-card .member-expiry {
        font-size: 11px;
        color: #64748b;
    }

    .locker-card.expired .member-expiry {
        color: #dc2626;
        font-weight: 600;
    }

    .locker-card .locker-actions {
        display: flex;
        gap: 6px;
        justify-content: center;
        margin-top: 12px;
    }

    .locker-card .btn-sm-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

    .locker-card .btn-sm-icon.assign {
        background: #dcfce7;
        color: #16a34a;
    }

    .locker-card .btn-sm-icon.assign:hover {
        background: #bbf7d0;
        transform: scale(1.1);
    }

    .locker-card .btn-sm-icon.renew {
        background: #dbeafe;
        color: #2563eb;
    }

    .locker-card .btn-sm-icon.renew:hover {
        background: #bfdbfe;
        transform: scale(1.1);
    }

    .locker-card .btn-sm-icon.release {
        background: #fef3c7;
        color: #d97706;
    }

    .locker-card .btn-sm-icon.release:hover {
        background: #fde68a;
        transform: scale(1.1);
    }

    .locker-card .btn-sm-icon.edit {
        background: #f1f5f9;
        color: #64748b;
    }

    .locker-card .btn-sm-icon.edit:hover {
        background: #e2e8f0;
        transform: scale(1.1);
    }

    /* Due Badge */
    .due-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        background: #dc2626;
        color: white;
        font-size: 9px;
        font-weight: 700;
        padding: 3px 6px;
        border-radius: 6px;
        z-index: 2;
    }

    /* Locker Card Link */
    .locker-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }

    .locker-card-link:hover {
        color: inherit;
    }

    .locker-card-link .locker-icon,
    .locker-card-link .locker-number,
    .locker-card-link .locker-status,
    .locker-card-link .member-info {
        transition: transform 0.2s ease;
    }

    .locker-card:hover .locker-card-link .locker-icon {
        transform: scale(1.05);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state i {
        font-size: 64px;
        color: #cbd5e1;
        margin-bottom: 20px;
        display: block;
    }

    .empty-state h5 {
        color: #64748b;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #94a3b8;
        font-size: 14px;
    }

    /* Pagination */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 24px;
    }

    .pagination {
        display: flex;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .pagination .page-link {
        padding: 10px 16px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .pagination .page-link:hover {
        background: #f8fafc;
        color: #1e293b;
        border-color: #cbd5e1;
    }

    .pagination .page-item.active .page-link {
        background:
            @(isGents
            ?
            "#3b82f6" :
            "#ec4899")
        ;
        color: white;
        border-color:
            @(isGents
            ?
            "#3b82f6" :
            "#ec4899")
        ;
    }

    .pagination .page-item.disabled .page-link {
        color: #cbd5e1;
        pointer-events: none;
    }

    /* Responsive - Mobile Optimized */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            padding: 20px;
            gap: 12px;
        }

        .page-title {
            justify-content: center;
            font-size: 20px;
        }

        .gender-toggle {
            justify-content: center;
            width: 100%;
        }

        .gender-toggle a {
            flex: 1;
            justify-content: center;
            padding: 10px 12px;
            font-size: 13px;
        }

        .filter-row {
            flex-direction: column;
            gap: 12px;
        }

        .search-box {
            max-width: 100%;
            width: 100%;
            min-width: unset;
        }

        .filter-row .ms-auto {
            margin-left: 0 !important;
            width: 100%;
        }

        .filter-row .ms-auto.d-flex {
            justify-content: stretch;
        }

        .filter-row .btn-action {
            flex: 1;
            justify-content: center;
            padding: 10px 12px;
            font-size: 13px;
        }

        .stats-row {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .stat-card {
            padding: 14px;
        }

        .stat-card .stat-icon {
            width: 36px;
            height: 36px;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .stat-card .stat-value {
            font-size: 22px;
        }

        .stat-card .stat-label {
            font-size: 11px;
        }

        .stat-card.due .stat-value {
            font-size: 16px;
        }

        .locker-panel-header {
            flex-direction: column;
            gap: 8px;
            text-align: center;
            padding: 16px;
        }

        .locker-panel {
            padding: 16px;
        }

        .locker-grid {
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 10px;
        }

        .locker-card {
            padding: 12px;
        }

        .locker-card .locker-icon {
            width: 40px;
            height: 40px;
            font-size: 16px;
            margin-bottom: 8px;
        }

        .locker-card .locker-number {
            font-size: 22px;
        }

        .locker-card .locker-status {
            font-size: 9px;
            padding: 3px 8px;
        }

        .locker-card .member-name {
            font-size: 11px;
        }

        .locker-card .member-expiry {
            font-size: 10px;
        }

        .locker-card .locker-actions {
            margin-top: 10px;
        }

        .locker-card .btn-sm-icon {
            width: 28px;
            height: 28px;
            font-size: 11px;
        }
    }

    @@media (max-width: 576px) {
        .page-header {
            padding: 16px;
        }

        .page-title {
            font-size: 18px;
        }

        .gender-toggle a {
            padding: 8px 10px;
            font-size: 12px;
            gap: 6px;
        }

        .filter-row .ms-auto.d-flex.flex-wrap {
            flex-direction: column;
            width: 100%;
        }

        .filter-row .btn-action {
            width: 100%;
        }

        .locker-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .stats-row {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .stat-card {
            padding: 12px;
        }

        .stat-card .stat-value {
            font-size: 20px;
        }

        .stat-card.due .stat-value {
            font-size: 14px;
        }

        .locker-card {
            padding: 10px;
        }

        .locker-card .locker-icon {
            width: 36px;
            height: 36px;
            font-size: 14px;
        }

        .locker-card .locker-number {
            font-size: 20px;
        }

        .locker-card .due-badge {
            font-size: 8px;
            padding: 2px 5px;
        }

        .empty-state {
            padding: 40px 16px;
        }

        .empty-state i {
            font-size: 48px;
        }

        .empty-state .d-flex {
            flex-direction: column;
        }

        .empty-state .btn-action {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 400px) {
        .gender-toggle {
            flex-direction: column;
            gap: 4px;
        }

        .gender-toggle a {
            width: 100%;
        }

        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .locker-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
        }

        .locker-card {
            padding: 8px;
        }

        .locker-card .locker-icon {
            width: 32px;
            height: 32px;
            font-size: 12px;
            margin-bottom: 6px;
        }

        .locker-card .locker-number {
            font-size: 18px;
        }

        .locker-card .locker-status {
            font-size: 8px;
            padding: 2px 6px;
        }

        .locker-card .btn-sm-icon {
            width: 26px;
            height: 26px;
            font-size: 10px;
        }
    }

    /* Dark Mode Overrides */
    [data-theme="dark"] .stat-card {
        background: #1e293b !important;
        border-color: #334155 !important;
    }

    [data-theme="dark"] .stat-card .stat-value {
        color: #e2e8f0 !important;
    }

    [data-theme="dark"] .stat-card .stat-label {
        color: #94a3b8 !important;
    }

    [data-theme="dark"] .stat-card.due .stat-value {
        color: #fca5a5 !important;
    }

    [data-theme="dark"] .locker-panel-container {
        background: #1e293b !important;
        border-color: #334155 !important;
    }

    [data-theme="dark"] .locker-panel-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
        border-bottom-color: #334155 !important;
    }

    [data-theme="dark"] .locker-panel-header h5 {
        color: #e2e8f0 !important;
    }

    [data-theme="dark"] .locker-panel-header .count-info {
        color: #94a3b8 !important;
    }

