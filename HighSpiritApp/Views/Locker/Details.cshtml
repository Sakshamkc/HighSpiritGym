@model HighSpiritApp.Models.Locker.Locker
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statusClass = Model.Status.ToLower();
    if (statusClass == "available") statusClass = "empty";
    if (Model.Status == "Occupied" && Model.IsExpired) statusClass = "expired";
    else if (Model.Status == "Occupied" && Model.IsExpiringSoon) statusClass = "expiring";
    
    // Get customer details if available
    var customer = ViewBag.AssignedCustomer as HighSpiritApp.Models.Customer;
    var latestMembership = customer?.Memberships?.OrderByDescending(x => x.StartDate).FirstOrDefault();
    var today = DateTime.Today;
    var membershipIsExpired = latestMembership != null && latestMembership.ExpireDate < today;
    var membershipIsExpiringSoon = latestMembership != null && latestMembership.ExpireDate >= today && latestMembership.ExpireDate <= today.AddDays(7);
    var membershipDaysLeft = latestMembership != null ? (latestMembership.ExpireDate - today).Days : 0;
}

<style>
    .locker-header { border-radius: 20px; padding: 30px; color: white; margin-bottom: 25px; }
    .locker-header.empty { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); }
    .locker-header.occupied { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
    .locker-header.locked { background: linear-gradient(135deg, #475569 0%, #334155 100%); }
    .locker-header.expired { background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); }
    .locker-header.expiring { background: linear-gradient(135deg, #d97706 0%, #b45309 100%); }

    .locker-icon { width: 100px; height: 100px; border-radius: 20px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 48px; }
    .locker-title { font-size: 36px; font-weight: 700; margin-bottom: 5px; }
    .locker-subtitle { font-size: 16px; opacity: 0.9; }
    .status-badge-lg { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 30px; font-size: 14px; font-weight: 600; background: rgba(255,255,255,0.2); }
    .action-btn { padding: 10px 20px; border-radius: 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }

    .info-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 25px; }
    .info-card-header { background: #f8fafc; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .info-card-header i { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; color: white; }
    .info-card-header.locker i { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); }
    .info-card-header.member i { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
    .info-card-header.payment i { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
    .info-card-header.dates i { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .info-card-header.membership i { background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); }
    .info-card-header h5 { margin: 0; font-weight: 600; color: #1e293b; }
    .info-card-body { padding: 20px; }

    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .info-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .info-item { padding: 15px; background: #f8fafc; border-radius: 12px; }
    .info-item label { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 5px; }
    .info-item span { font-size: 16px; font-weight: 600; color: #1e293b; }
    .info-item span.success { color: #16a34a; }
    .info-item span.danger { color: #dc2626; }
    .info-item span.warning { color: #d97706; }

    .payment-summary { border-radius: 16px; padding: 25px; margin-bottom: 20px; }
    .payment-summary.paid { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #bbf7d0; }
    .payment-summary.due { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border: 1px solid #fecaca; }
    .payment-stat { text-align: center; }
    .payment-stat .value { font-size: 28px; font-weight: 700; }
    .payment-stat .label { font-size: 13px; color: #64748b; }
    .payment-stat.paid .value { color: #16a34a; }
    .payment-stat.due .value { color: #dc2626; }
    .payment-stat.total .value { color: #1e293b; }

    .package-badge { display: inline-block; padding: 6px 12px; border-radius: 8px; font-size: 13px; background: #f3e8ff; color: #7c3aed; }

    /* Customer Card Styles */
    .customer-profile-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 16px;
        padding: 25px;
        color: white;
    }
    .customer-photo {
        width: 100px;
        height: 100px;
        border-radius: 16px;
        object-fit: cover;
        border: 3px solid rgba(255,255,255,0.2);
    }
    .customer-photo-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 16px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        border: 3px solid rgba(255,255,255,0.2);
    }
    .customer-name {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 5px;
    }
    .customer-phone {
        font-size: 14px;
        opacity: 0.8;
    }
    .membership-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .membership-status-badge.active { background: rgba(16, 185, 129, 0.2); color: #10b981; }
    .membership-status-badge.expired { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
    .membership-status-badge.expiring { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
    
    .customer-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-top: 20px;
    }
    .customer-stat {
        background: rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 15px;
        text-align: center;
    }
    .customer-stat .stat-value {
        font-size: 20px;
        font-weight: 700;
    }
    .customer-stat .stat-label {
        font-size: 11px;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .customer-stat.highlight .stat-value { color: #10b981; }
    .customer-stat.warning .stat-value { color: #fbbf24; }
    .customer-stat.danger .stat-value { color: #f87171; }

    @@media (max-width: 768px) { 
        .info-grid { grid-template-columns: 1fr; }
        .info-grid-3 { grid-template-columns: 1fr; }
        .customer-stats { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<!-- Header -->
<div class="locker-header @statusClass">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-4">
                <div class="locker-icon">
                    <i class="fa-solid @(Model.Status == "Empty" || Model.Status == "Available" ? "fa-lock-open" : Model.Status == "Locked" ? "fa-ban" : "fa-lock")"></i>
                </div>
                <div>
                    <h1 class="locker-title">@Model.Gender Locker #@Model.LockerNumber</h1>
                    <p class="locker-subtitle mb-2">
                        <i class="fa-solid fa-@(Model.Gender == "Gents" ? "mars" : "venus") me-1"></i> @Model.Gender
                    </p>
                    <span class="status-badge-lg">
                        <i class="fa-solid @(Model.IsExpired ? "fa-exclamation-circle" : Model.IsExpiringSoon ? "fa-clock" : Model.Status == "Empty" ? "fa-check-circle" : "fa-user")"></i>
                        @if (Model.IsExpired) { @("Expired") }
                        else if (Model.IsExpiringSoon) { @("Expiring Soon") }
                        else if (Model.Status == "Locked") { @("Locked") }
                        else if (Model.Status == "Occupied") { @("Occupied") }
                        else { @("Empty") }
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="d-flex gap-2 justify-content-md-end flex-wrap">
                <a href="/Locker/Edit/@Model.LockerID" class="action-btn btn btn-light"><i class="fa-solid fa-edit"></i> Edit</a>
                @if (Model.Status != "Occupied" || string.IsNullOrEmpty(Model.AssignedTo))
                {
                    <a href="/Locker/Assign/@Model.LockerID" class="action-btn btn btn-success"><i class="fa-solid fa-user-plus"></i> Assign</a>
                }
                else
                {
                    <a href="/Locker/Renew/@Model.LockerID" class="action-btn btn btn-warning"><i class="fa-solid fa-rotate"></i> Renew</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Payment Summary (if occupied) -->
@if (Model.Status == "Occupied" && !string.IsNullOrEmpty(Model.AssignedTo))
{
    <div class="payment-summary @(Model.DueAmount > 0 ? "due" : "paid")">
        <div class="row">
            <div class="col-4">
                <div class="payment-stat total">
                    <div class="value">Rs. @Model.TotalAmount.ToString("N0")</div>
                    <div class="label">Total Amount</div>
                </div>
            </div>
            <div class="col-4">
                <div class="payment-stat paid">
                    <div class="value">Rs. @Model.PaidAmount.ToString("N0")</div>
                    <div class="label">Paid</div>
                </div>
            </div>
            <div class="col-4">
                <div class="payment-stat due">
                    <div class="value">Rs. @Model.DueAmount.ToString("N0")</div>
                    <div class="label">Due</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Customer Details Card (if found) -->
@if (customer != null)
{
    <div class="info-card mb-4">
        <div class="info-card-header member">
            <i class="fa-solid fa-user"></i>
            <h5>Member Details</h5>
            <a href="/Customers/Details/@customer.CustomerID" class="btn btn-sm btn-outline-primary ms-auto">
                <i class="fa-solid fa-external-link me-1"></i> View Full Profile
            </a>
        </div>
        <div class="info-card-body p-0">
            <div class="customer-profile-card">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-3">
                            @if (customer.Photo != null)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(customer.Photo)" class="customer-photo" alt="@customer.FullName" />
                            }
                            else
                            {
                                <div class="customer-photo-placeholder">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                            }
                            <div>
                                <h4 class="customer-name">@customer.FullName</h4>
                                <p class="customer-phone mb-2">
                                    <i class="fa-solid fa-phone me-1"></i> @(customer.Phone ?? "N/A")
                                </p>
                                @if (latestMembership != null)
                                {
                                    if (membershipIsExpired)
                                    {
                                        <span class="membership-status-badge expired">
                                            <i class="fa-solid fa-circle-xmark"></i> Membership Expired
                                        </span>
                                    }
                                    else if (membershipIsExpiringSoon)
                                    {
                                        <span class="membership-status-badge expiring">
                                            <i class="fa-solid fa-clock"></i> Expires in @membershipDaysLeft days
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="membership-status-badge active">
                                            <i class="fa-solid fa-circle-check"></i> Active Member
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                            @if (!string.IsNullOrEmpty(customer.Gender))
                            {
                                <span class="badge @(customer.Gender == "Male" ? "bg-primary" : "bg-danger") fs-6">
                                    <i class="fa-solid fa-@(customer.Gender == "Male" ? "mars" : "venus") me-1"></i>@customer.Gender
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(customer.Shift))
                            {
                                <span class="badge @(customer.Shift == "Morning" ? "bg-warning text-dark" : "bg-info") fs-6">
                                    <i class="fa-solid fa-@(customer.Shift == "Morning" ? "sun" : "moon") me-1"></i>@customer.Shift
                                </span>
                            }
                            @if (latestMembership != null)
                            {
                                <span class="badge bg-light text-dark fs-6">
                                    <i class="fa-solid fa-crown me-1 text-warning"></i>@(latestMembership.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")
                                </span>
                            }
                        </div>
                    </div>
                </div>
                
                @if (latestMembership != null)
                {
                    <div class="customer-stats">
                        <div class="customer-stat">
                            <div class="stat-value">@(latestMembership.Duration)M</div>
                            <div class="stat-label">Duration</div>
                        </div>
                        <div class="customer-stat highlight">
                            <div class="stat-value">Rs. @latestMembership.PaidPrice.ToString("N0")</div>
                            <div class="stat-label">Paid</div>
                        </div>
                        <div class="customer-stat">
                            <div class="stat-value">@latestMembership.ExpireDate.ToString("dd MMM")</div>
                            <div class="stat-label">Expiry</div>
                        </div>
                        <div class="customer-stat @(membershipIsExpired ? "danger" : membershipIsExpiringSoon ? "warning" : "highlight")">
                            <div class="stat-value">@(membershipIsExpired ? $"{Math.Abs(membershipDaysLeft)}d" : $"{membershipDaysLeft}d")</div>
                            <div class="stat-label">@(membershipIsExpired ? "Overdue" : "Left")</div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Additional Customer Info -->
            <div class="p-3">
                <div class="info-grid-3">
                    @if (!string.IsNullOrEmpty(customer.Email))
                    {
                        <div class="info-item">
                            <label>Email</label>
                            <span><i class="fa-solid fa-envelope me-1 text-muted"></i> @customer.Email</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(customer.Address))
                    {
                        <div class="info-item">
                            <label>Address</label>
                            <span><i class="fa-solid fa-location-dot me-1 text-muted"></i> @customer.Address</span>
                        </div>
                    }
                    @if (customer.JoinDate != default)
                    {
                        <div class="info-item">
                            <label>Member Since</label>
                            <span><i class="fa-solid fa-calendar-check me-1 text-muted"></i> @customer.JoinDate.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Locker Details -->
    <div class="col-lg-6">
        <div class="info-card">
            <div class="info-card-header locker">
                <i class="fa-solid fa-lock"></i>
                <h5>Locker Details</h5>
            </div>
            <div class="info-card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Locker Number</label>
                        <span>@Model.LockerNumber</span>
                    </div>
                    <div class="info-item">
                        <label>Gender</label>
                        <span class="badge @(Model.Gender == "Gents" ? "bg-primary" : "bg-danger") fs-6">
                            <i class="fa-solid fa-@(Model.Gender == "Gents" ? "mars" : "venus") me-1"></i>@Model.Gender
                        </span>
                    </div>
                    <div class="info-item">
                        <label>Status</label>
                        <span class="badge @(Model.Status == "Empty" ? "bg-success" : Model.Status == "Occupied" ? "bg-primary" : "bg-secondary") fs-6">@Model.Status</span>
                    </div>
                    <div class="info-item">
                        <label>Package</label>
                        @if (!string.IsNullOrEmpty(Model.Package))
                        {
                            <span class="package-badge">@Model.Package</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <label class="d-block text-muted small mb-1">Remarks</label>
                        <span>@Model.Remarks</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Rental Period Details -->
    <div class="col-lg-6">
        @if (Model.Status == "Occupied" && !string.IsNullOrEmpty(Model.AssignedTo))
        {
            <!-- Show simple member info if customer not found in database -->
            @if (customer == null)
            {
                <div class="info-card">
                    <div class="info-card-header member">
                        <i class="fa-solid fa-user"></i>
                        <h5>Assigned Member</h5>
                    </div>
                    <div class="info-card-body">
                        <div class="info-grid">
                            <div class="info-item">
                                <label>Member Name</label>
                                <span>@Model.AssignedTo</span>
                            </div>
                            <div class="info-item">
                                <label>Phone</label>
                                <span>
                                    @if (!string.IsNullOrEmpty(Model.AssignedPhone))
                                    {
                                        <a href="tel:@Model.AssignedPhone" class="text-decoration-none"><i class="fa-solid fa-phone me-1 text-success"></i>@Model.AssignedPhone</a>
                                    }
                                    else { @("-") }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="info-card">
                <div class="info-card-header dates">
                    <i class="fa-solid fa-calendar"></i>
                    <h5>Rental Period</h5>
                </div>
                <div class="info-card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <label>Start Date</label>
                            <span>@(Model.StartDate?.ToString("dd MMM yyyy") ?? "-")</span>
                        </div>
                        <div class="info-item">
                            <label>Expiry Date</label>
                            <span class="@(Model.IsExpired ? "danger" : Model.IsExpiringSoon ? "warning" : "")">
                                @(Model.EndDate?.ToString("dd MMM yyyy") ?? "-")
                                @if (Model.IsExpired) { <i class="fa-solid fa-exclamation-circle ms-1"></i> }
                            </span>
                        </div>
                        <div class="info-item">
                            <label>Duration</label>
                            <span>@Model.RentalMonths Month(s)</span>
                        </div>
                        <div class="info-item">
                            <label>Days Remaining</label>
                            <span class="@(Model.IsExpired ? "danger" : Model.DaysRemaining <= 7 ? "warning" : "success")">
                                @(Model.IsExpired ? "Expired" : $"{Model.DaysRemaining} days")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="info-card">
                <div class="info-card-header member">
                    <i class="fa-solid fa-user"></i>
                    <h5>Assignment</h5>
                </div>
                <div class="info-card-body text-center py-5">
                    <i class="fa-solid fa-lock-open fa-4x text-success mb-3"></i>
                    <h5>Locker Available</h5>
                    <p class="text-muted">This locker is currently available for assignment.</p>
                    <a href="/Locker/Assign/@Model.LockerID" class="btn btn-success mt-2"><i class="fa-solid fa-user-plus me-2"></i> Assign Now</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Back Button -->
<div class="mt-4">
    <a href="/Locker?gender=@Model.Gender" class="btn btn-outline-secondary btn-lg px-4">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to @Model.Gender Lockers
    </a>
</div>
