@model HighSpiritApp.Models.Locker.Locker
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var startDateValue = Model.StartDate?.ToString("yyyy-MM-dd") ?? "";
    var endDateValue = Model.EndDate?.ToString("yyyy-MM-dd") ?? "";

    var returnUrlRaw = Context.Request.Query["returnUrl"].FirstOrDefault();
    var backUrl = !string.IsNullOrEmpty(returnUrlRaw) ? Uri.UnescapeDataString(returnUrlRaw) : $"/Locker?gender={Model.Gender}";
}

<style>
    .edit-header { background: linear-gradient(135deg, @(Model.Gender == "Gents" ? "#3b82f6 0%, #2563eb" : "#ec4899 0%, #db2777") 100%); border-radius: 16px; padding: 20px 25px; color: white; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; }
    .edit-header h4 { margin: 0; font-weight: 600; display: flex; align-items: center; gap: 12px; }
    .form-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 25px; }
    .form-card-header { background: #f8fafc; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .form-card-header i { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
    .form-card-header.locker i { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; }
    .form-card-header.member i { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
    .form-card-header.payment i { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
    .form-card-header h5 { margin: 0; font-weight: 600; color: #1e293b; }
    .form-card-body { padding: 25px; }
    .form-label { font-weight: 600; color: #475569; margin-bottom: 8px; }
    .form-control, .form-select { border-radius: 10px; border: 2px solid #e2e8f0; padding: 10px 14px; }
    .form-control:focus, .form-select:focus { border-color: #8b5cf6; box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1); }
    .status-selector { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .status-option { position: relative; }
    .status-option input { position: absolute; opacity: 0; }
    .status-option label { display: flex; flex-direction: column; align-items: center; padding: 12px 8px; border: 2px solid #e2e8f0; border-radius: 12px; cursor: pointer; font-size: 12px; }
    .status-option label i { font-size: 20px; margin-bottom: 6px; }
    .status-option.empty label { background: #f0fdf4; border-color: #bbf7d0; }
    .status-option.empty label i { color: #16a34a; }
    .status-option.occupied label { background: #eff6ff; border-color: #bfdbfe; }
    .status-option.occupied label i { color: #2563eb; }
    .status-option.locked label { background: #f8fafc; border-color: #e2e8f0; }
    .status-option.locked label i { color: #64748b; }
    .status-option input:checked + label { box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3); border-color: #8b5cf6; }
    .btn-save { background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; padding: 12px 30px; font-weight: 600; border-radius: 10px; }
    @@media (max-width: 768px) { .status-selector { grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="edit-header">
    <h4><i class="fa-solid fa-edit"></i> Edit @Model.Gender Locker #@Model.LockerNumber</h4>
    <a href="@backUrl" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i> Back</a>
</div>

<form method="post">
    <input type="hidden" asp-for="LockerID" />
    <input type="hidden" asp-for="CreatedAt" />
    <input type="hidden" asp-for="Gender" />

    <div class="row">
        <div class="col-lg-8">
            <div class="form-card">
                <div class="form-card-header locker">
                    <i class="fa-solid fa-lock"></i>
                    <h5>Locker Information</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Locker Number <span class="text-danger">*</span></label>
                            <input asp-for="LockerNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Gents">Gents</option>
                                <option value="Ladies">Ladies</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Status</label>
                            <div class="status-selector">
                                <div class="status-option empty">
                                    <input type="radio" name="Status" value="Empty" id="statusEmpty" @(Model.Status == "Empty" || Model.Status == "Available" ? "checked" : "") />
                                    <label for="statusEmpty"><i class="fa-solid fa-lock-open"></i><span>Empty</span></label>
                                </div>
                                <div class="status-option occupied">
                                    <input type="radio" name="Status" value="Occupied" id="statusOccupied" @(Model.Status == "Occupied" ? "checked" : "") />
                                    <label for="statusOccupied"><i class="fa-solid fa-user-lock"></i><span>Occupied</span></label>
                                </div>
                                <div class="status-option locked">
                                    <input type="radio" name="Status" value="Locked" id="statusLocked" @(Model.Status == "Locked" ? "checked" : "") />
                                    <label for="statusLocked"><i class="fa-solid fa-ban"></i><span>Locked</span></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="form-card-header member">
                    <i class="fa-solid fa-user"></i>
                    <h5>Assigned Member</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <input asp-for="AssignedTo" class="form-control" placeholder="Member name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input asp-for="AssignedPhone" class="form-control" placeholder="Phone number" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Package</label>
                            <select asp-for="Package" class="form-select" id="packageSelect">
                                <option value="">-- Select Package --</option>
                                <optgroup label="Premium">
                                    <option value="Premium Package">Premium Package (All Facilities)</option>
                                </optgroup>
                                <optgroup label="Customized">
                                    <option value="Customized Package (Any Three)">Customized (Any 3 Facilities)</option>
                                    <option value="Customized Package (Any Two)">Customized (Any 2 Facilities)</option>
                                </optgroup>
                                <optgroup label="Single Facility">
                                    <option value="Gym Package">Gym Package</option>
                                    <option value="Zumba & Aerobics Package">Zumba & Aerobics Package</option>
                                    <option value="Cardio Package">Cardio Package</option>
                                    <option value="Sauna & Steam Package">Sauna & Steam Package</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duration (Months)</label>
                            <input asp-for="RentalMonths" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Joined Date</label>
                            <input name="StartDate" type="date" class="form-control" value="@startDateValue" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Expiry Date</label>
                            <input name="EndDate" type="date" class="form-control" value="@endDateValue" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="form-card-header payment">
                    <i class="fa-solid fa-money-bill-wave"></i>
                    <h5>Payment Details</h5>
                </div>
                <div class="form-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Total Amount (Rs.)</label>
                            <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" id="totalInput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Paid Amount (Rs.)</label>
                            <input asp-for="PaidAmount" type="number" step="0.01" class="form-control" id="paidInput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Due Amount (Rs.)</label>
                            <input asp-for="DueAmount" type="number" step="0.01" class="form-control" id="dueInput" readonly style="background: #fef2f2; color: #991b1b;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-card">
                <div class="form-card-header locker">
                    <i class="fa-solid fa-chart-pie"></i>
                    <h5>Summary</h5>
                </div>
                <div class="form-card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Locker:</span>
                        <span class="fw-bold">@Model.LockerNumber</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Gender:</span>
                        <span class="badge @(Model.Gender == "Gents" ? "bg-primary" : "bg-danger")">
                            <i class="fa-solid fa-@(Model.Gender == "Gents" ? "mars" : "venus") me-1"></i>@Model.Gender
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Status:</span>
                        <span class="badge @(Model.Status == "Empty" ? "bg-success" : Model.Status == "Occupied" ? "bg-primary" : "bg-secondary")">@Model.Status</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.AssignedTo))
                    {
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Assigned:</span>
                            <span class="fw-bold">@Model.AssignedTo</span>
                        </div>
                        @if (Model.EndDate.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Expires:</span>
                                <span class="fw-bold @(Model.IsExpired ? "text-danger" : "")">@Model.EndDate.Value.ToString("dd MMM yy")</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="form-card border-danger">
                <div class="form-card-header" style="background: #fef2f2;">
                    <i class="fa-solid fa-trash" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;"></i>
                    <h5 class="text-danger">Danger Zone</h5>
                </div>
                <div class="form-card-body">
                    <p class="text-muted small mb-3">Permanently delete this locker.</p>
                    <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="fa-solid fa-trash me-2"></i> Delete Locker
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-success btn-save btn-lg"><i class="fa-solid fa-save me-2"></i> Save Changes</button>
        <a href="@backUrl" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>
</form>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa-solid fa-trash me-2"></i>Delete Locker</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete locker <strong>@Model.LockerNumber</strong>?</p>
                <p class="text-danger"><i class="fa-solid fa-exclamation-triangle me-2"></i>This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="/Locker/Delete/@Model.LockerID" style="display:inline;">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const totalInput = document.getElementById('totalInput');
    const paidInput = document.getElementById('paidInput');
    const dueInput = document.getElementById('dueInput');

    function updateDue() {
        const total = parseFloat(totalInput.value) || 0;
        const paid = parseFloat(paidInput.value) || 0;
        dueInput.value = Math.max(0, total - paid).toFixed(2);
    }

    totalInput.addEventListener('input', updateDue);
    paidInput.addEventListener('input', updateDue);

    // Auto-select the current package in dropdown
    document.addEventListener('DOMContentLoaded', function() {
        const packageSelect = document.getElementById('packageSelect');
        const currentPackage = '@Model.Package';
        
        if (currentPackage) {
            // Try exact match first
            let found = false;
            for (let i = 0; i < packageSelect.options.length; i++) {
                if (packageSelect.options[i].value === currentPackage) {
                    packageSelect.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            
            // If no exact match, try partial matching
            if (!found) {
                const pkgLower = currentPackage.toLowerCase();
                
                if (pkgLower.includes('premium')) {
                    packageSelect.value = 'Premium Package';
                } else if (pkgLower.includes('any three') || pkgLower.includes('(any 3)') || (pkgLower.includes('custom') && pkgLower.includes('three'))) {
                    packageSelect.value = 'Customized Package (Any Three)';
                } else if (pkgLower.includes('any two') || pkgLower.includes('(any 2)') || (pkgLower.includes('custom') && pkgLower.includes('two'))) {
                    packageSelect.value = 'Customized Package (Any Two)';
                } else if (pkgLower.includes('gym') && !pkgLower.includes('custom')) {
                    packageSelect.value = 'Gym Package';
                } else if (pkgLower.includes('zumba') || pkgLower.includes('aerobics')) {
                    packageSelect.value = 'Zumba & Aerobics Package';
                } else if (pkgLower.includes('cardio') && !pkgLower.includes('custom')) {
                    packageSelect.value = 'Cardio Package';
                } else if (pkgLower.includes('sauna') || pkgLower.includes('steam')) {
                    packageSelect.value = 'Sauna & Steam Package';
                }
            }
        }
    });
</script>
