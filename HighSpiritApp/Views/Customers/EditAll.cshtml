@model HighSpiritApp.Models.CustomerEditVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Format dates properly - show empty if null or MinValue
    var dobValue = Model.DateOfBirth.HasValue && Model.DateOfBirth.Value > DateTime.MinValue
        ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd")
        : "";
    var startDateValue = Model.StartDate > DateTime.MinValue
        ? Model.StartDate.ToString("yyyy-MM-dd")
        : "";
    var expireDateValue = Model.ExpireDate.HasValue && Model.ExpireDate.Value > DateTime.MinValue
        ? Model.ExpireDate.Value.ToString("yyyy-MM-dd")
        : "";
}

<div class="card shadow">
    <div class="card-body">
        <h4>Edit Customer</h4>

        <form method="post" enctype="multipart/form-data" class="row g-3">

            <input type="hidden" asp-for="CustomerID" />
            <input type="hidden" asp-for="MembershipID" />


            <div class="col-md-6">
                <label>Name</label>
                <input asp-for="FullName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Gender</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="col-md-6">
                <label>DOB</label>
                <input name="DateOfBirth"
                       type="date"
                       class="form-control"
                       value="@dobValue" />
            </div>
            <div class="col-md-6">
                <label>Height</label>
                <input asp-for="Height" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Weight</label>
                <input asp-for="WeightKG" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Blood Group</label>
                <input asp-for="BloodGroup" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Occupation</label>
                <input asp-for="Occupation" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Shift</label>
                <select asp-for="Shift" class="form-control">
                    <option value="">-- Select Shift --</option>
                    <option value="Morning">Morning</option>
                    <option value="Evening">Evening</option>
                </select>
            </div>

            <div class="col-md-6">
                <label>Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="1"></textarea>
            </div>

            <div class="col-md-6">
                <label>Change Photo</label>
                <input type="file" name="photoFile" class="form-control" />
            </div>

            <hr />
            <h5 class="mt-3">Membership Details</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label>Plan</label>
                    <input asp-for="PlanName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Paid Price</label>
                    <input asp-for="PaidPrice"
                           type="number"
                           class="form-control"
                           placeholder="Enter paid amount" />
                </div>

                <div class="col-md-6">
                    <label>Start Date</label>
                    <input name="StartDate"
                           type="date"
                           class="form-control"
                           value="@startDateValue" />
                </div>

                <div class="col-md-6">
                    <label>Expire Date</label>
                    <input name="ExpireDate"
                           type="date"
                           class="form-control"
                           value="@expireDateValue" />
                </div>

                <input type="hidden" asp-for="MembershipID" />
                <input type="hidden" asp-for="Duration" />
            </div>


            <div class="col-12">
                <button class="btn btn-success">Save All</button>
                <a href="/Customers" class="btn btn-secondary">Back</a>
            </div>

        </form>
    </div>
</div>
