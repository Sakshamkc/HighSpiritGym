@model List<HighSpiritApp.Models.Customer>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int sn = 1;

}

<h4 class="mb-3">Members</h4>

<form method="get" class="mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="max-width:1070px;">
            <input name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name or phone"
                   autocomplete="off" />
            <input type="hidden" name="filter" value="@ViewBag.Filter" />
            <button class="btn btn-primary">
                <i class="fa-solid fa-search"></i>
            </button>
        </div>

        <a href="/Customers/ExportAll"
           class="btn btn-success btn-lg ms-auto">
            <i class="fa-solid fa-file-download"></i> Export Excel
        </a>
    </div>
</form>

<div class="mb-3">
    <div class="btn-group" role="group">
        <a class="btn @(ViewBag.Filter=="all"?"btn-primary":"btn-outline-primary")"
           href="?filter=all&duration=@ViewBag.Duration&search=@ViewBag.Search">
            All
        </a>

        <a class="btn @(ViewBag.Filter=="active"?"btn-success":"btn-outline-success")"
           href="?filter=active&duration=@ViewBag.Duration&search=@ViewBag.Search">
            Active
        </a>

        <a class="btn @(ViewBag.Filter=="expired"?"btn-danger":"btn-outline-danger")"
           href="?filter=expired&duration=@ViewBag.Duration&search=@ViewBag.Search">
            Expired
        </a>

        <a class="btn @(ViewBag.Filter=="soon"?"btn-warning":"btn-outline-warning")"
           href="?filter=soon&duration=@ViewBag.Duration&search=@ViewBag.Search">
            Expiring (7 Days)
        </a>
    </div>
</div>

<div class="mb-4 d-flex align-items-center gap-2 flex-wrap">
    <span class="text-muted fw-semibold me-2">Duration</span>

    <a class="btn btn-sm rounded-pill
       @(ViewBag.Duration==null?"btn-dark":"btn-outline-dark")"
       href="?duration=&filter=@ViewBag.Filter&search=@ViewBag.Search">
        All
    </a>

    <a class="btn btn-sm rounded-pill
       @(ViewBag.Duration==1?"btn-primary":"btn-outline-primary")"
       href="?duration=1&filter=@ViewBag.Filter&search=@ViewBag.Search">
        1M
    </a>

    <a class="btn btn-sm rounded-pill
       @(ViewBag.Duration==3?"btn-primary":"btn-outline-primary")"
       href="?duration=3&filter=@ViewBag.Filter&search=@ViewBag.Search">
        3M
    </a>

    <a class="btn btn-sm rounded-pill
       @(ViewBag.Duration==6?"btn-primary":"btn-outline-primary")"
       href="?duration=6&filter=@ViewBag.Filter&search=@ViewBag.Search">
        6M
    </a>

    <a class="btn btn-sm rounded-pill
       @(ViewBag.Duration==12?"btn-primary":"btn-outline-primary")"
       href="?duration=12&filter=@ViewBag.Filter&search=@ViewBag.Search">
        12M
    </a>
</div>




<div class="card shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>S.No</th>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Plan</th>
                    <th>Start Date</th>
                    <th>Expire Date</th>
                    <th>Shift</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Model)
                {
                    var m = c.Memberships?
                    .Where(x => x.IsActive)
                    .OrderByDescending(x => x.StartDate)
                    .FirstOrDefault();

                    <tr>
                        <td>@(sn++)</td>
                        <td>
                            @if (c.Photo != null)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(c.Photo)"
                                     class="rounded-circle"
                                     style="width:40px;height:40px;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-user-circle fa-2x text-secondary"></i>
                            }

                        </td>
                        <td>@c.FullName</td>
                        <td>@c.Phone</td>
                        <td>@m?.PlanName</td>
                        <td>
                            @if (m?.StartDate != null)
                            {
                                var d = m.StartDate;
                                string suffix =
                                d.Day % 10 == 1 && d.Day != 11 ? "st" :
                                d.Day % 10 == 2 && d.Day != 12 ? "nd" :
                                d.Day % 10 == 3 && d.Day != 13 ? "rd" : "th";

                                @($"{d.Day}{suffix} {d:MMMM yyyy}")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>
                            @if (m?.ExpireDate != null)
                            {
                                var d = m.ExpireDate.Value;
                                string suffix =
                                d.Day % 10 == 1 && d.Day != 11 ? "st" :
                                d.Day % 10 == 2 && d.Day != 12 ? "nd" :
                                d.Day % 10 == 3 && d.Day != 13 ? "rd" : "th";

                                @($"{d.Day}{suffix} {d:MMMM yyyy}")
                            }
                            else
                            {
                                @("-")
                            }
                    </td>
                    <td>@(string.IsNullOrEmpty(c.Shift) ? "-" : c.Shift)</td>
                    <td title="@c.Remarks">
                        @(string.IsNullOrEmpty(c.Remarks)
                                                ? "-"
                                                : (c.Remarks.Length > 20 ? c.Remarks.Substring(0, 20) + "..." : c.Remarks))
                        </td>

                        <td>
                            @if (m != null && m.DueDaysComputed > 0)
                            {
                                <span class="badge bg-danger">Due @m.DueDaysComputed days</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="/Customers/Details/@c.CustomerID">View</a>
                            <a class="btn btn-sm btn-secondary"
                               href="/Customers/EditAll/@c.CustomerID">
                                Edit
                            </a>
                            @if (m != null)
                            {
                                <a class="btn btn-sm btn-success"
                                   href="/Memberships/Renew/@c.CustomerID">
                                    Renew
                                </a>

                            }

                            <button class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#delModal_@c.CustomerID">
                                Delete
                            </button>

                            <div class="modal fade" id="delModal_@c.CustomerID" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5>Confirm Delete</h5>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete <b>@c.FullName</b>?
                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <a class="btn btn-danger" href="/Customers/Delete/@c.CustomerID">Yes, Delete</a>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav class="mt-3">
            @{
                int current = ViewBag.Page;
                int total = ViewBag.TotalPages;

                int start = Math.Max(1, current - 2);
                int end = Math.Min(total, current + 2);
            }

            <ul class="pagination justify-content-center">

                @* Previous *@
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="?page=@(current - 1)&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter">
                        Prev
                    </a>
                </li>

                @* First page *@
                @if (start > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="?page=1&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter">1</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                }

                @* Middle pages *@
                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link"
                           href="?page=@i&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter">
                            @i
                        </a>
                    </li>
                }

                @* Last page *@
                @if (end < total)
                {
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           href="?page=@total&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter">
                            @total
                        </a>
                    </li>
                }

                @* Next *@
                <li class="page-item @(current == total ? "disabled" : "")">
                    <a class="page-link"
                       href="?page=@(current + 1)&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter">
                        Next
                    </a>
                </li>

            </ul>
        </nav>


    </div>
</div>

<script>
    const searchBox = document.querySelector('input[name="search"]');

    searchBox.addEventListener('input', function () {
        if (this.value.trim() === '') {
            const url = new URL(window.location.href);
            url.searchParams.delete('search');
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }
    });
</script>

