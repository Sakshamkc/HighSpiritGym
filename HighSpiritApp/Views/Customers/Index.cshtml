@model List<HighSpiritApp.Models.Customer>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int sn = 1;
    var skippedUsersRaw = TempData["skippedUsers"] as string;
    var skippedUsers = !string.IsNullOrEmpty(skippedUsersRaw) 
        ? skippedUsersRaw.Split("||").ToList() 
        : new List<string>();
    
    // Helper function to shorten plan names
    string ShortenPlan(string? planName)
    {
        if (string.IsNullOrEmpty(planName)) return "-";
        
        // Map long names to short codes
        var plan = planName
            .Replace("Premium Package", "Premium")
            .Replace("Customized Package (Any Three):", "Custom-3:")
            .Replace("Customized Package (Any Three)", "Custom-3")
            .Replace("Customized Package (Any Two):", "Custom-2:")
            .Replace("Customized Package (Any Two)", "Custom-2")
            .Replace("Zumba & Aerobics Package", "Zumba")
            .Replace("Sauna & Steam Package", "Sauna/Steam")
            .Replace("Gym Package", "Gym")
            .Replace("Cardio Package", "Cardio")
            .Replace("Zumba/Aerobics/Yoga", "Zumba")
            .Replace("Steam/Sauna", "Steam");
        
        // Truncate if still too long
        return plan.Length > 25 ? plan.Substring(0, 22) + "..." : plan;
    }
    
    // Helper to get current membership - get latest by StartDate (no IsActive filter)
    HighSpiritApp.Models.CustomerMembership? GetCurrentMembership(HighSpiritApp.Models.Customer c)
    {
        return c.Memberships?
            .OrderByDescending(x => x.StartDate)
            .FirstOrDefault();
    }
}

<h4 class="mb-3">Members</h4>

<!-- Skipped Users Modal -->
@if (skippedUsers.Any())
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>⚠️ @skippedUsers.Count user(s) were skipped during import.</strong>
        <button type="button" class="btn btn-sm btn-outline-dark ms-2" data-bs-toggle="modal" data-bs-target="#skippedModal">
            View Details
        </button>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <div class="modal fade" id="skippedModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">⚠️ Skipped Users During Import</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-striped table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < skippedUsers.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@skippedUsers[i]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Auto-open modal on page load -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var skippedModal = new bootstrap.Modal(document.getElementById('skippedModal'));
            skippedModal.show();
        });
    </script>
}

<form method="get" class="mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="max-width:1070px;">
            <input name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name or phone"
                   autocomplete="off" />
            <input type="hidden" name="filter" value="@ViewBag.Filter" />
            <input type="hidden" name="planName" value="@ViewBag.PlanName" />
            <button class="btn btn-primary">
                <i class="fa-solid fa-search"></i>
            </button>
        </div>

        <a href="/Customers/ExportAll?search=@ViewBag.Search&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName"
           class="btn btn-success btn-lg ms-auto">
            <i class="fa-solid fa-file-download"></i> Export Excel
        </a>
    </div>
</form>

<!-- Duration Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg">
        <a href="?duration=&filter=@ViewBag.Filter&search=@ViewBag.Search&planName=@ViewBag.PlanName" class="text-decoration-none">
            <div class="card shadow-sm @(ViewBag.Duration == null ? "border-dark border-2" : "")">
                <div class="card-body text-center py-3">
                    <div class="fs-3 fw-bold text-dark">@ViewBag.CountAll</div>
                    <div class="text-muted small">All Members</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <a href="?duration=1&filter=@ViewBag.Filter&search=@ViewBag.Search&planName=@ViewBag.PlanName" class="text-decoration-none">
            <div class="card shadow-sm @(ViewBag.Duration == 1 ? "border-primary border-2" : "")">
                <div class="card-body text-center py-3">
                    <div class="fs-3 fw-bold text-primary">@ViewBag.Count1M</div>
                    <div class="text-muted small">1 Month</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <a href="?duration=3&filter=@ViewBag.Filter&search=@ViewBag.Search&planName=@ViewBag.PlanName" class="text-decoration-none">
            <div class="card shadow-sm @(ViewBag.Duration == 3 ? "border-success border-2" : "")">
                <div class="card-body text-center py-3">
                    <div class="fs-3 fw-bold text-success">@ViewBag.Count3M</div>
                    <div class="text-muted small">3 Months</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <a href="?duration=6&filter=@ViewBag.Filter&search=@ViewBag.Search&planName=@ViewBag.PlanName" class="text-decoration-none">
            <div class="card shadow-sm @(ViewBag.Duration == 6 ? "border-warning border-2" : "")">
                <div class="card-body text-center py-3">
                    <div class="fs-3 fw-bold text-warning">@ViewBag.Count6M</div>
                    <div class="text-muted small">6 Months</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <a href="?duration=12&filter=@ViewBag.Filter&search=@ViewBag.Search&planName=@ViewBag.PlanName" class="text-decoration-none">
            <div class="card shadow-sm @(ViewBag.Duration == 12 ? "border-danger border-2" : "")">
                <div class="card-body text-center py-3">
                    <div class="fs-3 fw-bold text-danger">@ViewBag.Count12M</div>
                    <div class="text-muted small">12 Months</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-2 gap-md-3 mb-3">
    <div class="btn-group" role="group">
        <a class="btn @(ViewBag.Filter=="all"?"btn-primary":"btn-outline-primary")"
           href="?filter=all&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=@ViewBag.PlanName">
            All
        </a>

        <a class="btn @(ViewBag.Filter=="active"?"btn-success":"btn-outline-success")"
           href="?filter=active&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=@ViewBag.PlanName">
            Active
        </a>

        <a class="btn @(ViewBag.Filter=="expired"?"btn-danger":"btn-outline-danger")"
           href="?filter=expired&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=@ViewBag.PlanName">
            Expired
        </a>

        <a class="btn @(ViewBag.Filter=="soon"?"btn-warning":"btn-outline-warning")"
           href="?filter=soon&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=@ViewBag.PlanName">
            Expiring (7 Days)
        </a>
    </div>
    
    <!-- Plan Name Filter Dropdown -->
    <div class="dropdown">
        <button class="btn @(!string.IsNullOrEmpty((string)ViewBag.PlanName) ? "btn-info" : "btn-outline-info") dropdown-toggle" 
                type="button" data-bs-toggle="dropdown">
            <i class="fa-solid fa-box me-1"></i>
            @(string.IsNullOrEmpty((string)ViewBag.PlanName) ? "All Plans" : ViewBag.PlanName)
        </button>
        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item @(string.IsNullOrEmpty((string)ViewBag.PlanName) ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search">
                    <i class="fa-solid fa-list me-2"></i>All Plans
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Premium" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Premium">
                    <i class="fa-solid fa-crown me-2 text-warning"></i>Premium Package
                </a>
            </li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Gym" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Gym">
                    <i class="fa-solid fa-dumbbell me-2 text-primary"></i>Gym Package
                </a>
            </li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Cardio" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Cardio">
                    <i class="fa-solid fa-heart-pulse me-2 text-danger"></i>Cardio Package
                </a>
            </li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Customized" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Customized">
                    <i class="fa-solid fa-sliders me-2 text-success"></i>Customized Package
                </a>
            </li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Zumba" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Zumba">
                    <i class="fa-solid fa-music me-2 text-info"></i>Zumba & Aerobics
                </a>
            </li>
            <li>
                <a class="dropdown-item @(ViewBag.PlanName == "Sauna" ? "active" : "")" 
                   href="?filter=@ViewBag.Filter&duration=@ViewBag.Duration&search=@ViewBag.Search&planName=Sauna">
                    <i class="fa-solid fa-hot-tub-person me-2 text-secondary"></i>Sauna & Steam
                </a>
            </li>
        </ul>
    </div>
</div>

<style>
    .price-cell {
        font-weight: 600;
        color: #059669;
        white-space: nowrap;
    }
    .price-cell .currency {
        font-size: 11px;
        font-weight: 500;
        color: #64748b;
    }
    .due-cell {
        font-weight: 600;
        white-space: nowrap;
    }
    .due-cell.has-due {
        color: #dc2626;
    }
    .due-cell.no-due {
        color: #16a34a;
    }
    .due-cell .currency {
        font-size: 11px;
        font-weight: 500;
    }
</style>

<div class="card shadow">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>S.No</th>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Plan</th>
                    <th>Paid</th>
                    <th>Due</th>
                    <th>Start</th>
                    <th>Expire</th>
                    <th>Shift</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Model)
                {
                    // Get current membership - prioritize by ExpireDate (latest = current)
                    var m = GetCurrentMembership(c);

                    <tr>
                        <td>@(sn++)</td>
                        <td>
                            @if (c.Photo != null)
                            {
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(c.Photo)"
                                     class="rounded-circle"
                                     style="width:40px;height:40px;object-fit:cover;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-user-circle fa-2x text-secondary"></i>
                            }
                        </td>
                        <td class="fw-semibold">@c.FullName</td>
                        <td>@c.Phone</td>
                        <td>
                            <span class="badge bg-secondary" title="@m?.PlanName">
                                @ShortenPlan(m?.PlanName)
                            </span>
                        </td>
                        <td class="price-cell">
                            @if (m != null)
                            {
                                <span class="currency">Rs.</span> @m.PaidPrice.ToString("N0")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="due-cell @(m != null && m.DueAmount > 0 ? "has-due" : "no-due")">
                            @if (m != null)
                            {
                                if (m.DueAmount > 0)
                                {
                                    <span class="currency">Rs.</span> @m.DueAmount.ToString("N0")
                                    <i class="fa-solid fa-exclamation-circle ms-1" title="Payment pending"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check-circle" title="Fully paid"></i>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (m?.StartDate != null)
                            {
                                @m.StartDate.ToString("dd MMM yy")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>
                            @if (m?.ExpireDate != null)
                            {
                                @m.ExpireDate.ToString("dd MMM yy")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.Shift))
                            {
                                <span class="badge @(c.Shift == "Morning" ? "bg-warning text-dark" : "bg-info")">
                                    @c.Shift
                                </span>
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>
                            @if (m != null && m.DueDaysComputed > 0)
                            {
                                <span class="badge bg-danger">Due @m.DueDaysComputed d</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" href="/Customers/Details/@c.CustomerID" title="View">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a class="btn btn-outline-secondary" href="/Customers/EditAll/@c.CustomerID" title="Edit">
                                    <i class="fa-solid fa-edit"></i>
                                </a>
                                @if (m != null)
                                {
                                    <a class="btn btn-outline-success" href="/Memberships/Renew/@c.CustomerID" title="Renew">
                                        <i class="fa-solid fa-rotate"></i>
                                    </a>
                                }
                                <button class="btn btn-outline-danger" data-bs-toggle="modal" 
                                        data-bs-target="#delModal_@c.CustomerID" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>

                            <div class="modal fade" id="delModal_@c.CustomerID" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5>Confirm Delete</h5>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete <b>@c.FullName</b>?
                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <a class="btn btn-danger" href="/Customers/Delete/@c.CustomerID">Yes, Delete</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav class="mt-3">
            @{
                int current = ViewBag.Page;
                int total = ViewBag.TotalPages;
                int start = Math.Max(1, current - 2);
                int end = Math.Min(total, current + 2);
            }

            <ul class="pagination justify-content-center">
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(current - 1)&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName">
                        Prev
                    </a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=1&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName">1</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName">@i</a>
                    </li>
                }

                @if (end < total)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                    <li class="page-item">
                        <a class="page-link" href="?page=@total&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName">@total</a>
                    </li>
                }

                <li class="page-item @(current == total ? "disabled" : "")">
                    <a class="page-link" href="?page=@(current + 1)&search=@ViewBag.Search&sort=@ViewBag.Sort&filter=@ViewBag.Filter&duration=@ViewBag.Duration&planName=@ViewBag.PlanName">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    const searchBox = document.querySelector('input[name="search"]');
    searchBox.addEventListener('input', function () {
        if (this.value.trim() === '') {
            const url = new URL(window.location.href);
            url.searchParams.delete('search');
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }
    });
</script>

