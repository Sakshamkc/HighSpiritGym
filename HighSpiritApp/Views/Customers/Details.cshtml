        color: #d97706;
    }

    /* Locker Card Styles */
    .locker-highlight {
        background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
        border: 1px solid #c4b5fd;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .locker-highlight.expired {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fecaca;
    }

    .locker-highlight.expiring {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fde68a;
    }

    .locker-number-display {
        font-size: 48px;
        font-weight: 700;
        color: #7c3aed;
    }

    .locker-number-display i {
        font-size: 32px;
        margin-right: 8px;
    }

    .locker-highlight.expired .locker-number-display {
        color: #dc2626;
    }

    .locker-highlight.expiring .locker-number-display {
        color: #d97706;
    }

    .history-table {
        width: 100%;
    }

    .history-table th {
        background: #f1f5f9;
        padding: 12px 15px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }

    .history-table td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .history-table tr:last-child td {
        border-bottom: none;
    }

    .history-table .plan-badge {
        display: inline-block;
        padding: 4px 12px;
        background: #e0e7ff;
        color: #4338ca;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .history-table .price {
        font-weight: 700;
        color: #059669;
    }

    .history-table .duration-badge {
        display: inline-block;
        padding: 4px 10px;
        background: #f1f5f9;
        color: #475569;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .history-table .current-tag {
        display: inline-block;
        padding: 2px 8px;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        margin-left: 8px;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .info-grid-2 {
            grid-template-columns: 1fr;
        }

        .profile-header .row {
            text-align: center;
        }

        .profile-header .col-md-8 {
            margin-top: 20px;
        }
    }

    @@media (max-width: 576px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Profile Header -->
<div class="profile-header">
    <div class="row align-items-center">
        <div class="col-md-4 text-center text-md-start">
            @if (Model.Photo != null)
            {
                <a href="@Url.Action("Photo", "Customers", new { id = Model.CustomerID })" target="_blank">
                    <img src="@Url.Action("Photo", "Customers", new { id = Model.CustomerID })" class="profile-photo"
                         alt="@Model.FullName" />
                </a>
            }
            else
            {
                <div class="profile-photo-placeholder">
                    <i class="fa-solid fa-user"></i>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start justify-content-between">
                <div class="text-center text-md-start mb-3 mb-md-0">
                    <h1 class="profile-name">@Model.FullName</h1>
                    <p class="profile-phone mb-2">
                        <i class="fa-solid fa-phone"></i> @(Model.Phone ?? "N/A")
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <span class="ms-3"><i class="fa-solid fa-envelope"></i> @Model.Email</span>
                        }
                    </p>
                    @if (latestMembership != null)
                    {
                        if (isOnHold)
                        {
                            <span class="status-badge"
                                  style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white;">
                                <i class="fa-solid fa-pause-circle"></i> On Hold — @holdDays day(s)
                            </span>
                        }
                        else if (isExpired)
                        {
                            <span class="status-badge status-expired">
                                <i class="fa-solid fa-circle-xmark"></i> Expired @Math.Abs(daysLeft) days ago
                            </span>
                        }
                        else if (isExpiringSoon)
                        {
                            <span class="status-badge status-expiring">
                                <i class="fa-solid fa-clock"></i> Expires in @daysLeft days
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-active">
                                <i class="fa-solid fa-circle-check"></i> Active - @daysLeft days left
                            </span>
                        }
                    }
                </div>
                <div class="d-flex gap-2 flex-wrap justify-content-center">
                    <a href="/Customers/EditAll/@Model.CustomerID@(encodedReturnUrl != "" ? "?returnUrl=" + encodedReturnUrl : "")"
                       class="action-btn btn btn-light">
                        <i class="fa-solid fa-edit"></i> Edit
                    </a>
                    <a href="/Memberships/Renew/@Model.CustomerID@(encodedReturnUrl != "" ? "?returnUrl=" + encodedReturnUrl : "")"
                       class="action-btn btn btn-success">
                        <i class="fa-solid fa-rotate"></i> Renew
                    </a>
                    @if (latestMembership != null && !isExpired)
                    {
                        if (isOnHold)
                        {
                            <button type="button" class="action-btn btn btn-info"
                                    onclick="confirmResume(@latestMembership.MembershipID)">
                                <i class="fa-solid fa-play-circle"></i> Resume
                            </button>
                        }
                        else
                        {
                            <button type="button" class="action-btn btn btn-warning"
                                    onclick="confirmHold(@latestMembership.MembershipID)">
                                <i class="fa-solid fa-pause-circle"></i> Hold
                            </button>
                        }
                    }
                    @if (assignedLocker != null)
                    {
                        <a href="/Locker/Details/@assignedLocker.LockerID" class="action-btn btn btn-info">
                            <i class="fa-solid fa-lock"></i> Locker #@assignedLocker.LockerNumber
                        </a>
                    }
                    else
                    {
                        <a href="/Locker/ChooseLocker?customerId=@Model.CustomerID" class="action-btn btn btn-warning">
                            <i class="fa-solid fa-lock-open"></i> Assign Locker
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Membership Highlight -->
@if (latestMembership != null)
{
    <div class="membership-highlight @(isOnHold ? "" : isExpired ? "expired" : isExpiringSoon ? "expiring" : "")" @(isOnHold
             ? "style=\"border-left: 5px solid #f59e0b;\"" : "")>
        <div class="row">
            <div class="col-6 col-md-3">
                <div class="membership-stat">
                    <div class="value">@(latestMembership.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")
                    </div>
                    <div class="label">Current Plan</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="membership-stat highlight">
                    <div class="value">Rs. @latestMembership.PaidPrice.ToString("N0")</div>
                    <div class="label">Paid Amount</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="membership-stat">
                    <div class="value">@FormatDate(latestMembership.ExpireDate)</div>
                    <div class="label">Expire Date</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div
                    class="membership-stat @(isOnHold ? "" : isExpired ? "expired" : isExpiringSoon ? "expiring" : "highlight")">
                    <div class="value">
                        @if (isOnHold)
                        {
                            <i class="fa-solid fa-pause-circle" style="color: #f59e0b;"></i> <span
                            style="color: #f59e0b;">Hold</span>
                        }
                        else if (isExpired)
                        {
                            @($"{Math.Abs(daysLeft)} days")
                        }
                        else
                        {
                            @($"{daysLeft} days")
                        }
                    </div>
                    <div class="label">@(isOnHold ? $"Held {holdDays} day(s)" : isExpired ? "Overdue" : "Remaining")</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Locker Details Card (if assigned) -->
@if (assignedLocker != null)
{
    <div class="locker-highlight @(lockerIsExpired ? "expired" : lockerIsExpiringSoon ? "expiring" : "")">
        <div class="row align-items-center">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <div class="locker-number-display">
                    <i class="fa-solid fa-lock"></i>#@assignedLocker.LockerNumber
                </div>
                <span class="badge @(assignedLocker.Gender == "Gents" ? "bg-primary" : "bg-danger") fs-6">
                    <i
                    class="fa-solid fa-@(assignedLocker.Gender == "Gents" ? "mars" : "venus") me-1"></i>@assignedLocker.Gender
                </span>
            </div>
            <div class="col-md-9">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="membership-stat">
                            <div class="value">@(assignedLocker.RentalMonths)M</div>
                            <div class="label">Duration</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat">
                            <div class="value">@(assignedLocker.EndDate?.ToString("dd MMM") ?? "-")</div>
                            <div class="label">Expiry</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat highlight">
                            <div class="value">Rs. @assignedLocker.PaidAmount.ToString("N0")</div>
                            <div class="label">Paid</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat @(assignedLocker.DueAmount > 0 ? "expired" : "highlight")">
                            <div class="value">
                                @if (assignedLocker.DueAmount > 0)
                                {
                                    @($"Rs. {assignedLocker.DueAmount:N0}")
                                }
                                else
                                {
                                    <i class="fa-solid fa-check-circle"></i>
                                }
                            </div>
                            <div class="label">@(assignedLocker.DueAmount > 0 ? "Due" : "Paid")</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3 justify-content-center justify-content-md-start">
                    <a href="/Locker/Details/@assignedLocker.LockerID" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-eye me-1"></i> View Locker
                    </a>
                    <a href="/Locker/Renew/@assignedLocker.LockerID" class="btn btn-sm btn-outline-success">
                        <i class="fa-solid fa-rotate me-1"></i> Renew Locker
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Personal Details -->
    <div class="col-lg-6">
        <div class="info-card">
            <div class="info-card-header personal">
                <i class="fa-solid fa-user"></i>
                <h5>Personal Information</h5>
            </div>
            <div class="info-card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Gender</label>
                        <span>@(Model.Gender ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Date of Birth</label>
                        <span>@FormatDateLong(Model.DateOfBirth)</span>
                    </div>
                    <div class="info-item">
                        <label>Join Date</label>
                        <span>@FormatDateLong(Model.JoinDate)</span>
                    </div>
                    <div class="info-item">
                        <label>Blood Group</label>
                        <span>@(Model.BloodGroup ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Height</label>
                        <span>@(Model.Height ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Weight</label>
                        <span>@(Model.WeightKG.HasValue ? Model.WeightKG.Value.ToString() + " kg" : "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Occupation</label>
                        <span>@(Model.Occupation ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Shift</label>
                        <span>
                            @if (!string.IsNullOrEmpty(Model.Shift))
                            {
                                <span class="badge @(Model.Shift == "Morning" ? "bg-warning text-dark" : "bg-info")">
                                    <i class="fa-solid @(Model.Shift == "Morning" ? "fa-sun" : "fa-moon") me-1"></i>
                                    @Model.Shift
                                </span>
                            }
                            else
                            {
                                @("-")
                            }
                        </span>
                    </div>
                    <div class="info-item">
                        <label>Address</label>
                        <span>@(Model.Address ?? "-")</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <label class="d-block text-muted small mb-1">Remarks</label>
                        <span>@Model.Remarks</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Membership History -->
    <div class="col-lg-6">
        <div class="info-card">
            <div class="info-card-header history">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <h5>Membership History</h5>
            </div>
            <div class="info-card-body p-0">
                @if (Model.Memberships != null && Model.Memberships.Any())
                {
                    <div class="table-responsive">
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>Plan</th>
                                    <th>Amount</th>
                                    <th>Period</th>
                                    <th>Duration</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var history in Model.Memberships.OrderByDescending(x => x.StartDate))
                                {
                                    var isCurrent = history.MembershipID == latestMembership?.MembershipID;
                                    <tr>
                                        <td>
                                            <span class="plan-badge">
                                                @(history.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")
                                            </span>
                                            @if (isCurrent)
                                            {
                                                <span class="current-tag">Current</span>
                                            }
                                            @if (history.IsOnHold)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">
                                                    <i class="fa-solid fa-pause"></i> Hold
                                                </span>
                                            }
                                            else if (history.TotalHoldDays > 0)
                                            {
                                                <span class="badge bg-light text-muted ms-1" style="font-size: 10px;"
                                                      title="Was held for @history.TotalHoldDays day(s)">
                                                    <i class="fa-solid fa-pause"></i> +@history.TotalHoldDays d
                                                </span>
                                            }
                                        </td>
                                        <td class="price">Rs. @history.PaidPrice.ToString("N0")</td>
                                        <td>
                                            <small class="text-muted">
                                                @FormatDate(history.StartDate) - @FormatDate(history.ExpireDate)
                                            </small>
                                        </td>
                                        <td>
                                            <span class="duration-badge">@history.Duration M</span>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 px-2 py-1"
                                                    title="Delete this membership record"
                                                    onclick="confirmDeleteMembership(@history.MembershipID, '@(history.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")', 'Rs. @history.PaidPrice.ToString("N0")', '@FormatDate(history.StartDate)')">
                                                <i class="fa-solid fa-trash-can" style="font-size: 12px;"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No membership history found</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Back Button -->
<div class="mt-4">
    <a href="@backUrl" class="btn btn-outline-secondary btn-lg px-4">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Members
    </a>
</div>

<!-- Delete Membership Confirmation Modal -->
<div class="modal fade" id="deleteMembershipModal" tabindex="-1" aria-labelledby="deleteMembershipModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="deleteMembershipModalLabel">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Delete Membership
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-muted mb-3">Are you sure you want to delete this membership record? This action cannot be
                    undone.</p>
                    <div class="p-3 rounded-3"
                         style="background: rgba(220, 53, 69, 0.08); border: 1px solid rgba(220, 53, 69, 0.15);">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted">Plan</small>
                            <strong id="deletePlanName"></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted">Amount</small>
                            <strong id="deleteAmount"></strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">Start Date</small>
                            <strong id="deleteStartDate"></strong>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteMembershipForm" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash-can me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function confirmDeleteMembership(membershipId, planName, amount, startDate) {
            document.getElementById('deletePlanName').textContent = planName;
            document.getElementById('deleteAmount').textContent = amount;
            document.getElementById('deleteStartDate').textContent = startDate;
            document.getElementById('deleteMembershipForm').action = '/Memberships/Delete?id=' + membershipId + '&customerId=@Model.CustomerID';
            var modal = new bootstrap.Modal(document.getElementById('deleteMembershipModal'));
            modal.show();
        }

        function confirmHold(membershipId) {
            document.getElementById('holdMembershipForm').action = '/Memberships/Hold?id=' + membershipId + '&customerId=@Model.CustomerID';
            var modal = new bootstrap.Modal(document.getElementById('holdMembershipModal'));
            modal.show();
        }

        function confirmResume(membershipId) {
            document.getElementById('resumeMembershipForm').action = '/Memberships/Resume?id=' + membershipId + '&customerId=@Model.CustomerID';
            var modal = new bootstrap.Modal(document.getElementById('resumeMembershipModal'));
            modal.show();
        }
    </script>

    <!-- Hold Membership Confirmation Modal -->
    <div class="modal fade" id="holdMembershipModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-pause-circle text-warning me-2"></i>Hold Membership
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="text-muted mb-3">Are you sure you want to put this membership on hold?</p>
                    <div class="p-3 rounded-3"
                         style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-info-circle text-warning"></i>
                            <strong>What happens when you hold?</strong>
                        </div>
                        <ul class="mb-0 small text-muted" style="padding-left: 20px;">
                            <li>The membership timer pauses from today</li>
                            <li>When resumed, the expire date will be extended by the number of days held</li>
                            <li>The member won't appear in expired notifications</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="holdMembershipForm" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-warning">
                            <i class="fa-solid fa-pause-circle me-1"></i>Hold Membership
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Resume Membership Confirmation Modal -->
    <div class="modal fade" id="resumeMembershipModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-play-circle text-info me-2"></i>Resume Membership
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="text-muted mb-3">Resume this membership? The expire date will be extended by the hold
                        duration.</p>
                        @if (isOnHold && latestMembership != null)
                        {
                            <div class="p-3 rounded-3"
                                 style="background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.2);">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Hold started</small>
                                    <strong>@FormatDate(latestMembership.HoldStartDate!.Value)</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Days on hold</small>
                                    <strong>@holdDays day(s)</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Current expire date</small>
                                    <strong>@FormatDate(latestMembership.ExpireDate)</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">New expire date</small>
                                    <strong class="text-success">@FormatDate(latestMembership.ExpireDate.AddDays(holdDays))</strong>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form id="resumeMembershipForm" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-info text-white">
                                <i class="fa-solid fa-play-circle me-1"></i>Resume Membership
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>