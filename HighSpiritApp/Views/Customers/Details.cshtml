    }

    .membership-stat {
        text-align: center;
    }

    .membership-stat .value {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
    }

    .membership-stat .label {
        font-size: 13px;
        color: #64748b;
    }

    .membership-stat.highlight .value {
        color: #059669;
    }

    .membership-stat.expired .value {
