@model HighSpiritApp.Models.Customer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateTime.Today;
    
    // Get the CURRENT membership - get latest by StartDate (no IsActive filter)
    var latestMembership = Model.Memberships?
        .OrderByDescending(x => x.StartDate)
        .FirstOrDefault();
    
    var isExpired = latestMembership != null && latestMembership.ExpireDate < today;
    var isExpiringSoon = latestMembership != null && latestMembership.ExpireDate >= today && latestMembership.ExpireDate <= today.AddDays(7);
    var daysLeft = latestMembership != null ? (latestMembership.ExpireDate - today).Days : 0;
    
    // Locker info
    var assignedLocker = ViewBag.AssignedLocker as HighSpiritApp.Models.Locker.Locker;
    var lockerIsExpired = assignedLocker != null && assignedLocker.EndDate < today;
    var lockerIsExpiringSoon = assignedLocker != null && assignedLocker.EndDate >= today && assignedLocker.EndDate <= today.AddDays(7);
    var lockerDaysLeft = assignedLocker != null && assignedLocker.EndDate.HasValue ? (assignedLocker.EndDate.Value - today).Days : 0;
    
    string FormatDate(DateTime date)
    {
        return date.ToString("dd MMM yyyy");
    }
    
    string FormatDateLong(DateTime? date)
    {
        if (!date.HasValue || date.Value.Year < 1900) return "-";
        var d = date.Value;
        string suffix = d.Day % 10 == 1 && d.Day != 11 ? "st" :
                       d.Day % 10 == 2 && d.Day != 12 ? "nd" :
                       d.Day % 10 == 3 && d.Day != 13 ? "rd" : "th";
        return $"{d.Day}{suffix} {d:MMMM yyyy}";
    }
}

<style>
    .profile-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 20px;
        padding: 30px;
        color: white;
        margin-bottom: 25px;
    }
    .profile-photo {
        width: 150px;
        height: 150px;
        border-radius: 20px;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,0.2);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .profile-photo-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 20px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        color: white;
        border: 4px solid rgba(255,255,255,0.2);
    }
    .profile-name {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 5px;
    }
    .profile-phone {
        font-size: 16px;
        opacity: 0.8;
    }
    .profile-phone i {
        margin-right: 8px;
    }
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
    }
    .status-active {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }
    .status-expired {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }
    .status-expiring {
        background: rgba(245, 158, 11, 0.2);
        color: #f59e0b;
    }
    .action-btn {
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .action-btn:hover {
        transform: translateY(-2px);
    }

    .info-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }
    .info-card-header {
        background: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .info-card-header i {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .info-card-header.personal i {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }
    .info-card-header.membership i {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    .info-card-header.history i {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
    }
    .info-card-header.locker i {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
    }
    .info-card-header h5 {
        margin: 0;
        font-weight: 600;
        color: #1e293b;
    }
    .info-card-body {
        padding: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    .info-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .info-item {
        padding: 15px;
        background: #f8fafc;
        border-radius: 12px;
    }
    .info-item label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 5px;
    }
    .info-item span {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
    }
    .info-item span.text-danger { color: #dc2626 !important; }
    .info-item span.text-success { color: #16a34a !important; }
    .info-item span.text-warning { color: #d97706 !important; }

    .membership-highlight {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border: 1px solid #bbf7d0;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
    }
    .membership-highlight.expired {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fecaca;
    }
    .membership-highlight.expiring {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fde68a;
    }
    .membership-stat {
        text-align: center;
    }
    .membership-stat .value {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
    }
    .membership-stat .label {
        font-size: 13px;
        color: #64748b;
    }
    .membership-stat.highlight .value {
        color: #059669;
    }
    .membership-stat.expired .value {
        color: #dc2626;
    }
    .membership-stat.expiring .value {
        color: #d97706;
    }

    /* Locker Card Styles */
    .locker-highlight {
        background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
        border: 1px solid #c4b5fd;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
    }
    .locker-highlight.expired {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fecaca;
    }
    .locker-highlight.expiring {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-color: #fde68a;
    }
    .locker-number-display {
        font-size: 48px;
        font-weight: 700;
        color: #7c3aed;
    }
    .locker-number-display i {
        font-size: 32px;
        margin-right: 8px;
    }
    .locker-highlight.expired .locker-number-display {
        color: #dc2626;
    }
    .locker-highlight.expiring .locker-number-display {
        color: #d97706;
    }

    .history-table {
        width: 100%;
    }
    .history-table th {
        background: #f1f5f9;
        padding: 12px 15px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    .history-table td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .history-table tr:last-child td {
        border-bottom: none;
    }
    .history-table .plan-badge {
        display: inline-block;
        padding: 4px 12px;
        background: #e0e7ff;
        color: #4338ca;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .history-table .price {
        font-weight: 700;
        color: #059669;
    }
    .history-table .duration-badge {
        display: inline-block;
        padding: 4px 10px;
        background: #f1f5f9;
        color: #475569;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }
    .history-table .current-tag {
        display: inline-block;
        padding: 2px 8px;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        margin-left: 8px;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .info-grid-2 {
            grid-template-columns: 1fr;
        }
        .profile-header .row {
            text-align: center;
        }
        .profile-header .col-md-8 {
            margin-top: 20px;
        }
    }
    @@media (max-width: 576px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Profile Header -->
<div class="profile-header">
    <div class="row align-items-center">
        <div class="col-md-4 text-center text-md-start">
            @if (Model.Photo != null)
            {
                <img src="data:image/png;base64,@Convert.ToBase64String(Model.Photo)" class="profile-photo" alt="@Model.FullName" />
            }
            else
            {
                <div class="profile-photo-placeholder">
                    <i class="fa-solid fa-user"></i>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start justify-content-between">
                <div class="text-center text-md-start mb-3 mb-md-0">
                    <h1 class="profile-name">@Model.FullName</h1>
                    <p class="profile-phone mb-2">
                        <i class="fa-solid fa-phone"></i> @(Model.Phone ?? "N/A")
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <span class="ms-3"><i class="fa-solid fa-envelope"></i> @Model.Email</span>
                        }
                    </p>
                    @if (latestMembership != null)
                    {
                        if (isExpired)
                        {
                            <span class="status-badge status-expired">
                                <i class="fa-solid fa-circle-xmark"></i> Expired @Math.Abs(daysLeft) days ago
                            </span>
                        }
                        else if (isExpiringSoon)
                        {
                            <span class="status-badge status-expiring">
                                <i class="fa-solid fa-clock"></i> Expires in @daysLeft days
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-active">
                                <i class="fa-solid fa-circle-check"></i> Active - @daysLeft days left
                            </span>
                        }
                    }
                </div>
                <div class="d-flex gap-2 flex-wrap justify-content-center">
                    <a href="/Customers/EditAll/@Model.CustomerID" class="action-btn btn btn-light">
                        <i class="fa-solid fa-edit"></i> Edit
                    </a>
                    <a href="/Memberships/Renew/@Model.CustomerID" class="action-btn btn btn-success">
                        <i class="fa-solid fa-rotate"></i> Renew
                    </a>
                    <a href="/Attendance/CustomerQR/@Model.CustomerID" class="action-btn btn btn-primary">
                        <i class="fa-solid fa-qrcode"></i> QR Code
                    </a>
                    @if (assignedLocker != null)
                    {
                        <a href="/Locker/Details/@assignedLocker.LockerID" class="action-btn btn btn-info">
                            <i class="fa-solid fa-lock"></i> Locker #@assignedLocker.LockerNumber
                        </a>
                    }
                    else
                    {
                        <a href="/Locker/ChooseLocker?customerId=@Model.CustomerID" class="action-btn btn btn-warning">
                            <i class="fa-solid fa-lock-open"></i> Assign Locker
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Membership Highlight -->
@if (latestMembership != null)
{
    <div class="membership-highlight @(isExpired ? "expired" : isExpiringSoon ? "expiring" : "")">
        <div class="row">
            <div class="col-6 col-md-3">
                <div class="membership-stat">
                    <div class="value">@(latestMembership.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")</div>
                    <div class="label">Current Plan</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="membership-stat highlight">
                    <div class="value">Rs. @latestMembership.PaidPrice.ToString("N0")</div>
                    <div class="label">Paid Amount</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="membership-stat">
                    <div class="value">@FormatDate(latestMembership.ExpireDate)</div>
                    <div class="label">Expire Date</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="membership-stat @(isExpired ? "expired" : isExpiringSoon ? "expiring" : "highlight")">
                    <div class="value">
                        @if (isExpired)
                        {
                            @($"{Math.Abs(daysLeft)} days")
                        }
                        else
                        {
                            @($"{daysLeft} days")
                        }
                    </div>
                    <div class="label">@(isExpired ? "Overdue" : "Remaining")</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Locker Details Card (if assigned) -->
@if (assignedLocker != null)
{
    <div class="locker-highlight @(lockerIsExpired ? "expired" : lockerIsExpiringSoon ? "expiring" : "")">
        <div class="row align-items-center">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <div class="locker-number-display">
                    <i class="fa-solid fa-lock"></i>#@assignedLocker.LockerNumber
                </div>
                <span class="badge @(assignedLocker.Gender == "Gents" ? "bg-primary" : "bg-danger") fs-6">
                    <i class="fa-solid fa-@(assignedLocker.Gender == "Gents" ? "mars" : "venus") me-1"></i>@assignedLocker.Gender
                </span>
            </div>
            <div class="col-md-9">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="membership-stat">
                            <div class="value">@(assignedLocker.RentalMonths)M</div>
                            <div class="label">Duration</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat">
                            <div class="value">@(assignedLocker.EndDate?.ToString("dd MMM") ?? "-")</div>
                            <div class="label">Expiry</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat highlight">
                            <div class="value">Rs. @assignedLocker.PaidAmount.ToString("N0")</div>
                            <div class="label">Paid</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="membership-stat @(assignedLocker.DueAmount > 0 ? "expired" : "highlight")">
                            <div class="value">
                                @if (assignedLocker.DueAmount > 0)
                                {
                                    @($"Rs. {assignedLocker.DueAmount:N0}")
                                }
                                else
                                {
                                    <i class="fa-solid fa-check-circle"></i>
                                }
                            </div>
                            <div class="label">@(assignedLocker.DueAmount > 0 ? "Due" : "Paid")</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3 justify-content-center justify-content-md-start">
                    <a href="/Locker/Details/@assignedLocker.LockerID" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-eye me-1"></i> View Locker
                    </a>
                    <a href="/Locker/Renew/@assignedLocker.LockerID" class="btn btn-sm btn-outline-success">
                        <i class="fa-solid fa-rotate me-1"></i> Renew Locker
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Personal Details -->
    <div class="col-lg-6">
        <div class="info-card">
            <div class="info-card-header personal">
                <i class="fa-solid fa-user"></i>
                <h5>Personal Information</h5>
            </div>
            <div class="info-card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Gender</label>
                        <span>@(Model.Gender ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Date of Birth</label>
                        <span>@FormatDateLong(Model.DateOfBirth)</span>
                    </div>
                    <div class="info-item">
                        <label>Join Date</label>
                        <span>@FormatDateLong(Model.JoinDate)</span>
                    </div>
                    <div class="info-item">
                        <label>Blood Group</label>
                        <span>@(Model.BloodGroup ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Height</label>
                        <span>@(Model.Height ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Weight</label>
                        <span>@(Model.WeightKG.HasValue ? Model.WeightKG.Value.ToString() + " kg" : "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Occupation</label>
                        <span>@(Model.Occupation ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <label>Shift</label>
                        <span>
                            @if (!string.IsNullOrEmpty(Model.Shift))
                            {
                                <span class="badge @(Model.Shift == "Morning" ? "bg-warning text-dark" : "bg-info")">
                                    <i class="fa-solid @(Model.Shift == "Morning" ? "fa-sun" : "fa-moon") me-1"></i>
                                    @Model.Shift
                                </span>
                            }
                            else
                            {
                                @("-")
                            }
                        </span>
                    </div>
                    <div class="info-item">
                        <label>Address</label>
                        <span>@(Model.Address ?? "-")</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="mt-3 p-3 bg-light rounded">
                        <label class="d-block text-muted small mb-1">Remarks</label>
                        <span>@Model.Remarks</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Membership History -->
    <div class="col-lg-6">
        <div class="info-card">
            <div class="info-card-header history">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <h5>Membership History</h5>
            </div>
            <div class="info-card-body p-0">
                @if (Model.Memberships != null && Model.Memberships.Any())
                {
                    <div class="table-responsive">
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>Plan</th>
                                    <th>Amount</th>
                                    <th>Period</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var history in Model.Memberships.OrderByDescending(x => x.StartDate))
                                {
                                    var isCurrent = history.MembershipID == latestMembership?.MembershipID;
                                    <tr>
                                        <td>
                                            <span class="plan-badge">
                                                @(history.PlanName?.Split(':')[0].Replace("Package", "").Trim() ?? "-")
                                            </span>
                                            @if (isCurrent)
                                            {
                                                <span class="current-tag">Current</span>
                                            }
                                        </td>
                                        <td class="price">Rs. @history.PaidPrice.ToString("N0")</td>
                                        <td>
                                            <small class="text-muted">
                                                @FormatDate(history.StartDate) - @FormatDate(history.ExpireDate)
                                            </small>
                                        </td>
                                        <td>
                                            <span class="duration-badge">@history.Duration M</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No membership history found</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Back Button -->
<div class="mt-4">
    <a href="/Customers" class="btn btn-outline-secondary btn-lg px-4">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Members
    </a>
</div>
