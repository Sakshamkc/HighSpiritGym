@model HighSpiritApp.Models.Customer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateTime.Today;

    // Get the CURRENT membership - get latest by StartDate (no IsActive filter)
    var latestMembership = Model.Memberships?
        .OrderByDescending(x => x.StartDate)
        .FirstOrDefault();

    var isExpired = latestMembership != null && latestMembership.ExpireDate < today && !latestMembership.IsOnHold;
    var isExpiringSoon = latestMembership != null && !latestMembership.IsOnHold && latestMembership.ExpireDate >= today &&
latestMembership.ExpireDate <=
today.AddDays(7);
    var daysLeft = latestMembership != null ? (latestMembership.ExpireDate - today).Days : 0;
    var isOnHold = latestMembership != null && latestMembership.IsOnHold;
    var holdDays = isOnHold && latestMembership!.HoldStartDate.HasValue ? (today -
latestMembership.HoldStartDate.Value).Days : 0;

    // Locker info
    var assignedLocker = ViewBag.AssignedLocker as HighSpiritApp.Models.Locker.Locker;
    var lockerIsExpired = assignedLocker != null && assignedLocker.EndDate < today;
    var lockerIsExpiringSoon = assignedLocker != null && assignedLocker.EndDate >= today && assignedLocker.EndDate <=
today.AddDays(7);
    var lockerDaysLeft = assignedLocker != null && assignedLocker.EndDate.HasValue ? (assignedLocker.EndDate.Value -
today).Days : 0;

    var returnUrl = Context.Request.Query["returnUrl"].FirstOrDefault();
    var backUrl = !string.IsNullOrEmpty(returnUrl) ? Uri.UnescapeDataString(returnUrl) : "/Customers";
    var encodedReturnUrl = !string.IsNullOrEmpty(returnUrl) ? returnUrl : "";

    string FormatDate(DateTime date)
    {
        return date.ToString("dd MMM yyyy");
    }

    string FormatDateLong(DateTime? date)
    {
        if (!date.HasValue || date.Value.Year < 1900) return "-";
        var d = date.Value;
        string suffix = d.Day % 10 == 1 && d.Day != 11 ? "st" :
                       d.Day % 10 == 2 && d.Day != 12 ? "nd" :
                       d.Day % 10 == 3 && d.Day != 13 ? "rd" : "th";
        return $"{d.Day}{suffix} {d:MMMM yyyy}";
    }
}

<style>
