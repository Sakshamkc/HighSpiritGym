{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet watch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/HighSpiritApp/HighSpiritApp.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "dotnet build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/HighSpiritApp/HighSpiritApp.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
